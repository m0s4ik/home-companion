#
# The body asks for an update by writing a release tag to this file (update.rs).
[Unit]
Description=Home Companion update requests

[Path]
PathExists=/var/lib/home-companion/update/request
Unit=home-companion-update.service

[Install]
WantedBy=multi-user.target
