# The browser panel's pages (crates/panel), started by home-companion-panel.socket. It keeps no
# state and holds no secret: every request goes to the body over /run/home-companion/panel.sock
# (0660, group home-companion-panel). Its own user, no other group, no state directory, no access
# to /var/lib/home-companion* or /etc/home-companion.
[Unit]
Description=Home Companion browser panel
Requires=home-companion-panel.socket
After=home-companion-panel.socket

[Service]
Type=simple
User=home-companion-panel
Group=home-companion-panel
ExecStart=/opt/home-companion/home-companion-panel --socket /run/home-companion/panel.sock
MemoryMax=32M
TasksMax=16
Nice=5
CPUWeight=50
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=-/var/lib/home-companion -/var/lib/home-companion-brain -/var/lib/home-companion-web -/etc/home-companion
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0077
