// The companion's screen in landscape (1280x800), for any character (characters/README.md), in
// the "quiet desk" layout. Two zones: the character's stage on the left (x 0..512),
// never drawn over, and the desk on the right, where every screen is the same three bands: the
// top (the time, or a page header), the middle (context cards, a page's content, the
// conversation) and the action band at the bottom (three slots; the middle one is the gold
// primary). Home Assistant's own view ("Casa", casa.slint) is the only full-screen screen.
//
// The character gives the poses, its colours and its phrases; fonts, icons, words and the rest
// belong to the body. Fonts: Inter (OFL 1.1), subsets in ../fixtures/fonts ("Inter Tnum": the
// same with tabular digits). Icons: design/icons.slint (Material Design Icons, Apache-2.0).
// Everything shown comes from Rust (crates/home-companion/src/ui/); the defaults are the live preview's.

import "../fixtures/fonts/Inter-Light-subset.ttf";
import "../fixtures/fonts/Inter-Regular-subset.ttf";
import "../fixtures/fonts/Inter-Medium-subset.ttf";
import "../fixtures/fonts/Inter-Light-tnum-subset.ttf";
import "../fixtures/fonts/Inter-Regular-tnum-subset.ttf";
import { Theme, Grid } from "design/tokens.slint";
import { Icons } from "design/icons.slint";
import { ScrollFade, MusicBar, CornerClock,
    Icon, BareButton, PrimaryButton, PillButton, InfoCard, TimerCard, NowPlayingCard, PageHeader,
    Tile, SectionTitle, Row, Group, TimerLine, AlarmLine, ChatUser, ChatCharacter, ChatSeparator,
    Step, Stepper, Chip, Dialog, Separator, VolumeHud, GlyphButton, ControlTile, LevelBar, Feedback,
    DoneCard, Status
} from "design/components.slint";
import { CasaScreen, CasaBridge } from "casa.slint";
import { WeatherPage, ListsPage, PickPage, EventRow, ForecastRow, ChoiceRow, PickRow } from "ha-pages.slint";
export { ForecastRow, ChoiceRow } from "ha-pages.slint";
export { CasaBridge, CasaMenuRow } from "casa.slint";
export { Feedback, Status } from "design/components.slint";
export { Grid } from "design/tokens.slint";

// A card of the home's middle band, in priority order (Rust picks at most three):
// "status" (the body's own problem), "setup" (Home Assistant needs the user), "message", "reminder" (due, OK), "timer", "more" (more
// timers), "alarm", "upcoming" (next reminder), "shopping", "music",
// "answer" (the last long answer).
// One tile of the control center: `key` picks its icon ("wifi", "bluetooth", "airplay", "mic",
// "night", "ha"); the words come from the body (crates/home-companion/src/ui/control.rs).
export struct ControlRow {
    key: string,
    label: string,
    status: string,
    on: bool,
    enabled: bool,
    tappable: bool,
}

export struct CardRow {
    kind: string,
    title: string,
    text: string,
    left: string,
    remaining: float,
    paused: bool,
}

// A timer of the timers page.
export struct TimerRow {
    id: string,
    name: string,
    detail: string,
    left: string,
    remaining: float,
    paused: bool,
}

// An alarm: `days` as a sentence ("Lunedì – venerdì").
export struct AlarmRow {
    id: int,
    time: string,
    days: string,
    on: bool,
}

// A line of the conversations page: "sep" (a session: "Oggi · 14:02 · Home Assistant"),
// "user" or "character".
export struct ChatRow {
    kind: string,
    text: string,
}

// A fact Alfred remembers ("Ricordi"): its text and the day it was written ("5 nov"); dim =
// known but not in what the assistant reads at every conversation (over the budget: found only
// when asked).
export struct MemoryRow {
    id: int,
    text: string,
    date: string,
    dim: bool,
}

// A reminder still to come ("Ricordi"): "domani 18:00", what.
export struct JobRow {
    id: int,
    when: string,
    text: string,
}

// An open item of the shopping list (Home Assistant's `todo` entity).
export struct ShopRow {
    uid: string,
    text: string,
}

// A check of Settings → Home Assistant: level 0 ok, 1 warn, 2 bad, 3 skipped, 4 not checked;
// `repair` = a "Repair" on the row (it puts back a choice changed in Home Assistant).
// A day of the cloud services' use: its label (every few days), the bar's height (0..1), the
// amount.
export struct UsageBar {
    label: string,
    height: float,
    cost: string,
}

export struct HaRow {
    id: string,
    label: string,
    detail: string,
    level: int,
    repair: bool,
}

// A language of the first start's welcome page: its code and its name in itself.
export struct WelcomeRow {
    code: string,
    name: string,
}

// A Home Assistant found on the network (first start): the name it announces, its address.
export struct FindRow {
    name: string,
    url: string,
}

export struct LanguageRow {
    code: string,
    name: string,
    selected: bool,
}

