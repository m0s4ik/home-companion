// A group of "What to say" (Altro): its icon ("timer", "alarm", "calendar-clock", "cart",
// "view-dashboard", "music-note", "screen"), title and example sentences.
export struct WhatRow {
    icon: string,
    title: string,
    examples: string,
}

// A check of Settings → Home Assistant: a coloured dot, what, the detail; "Repair" when the row
// differs because of a choice made in Home Assistant.
component HaCheck inherits Rectangle {
    in property <HaRow> check;
    in property <string> repair-label;
    in property <bool> enabled: true;
    callback repair();
    height: max(76px, label.preferred-height + detail.preferred-height + 32px);
    border-radius: 16px;
    background: Theme.surface;
    Rectangle {
        x: 24px;
        y: 24px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.check.level == 0 ? Theme.ok : root.check.level == 1 ? Theme.warn
            : root.check.level == 2 ? Theme.danger : transparent;
        border-width: root.check.level >= 3 ? 2px : 0px;
        border-color: Theme.text-3;
    }
    label := Text {
        x: 60px;
        y: 12px;
        width: parent.width - self.x - (root.check.repair ? 176px : 24px);
        text: root.check.label;
        font-size: 24px;
        color: root.check.level >= 3 ? Theme.text-2 : Theme.text;
        wrap: word-wrap;
    }
    detail := Text {
        x: 60px;
        y: 12px + label.preferred-height + 4px;
        width: label.width;
        text: root.check.detail;
        font-size: 20px;
        color: Theme.text-3;
        wrap: word-wrap;
    }
    if root.check.repair: PillButton {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        width: 152px;
        label: root.repair-label;
        clicked => {
            if root.enabled {
                root.repair();
            }
        }
    }
}

// A line of the "Ricordi" page with a delete control: the first tap on the cross asks
// "Elimina?" in the row itself, the second deletes (no modal).
component DeletableRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    // Shown fainter (a fact the assistant finds only when asked).
    in property <bool> dim: false;
    in property <string> ask: "Delete?";
    callback delete();
    property <bool> asking: false;
    height: max(76px, title.preferred-height + (root.detail != "" ? 30px : 0px) + 28px);
    border-radius: 16px;
    background: Theme.surface;
    title := Text {
        x: 24px;
        y: 14px;
        width: parent.width - 24px - 152px;
        text: root.text;
        font-size: 24px;
        color: Theme.text;
        wrap: word-wrap;
    }
    if root.detail != "": Text {
        x: 24px;
        y: 14px + title.preferred-height + 4px;
        text: root.detail;
        font-size: 20px;
        color: root.dim ? Theme.text-3.with-alpha(0.5) : Theme.text-3;
    }
    if !root.asking: GlyphButton {
        x: parent.width - 8px - 64px;
        y: (parent.height - 64px) / 2;
        icon: Icons.close-36;
        clicked => {
            root.asking = true;
        }
    }
    if root.asking: PillButton {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        width: 136px;
        label: root.ask;
        clicked => {
            root.asking = false;
            root.delete();
        }
    }
}

// A fact heard once ("Ricordi" → To confirm): its text and day, Right / Wrong on the right.
component ConfirmRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <string> right: "Right";
    in property <string> wrong: "Wrong";
    callback confirm();
    callback reject();
    height: max(88px, title.preferred-height + (root.detail != "" ? 30px : 0px) + 28px);
    border-radius: 16px;
    background: Theme.surface;
    title := Text {
        x: 24px;
        y: 14px;
        width: right-button.x - 24px - 16px;
        text: root.text;
        font-size: 24px;
        color: Theme.text;
        wrap: word-wrap;
    }
    if root.detail != "": Text {
        x: 24px;
        y: 14px + title.preferred-height + 4px;
        text: root.detail;
        font-size: 20px;
        color: Theme.text-3;
    }
    wrong-button := PillButton {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        width: 136px;
        label: root.wrong;
        clicked => {
            root.reject();
        }
    }
    right-button := PillButton {
        x: wrong-button.x - 12px - self.width;
        y: wrong-button.y;
        width: 136px;
        primary: true;
        label: root.right;
        clicked => {
            root.confirm();
        }
    }
}

// An item of the shopping list: a tap ticks it (bought).
component ShopItem inherits Rectangle {
    in property <string> text;
    callback done();
    height: max(76px, label.preferred-height + 28px);
    border-radius: 16px;
    background: touch.pressed ? Theme.surface-2 : Theme.surface;
    Rectangle {
        x: 24px;
        y: (parent.height - 32px) / 2;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        border-width: 2px;
        border-color: Theme.text-2;
    }
    label := Text {
        x: 80px;
        y: (parent.height - self.preferred-height) / 2;
        width: parent.width - 104px;
        text: root.text;
        font-size: 26px;
        color: Theme.text;
        wrap: word-wrap;
    }
    touch := TouchArea {
        clicked => {
            root.done();
        }
    }
}

// A row of the setup page: an icon on the first line, the text wrapping under itself.
component SetupRow inherits HorizontalLayout {
    in property <image> icon;
    in property <string> text;
    in property <color> color;
    // Words for sentences; anywhere for an address (a DNS name is one long word).
    in property <TextWrap> wrap: word-wrap;
    spacing: 12px;
    VerticalLayout {
        alignment: start;
        padding-top: 4px;
        Icon {
            width: 28px;
            height: 28px;
            source: root.icon;
            color: root.color;
        }
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        font-size: 24px;
        color: root.color;
        wrap: root.wrap;
        min-height: 36px;
        vertical-alignment: center;
    }
}

// The way home over the mirrored screen: Home Assistant's view's home button (gold ring, deep
// fill, white house), a size smaller (72 px against 96).
component MirrorHomeButton inherits Rectangle {
    callback clicked;
    in property <bool> enabled-touch: true;
    width: 72px;
    height: 72px;
    border-radius: self.width / 2;
    background: home-touch.pressed ? Theme.accent-deep.brighter(0.5) : Theme.accent-deep;
    border-color: Theme.accent.with-alpha(0.9);
    border-width: 2px;
    Icon {
        x: 19px;
        y: 19px;
        width: 34px;
        height: 34px;
        source: Icons.home-44;
        color: Theme.text;
    }
    home-touch := TouchArea {
        enabled: root.enabled-touch;
        clicked => {
            Feedback.back();
            root.clicked();
        }
    }
}

export component CompanionWindow inherits Window {
    width: 1280px;
    height: 800px;
    title: root.character-name;
    default-font-family: "Inter";
    background: root.character-background;

    // "home", "listening", "thinking", "speaking", "error" or "ringing".
    in-out property <string> state: "home";
    // From the character: the pose of the current state, already cropped (drawn 740 px tall, so
    // every pose keeps the same scale; dimmed by Rust at night), colours, phrases.
    in property <image> pose;
    // The error pose (the notice when Home Assistant's view cannot open).
    in property <image> error-pose;
    // Do not disturb, on the home: a prop of the character at its feet (the character's
    // `poses/dnd.png`, if it has one; Alfred's is a hand bell asleep on a velvet cushion).
    in property <image> dnd-prop;
    // Music playing (AirPlay): a prop of the character beside it (the character's
    // `poses/music.png`; Alfred's is a brass gramophone on the floor), notes rising from it
    // while the sound plays. A prop, not a pose: every pose and animation stays as it is.
    in property <image> music-prop;
    // An animation frame of the character, drawn instead of the pose while it is set (Rust
    // places it where the animation's rect falls on the pose; only this box redraws).
    in property <image> frame;
    in property <length> frame-x;
    in property <length> frame-y;
    in property <length> frame-width;
    in property <length> frame-height;
    in property <string> character-name: "Alfred";
    in property <color> character-background: #03050d;
    in property <color> color-listening: #28c8e6;
    in property <color> color-thinking: #966ef0;
    in property <color> color-speaking: #f5aa3c;
    in property <color> color-error: #eb4646;
    in property <string> phrase-listening: "I'm listening…";
    in property <string> phrase-thinking: "Let me think…";
    // Home Assistant's answer is written before its voice is ready (a slow cloud voice can take
    // half a minute): shown at once, laid out as while speaking.
    property <bool> answer-early: root.state == "thinking" && root.answer != "";
    in property <string> phrase-error: "I didn't understand";
    // Shown in the home when there is nothing alive.
    in property <string> phrase-idle: "Say \"Okay Alfred\"";
    in property <string> phrase-starting: "Starting…";
    in property <Words> t: {
        ha-short: "HA", talk: "Talk", stop: "Stop", ok: "OK", more: "More",
        conversations: "Conversations", music: "Music", timers-alarms: "Timers and alarms",
        settings: "Settings", language: "Language", new-timer: "New timer", new-alarm: "New alarm",
        start: "Start", save: "Save", cancel: "Cancel", close: "Close", retry: "Retry",
        later: "Later", start-over: "Start over", clear: "Clear",
        clear-question: "Clear the conversations?",
        clear-text: "What you said to Alfred and his answers go away from this device.",
        chat-empty: "Nothing yet: say \"Okay Alfred\" and ask something.",
        timers-section: "TIMERS", alarms-section: "ALARMS",
        timers-empty: "No timers: say \"set a timer for 5 minutes\".", alarms-empty: "No alarms.",
        minutes: "min", undo: "Undo", plus-minute: "+1 minute", timer-finished: "Timer finished",
        touch-to-stop: "Touch anywhere to stop", section-device: "DEVICE", brains: "Brains",
        save-conversations: "Keep conversations", volume: "Volume", screen: "Screen",
        info: "About", suspend: "Suspend", suspend-row: "Suspend Alfred",
        suspend-hint: "wakes with Vol+ / Vol–", suspend-question: "Suspend Alfred?",
        suspend-text: "He won't listen or play until you press Vol+ or Vol–. A running timer wakes him by itself.",
        night-mode: "Night mode", night-from: "From", night-to: "To",
        night-hint: "At night only the clock shows, dim. A touch shows the home.",
        setup-title: "Let's link Home Assistant", setup-subtitle: "It takes a minute, from your phone.",
        setup-step1: "Scan the code with your phone: Home Assistant opens",
        setup-step2: "Log in if asked, then allow Alfred",
        setup-step3: "Done: Alfred links by itself, no token to copy",
        ha-unavailable: "Home Assistant's view\nis not available",
        ha-unavailable-text: "Home Assistant is not answering. I retry by myself; timers and alarms keep working.",
        error-hint: "Say it again? Just say \"Okay Alfred\"",
        alarm: "Alarm",
        memories: "Memories",
        memories-about: "WHAT I KNOW",
        memories-confirm: "TO CONFIRM",
        memories-right: "Right", memories-wrong: "Wrong",
        memories-empty: "Nothing yet: say \"Okay Alfred, remember that…\".",
        reminders-section: "REMINDERS", reminders: "Reminders",
        reminders-empty: "No reminders coming: say \"Okay Alfred, remind me…\".",
        delete-question: "Delete?", forget-all: "Forget all",
        forget-question: "Forget everything?",
        forget-text: "What Alfred knows about you, his notes and the past conversations go away for good.",
        shopping: "Shopping", shopping-empty: "The list is empty.",
    };
    // The character's languages, each named in itself (Settings → Language).
    in property <[LanguageRow]> languages: [
        { code: "en", name: "English", selected: true },
        { code: "it", name: "Italiano", selected: false },
    ];
    // The first start (no language chosen yet): one button per language, each named in itself,
    // and "Welcome" in each of them.
    in property <[WelcomeRow]> welcome-rows: [
        { code: "en", name: "English" },
        { code: "it", name: "Italiano" },
    ];
    in property <string> welcome-title: "Welcome · Benvenuto";
    // The first start without Home Assistant's address: "searching", "found", "none" (nothing,
    // or the search could not run: find-line says why) or "saving" (picked: restarting).
    in property <string> find-state: "searching";
    in property <[FindRow]> find-rows: [];
    in property <string> find-line: "";
    // The desk page: "home", "altro", "chat", "timers", "settings", "language", "screen",
    // "music", "setup" or "notice". A conversation and a ringing timer are drawn over any page
    // and leave it as it was.
    in-out property <string> page: "home";
    // Where Settings → Language goes back to: Settings, or the page that opened it (the link
    // page, the first start's Home Assistant page).
    in-out property <string> language-back: "settings";
    // Where "back" goes from Ricordi and Spesa: the page they were opened from.
    in-out property <string> page-back: "home";
    // A dialog over the desk: "", "suspend", "new-timer", "new-alarm", "clear", "forget".
    in-out property <string> dialog: "";
    // Kept for the body (Settings open = the settings page).
    in-out property <bool> settings-open: false;
    // Simulator only: the sample notifications are hidden (key N).
    in-out property <bool> notifications-hidden: false;
    // The mouth on screen (from the character's `mouth`, scaled like the pose).
    in property <length> mouth-x: 270px;
    in property <length> mouth-y: 138px;
    in property <length> mouth-width: 72px;
    in property <length> mouth-height: 43px;
    in property <string> clock: "14:25";
    in property <string> date: "tuesday 3 november";
    // The weather, only with real data from Home Assistant: its condition (Home Assistant's
    // name: "partlycloudy") and the temperature ("14°").
    in property <bool> weather-shown: true;
    in property <string> weather-kind: "partlycloudy";
    in property <string> weather-condition: "Partly cloudy";
    in property <string> temperature: "14°";
    // The middle band of the home: at most three, the most urgent first.
    in property <[CardRow]> cards: [{ kind: "timer", title: "Pasta", left: "07:42", remaining: 0.77 }];
    // Home Assistant is not connected (the HA action is dimmed; a status card says so).
    in property <bool> offline: false;
    // Start-up: the character's loading animation, its name, "Starting…"; no clock.
    in property <bool> starting: false;
    // Nothing moves by itself (the golden screenshots): the start-up line, the ringing ring, the music notes.
    in property <bool> still: false;
    // Night mode: the clock alone, dim; its one line (the next alarm, a running timer).
    in property <bool> night: false;
    in property <string> night-line: "";
    in property <bool> night-alarm: false;
    // A conversation.
    in property <string> heard: "";
    in property <string> answer: "Done: the living room blind is up. It is 14 degrees outside and cloudy.";
    // Bar heights 0..1, left to right (72 bars).
    in property <[float]> wave: [0.05, 0.1, 0.2, 0.35, 0.5, 0.35, 0.2, 0.1, 0.05];
    // A finished timer: its name, how long ago ("Ready for 0:12").
    in property <string> ringing-name: "Pasta";
    in property <string> ringing-since: "";
    // An alarm rings, not a timer.
    in property <bool> ringing-alarm: false;
    // A reminder that is due, full screen (the card stays on the home until its OK).
    in property <bool> notice-shown: false;
    // An announcement plays (a reminder said by Home Assistant): over a due reminder, the
    // reminder's screen stays and the voice plays over it.
    in property <bool> announcing: false;
    in property <string> notice-title: "Promemoria";
    in property <string> notice-text: "";
    in property <string> notice-when: "";
    in property <string> notice-later: "Fra 10 min";
    // Conversations, timers and alarms (their pages).
    in property <[ChatRow]> chat: [];
    in property <[TimerRow]> timer-rows: [];
    in property <[AlarmRow]> alarm-rows: [];
    // The days of the week, Monday first, one letter or two ("L", "M"…).
    in property <[string]> day-letters: ["M", "T", "W", "T", "F", "S", "S"];
    // A timer or alarm just removed: the chip with "Undo" for 5 s ("" = none).
    in property <string> undo-text: "";
    // Altro: what is going on in each place.
    in property <string> tile-chat: "";
    in property <string> tile-timers: "";
    in property <string> tile-settings: "";
    // What the cloud services cost, roughly: the Home Assistant page's row ("Consumo IA",
    // "oggi ~0.08 $ · mese ~1.4 $"; "" until there is something to count) and its page.
    in property <string> usage-label: "";
    in property <string> usage-line: "";
    in property <string> usage-today-label: "";
    in property <string> usage-today: "";
    in property <string> usage-month: "";
    in property <string> usage-detail: "";
    in property <string> usage-chart-label: "";
    in property <string> usage-max: "";
    in property <string> usage-note: "";
    in property <bool> usage-precise: false;
    in property <[UsageBar]> usage-bars: [];
    // Music (AirPlay later): nothing plays yet, so its tile, card and page stay hidden.
    in property <bool> music-playing: false;
    // The music page's spectrum: band levels and their falling peaks, 0..1, low bands first.
    in property <[float]> music-bands: [];
    // The spectrum on the music page (off: the picture larger instead).
    in property <bool> music-spectrum-shown: false;
    // Layouts of the music page: 0 the picture and the title centred under it, 1 the picture
    // large, 2 (the one in use; it had a blurred copy of the picture behind, dropped 13/11:
    // muddy and cut against the stage), 3 the title in the bar.
    in property <int> music-layout: 2;
    in property <[float]> music-peaks: [];
    in property <string> music-title: "";
    in property <string> music-artist: "";
    in property <string> music-album: "";
    in property <string> music-source: "";
    // The cover (a sample drawing until something really plays).
    in property <image> music-cover: @image-url("design/cover-sample.png");

    // ---- Screen mirroring (AirPlay from a phone or a tablet; crates/home-companion/src/ui/mirror.rs): a
    // session is on, the sender's name, its video (set by the transport on the UI thread) and
    // that video's size in pixels (the sender's aspect ratio, at most 1280x800; it changes when
    // the sender rotates). The page is `page == "mirror"`.
    in property <bool> mirror-active: false;
    in property <string> mirror-source;
    in property <image> mirror-frame;
    in property <length> mirror-frame-width: 368px;
    in property <length> mirror-frame-height: 800px;
    // The controls over a video that fills the screen are shown (Rust hides them 4 s after the
    // last touch: mirror-poked).
    in-out property <bool> mirror-chrome: false;
    // The demos: the opening frozen at this point (0..1), animated below 0.
    in property <float> mirror-freeze: -1;
    // The character's face (the conversation bar over the mirrored video).
    in property <image> face;
    // Memories (home-companion-brain): present = its control socket answers (the tile, the row).
    in property <bool> brain-present: false;
    in property <string> memories-status: "";
    // The line on what reaches the assistant, the note on the facts over the budget ("" = none).
    in property <string> memories-sent: "";
    in property <string> memories-more: "";
    // What Alfred knows, in the order the assistant reads it; what was heard once, to confirm.
    in property <[MemoryRow]> memory-rows: [];
    in property <[MemoryRow]> confirm-rows: [];
    in property <[JobRow]> job-rows: [];
    // The shopping list (`[lists] shopping`): on = configured; its open items.
    in property <bool> shopping-on: false;
    in property <[ShopRow]> shop-rows: [];
    in property <string> tile-shopping: "";
    // v0.2 ha: the weather page (its icon's path data, today's range, the forecast), the page
    // choosing lists and calendars, and the calendar events on the reminders page.
    in property <string> weather-icon: "";
    in property <string> weather-high: "";
    in property <string> weather-low: "";
    in property <[ForecastRow]> forecast-rows: [];
    in property <[ChoiceRow]> choice-todo: [];
    in property <[ChoiceRow]> choice-calendars: [];
    in property <[JobRow]> event-rows: [];
    callback choice-toggled(string);
    // Settings → Home Assistant: the checks, a status line, working, set up once.
    in property <[HaRow]> ha-rows: [];
    in property <string> ha-line: "";
    in property <bool> ha-busy: false;
    // What the setup does right now (the pop-up while busy).
    in property <string> ha-step: "";
    in property <bool> ha-popup: false;
    // The run asked on the screen ended well: "All set" and an OK to close it.
    in property <bool> ha-done: false;
    in property <bool> ha-configured: false;
    in property <bool> ha-linked: false;
    // The choices of the Home Assistant page (the AI, speech-to-text, voice) and the open one.
    in property <[PickRow]> ha-picks: [];
    in property <string> ha-pick-title: "";
    in property <string> ha-pick-hint: "";
    in property <[ChoiceRow]> ha-pick-rows: [];
    in property <string> tile-memories: "";
    in property <string> tile-reminders: "";
    // Settings.
    in property <string> language-name: "English";
    in property <string> brains: "Home Assistant";
    in property <string> ha-status: "";
    in property <string> version: "";
    in property <string> screen-status: "";
    in property <bool> save-chat: true;
    in property <bool> night-on: true;
    // Settings → Screen → "Home compatta" (the clock higher, four cards; Grid.compact).
    in property <bool> home-compact: false;
    // Settings → how readily the character answers to his wake word: -1 less, 0 normal, 1 more.
    in property <int> wake-step: 0;
    in property <int> night-start: 23;
    in property <int> night-end: 7;
    // Setup: what the body sees (Wi-Fi, where Home Assistant is).
    in property <string> setup-wifi: "";
    in property <string> setup-ha: "";
    // The link's QR code (crates/home-companion/src/ha/link.rs), drawn by the body; until it is there (or
    // without Home Assistant's address) the sample picture.
    in property <image> setup-qr: @image-url("design/qr-setup.png");
    // A line under the steps: linked (gold) or what went wrong (danger); "" = none.
    in property <string> setup-status: "";
    in property <bool> setup-linked: false;
    // ---- v0.2: what the brain's house commands show (crates/home-companion/src/ui/house.rs).
    // A command went through: its line ("Kitchen light: off") and Undo, for 8 s.
    in property <bool> done-shown: false;
    in property <string> done-line: "";
    in property <bool> done-undo: false;
    // The big Undo pop-up first (5 s), its time left (1..0); OK closes it, the card stays.
    in property <bool> done-popup: false;
    in property <float> done-left: 1;
    in property <string> done-name: "";
    in property <string> done-state: "";
    callback done-undo-clicked();
    callback done-ok-clicked();
    // A command waits for a yes: the question, the time left (1 = just asked, 0 = over).
    in property <bool> ask-shown: false;
    in property <string> ask-text: "";
    // The devices' names under the question (several), or "".
    in property <string> ask-names: "";
    // A yes came (spoken or touched): the same window says "Doing it…" under the devices'
    // names, Cancel only (gone once touched: `ask-cancelled`), until its done goes on in it.
    in property <bool> ask-working: false;
    in property <string> ask-working-title: "";
    in property <bool> ask-cancelled: false;
    in property <float> ask-left: 1;
    callback ask-answered(bool);
    callback ask-cancel();
    // The done pop-up goes on from the question's window (its size and place, no new window).
    in property <bool> done-from-ask: false;
    // Do not disturb: on, and its line ("Do not disturb · until 07:00").
    in property <bool> dnd: false;
    in property <string> dnd-line: "";
    // The microphone off (the switch on the device or the control center): its line over the
    // clock, next to do not disturb's ("Microfono spento").
    in property <bool> mic-off: false;
    in property <string> mic-off-line: "";
    // The microphone's switch was moved: a big card for a moment (Rust hides it), on or off.
    in property <bool> mic-hud-shown: false;
    in property <bool> mic-hud-on: true;
    in property <string> mic-hud-text: "";
    // "What to say" (Altro): the groups.
    in property <[WhatRow]> what-rows: [];
    // The volume (percent) and whether its HUD is on screen (Rust hides it after 2 s).
    in property <int> volume: 40;
    in property <bool> volume-shown: false;

    callback screenshot-requested();
    // The state changed (keys, buttons or Rust): Rust sets the matching pose.
    callback state-changed(string);
    // The page changed (Rust returns home after a minute alone, and fills the page).
    callback page-changed(string);
    callback talk-clicked();
    // A tap on the character (wakes the screen; on the device any touch does).
    callback character-touched();
    callback home-assistant-clicked();
    callback stop-clicked();
    // "Falso allarme": stopped, and the wake word's audio kept as a mistake (to train it).
    callback false-wake-clicked();
    // ---- The control center (pulled down from the top of the desk).
    in-out property <bool> control-open: false;
    in property <[ControlRow]> control-tiles: [];
    in property <int> brightness: 50;
    in property <bool> brightness-auto: true;
    in property <string> brightness-label: "Auto";
    callback control-tile(string);
    // Opened by the pull from the top (the body fills the tiles then).
    callback control-opened();
    in property <bool> music-paused: false;
    callback control-volume(int);
    callback control-brightness(int);
    callback control-brightness-auto();
    callback music-toggle();
    // A touch on the mirroring page: its controls come up (or stay) for a while.
    callback mirror-poked();
    callback music-next();
    callback mirror-stop();
    callback ready-dismissed();
    callback music-previous();
    callback message-ok(int);
    callback language-chosen(string);
    callback suspend-confirmed();
    // Timers and alarms by touch.
    callback timer-start(int);
    callback timer-pause(string);
    callback timer-cancel(string);
    callback undo-clicked();
    callback alarm-save(int, int, int);
    callback alarm-toggled(int, bool);
    callback alarm-delete(int);
    // A ringing timer: one more minute.
    callback snooze();
    // The due reminder: OK (done), later (again in ten minutes).
    callback notice-ok();
    callback notice-snooze();
    // Conversations: forget the context; delete the history.
    callback chat-new();
    callback chat-clear();
    callback save-chat-toggled(bool);
    callback night-changed(bool, int, int);
    callback home-compact-changed(bool);
    callback wake-step-changed(int);
    callback setup-later();
    // The first start: search Home Assistant again; one picked (its address).
    callback find-search();
    callback find-pick(string);
    // Settings → Home Assistant: "Set up" / "Check and repair", a row's "Repair", "Unlink".
    callback ha-check();
    callback ha-repair(string);
    callback ha-unlink();
    callback ha-ok();
    // The failure's pop-up closed.
    callback ha-dismiss();
    // A choice of the Home Assistant page opened (its kind), one picked (its id).
    callback ha-pick(string);
    callback ha-picked(string);
    // Memories: delete one fact ("Wrong" too), confirm one ("Right"), forget everything
    // (confirmed), cancel a reminder.
    callback memory-delete(int);
    callback memory-confirm(int);
    callback memories-forget();
    callback job-cancel(int);
    // The shopping list: an item bought (ticked).
    callback shop-done(string);
    // Keys + and - in the simulator: the volume keys (+1 up, -1 down).
    callback volume-key(int);
    // Key N in the simulator: hide or show the sample notifications.
    callback notifications-toggled();

    property <color> state-color: root.state == "listening" ? root.color-listening
        : root.state == "thinking" ? root.color-thinking
        : root.state == "speaking" ? root.color-speaking
        // Only an error is red: back at rest (the bar still sliding away) it keeps the answer's colour.
        : root.state == "error" ? root.color-error : root.color-speaking;
    // A conversation owns the desk, over any page.
    property <bool> conversation: (root.state == "listening" || root.state == "thinking"
        || root.state == "speaking" || root.state == "error")
        && !(root.announcing && root.notice-shown && root.state == "speaking");
    property <bool> ringing: root.state == "ringing";
    // What the desk shows when nothing takes it over.
    property <bool> noticing: root.notice-shown && !root.conversation && !root.ringing && !root.starting;
    property <bool> desk: !root.conversation && !root.ringing && !root.starting && !root.noticing;
    property <bool> night-home: root.night && root.desk && root.desk-page == "home";

    // The mirrored screen is on: only a ringing timer, a due reminder or the start-up take its
    // place (a conversation is drawn over it, small).
    property <bool> mirroring: root.mirror-active && root.page == "mirror" && !root.ringing
        && !root.noticing && !root.starting;
    // How far the page has come in (0 = away below the screen, 1 = in place): up from the bottom
    // edge in 400 ms with Home Assistant's view curve, the home stepping back under it; down
    // the same way when it closes or the user goes home.
    property <float> mirror-in: root.mirroring ? 1 : 0;
    animate mirror-in {
        duration: 400ms;
        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
    }
    property <float> mirror-t: root.mirror-freeze >= 0 ? root.mirror-freeze : root.mirror-in;
    // The video centred, as large as it fits without distortion (whole pixels).
    property <float> mirror-scale: min(root.width / max(1px, root.mirror-frame-width),
        root.height / max(1px, root.mirror-frame-height));
    property <length> mirror-w: round(root.mirror-frame-width * root.mirror-scale / 1px) * 1px;
    property <length> mirror-h: round(root.mirror-frame-height * root.mirror-scale / 1px) * 1px;
    // Each black band at the sides. A portrait sender leaves wide ones (an upright phone 456 px,
    // a tablet 340 px): the character and the controls stay there. A landscape one fills the
    // screen: the controls come up on a tap, the conversation as Home Assistant's bar.
    property <length> mirror-band: (root.width - root.mirror-w) / 2;
    property <bool> mirror-sides: root.mirror-band >= 300px;
    // How much of Alfred's own screen is covered (it steps back under Casa or the mirror).
    property <float> covered: max(root.casa-cover, root.mirror-t);
    changed state => {
        root.dialog = "";
        root.state-changed(root.state);
    }
    changed page => {
        if (root.page != "mirror") {
            root.page-under = root.page;
        }
        root.page-changed(root.page);
    }
    // The desk page drawn under the mirrored screen is the one it opened over: the home steps
    // back as it was while the mirror comes in (and comes forward as it is), not an empty desk.
    property <string> page-under: "home";
    property <string> desk-page: root.page == "mirror" ? root.page-under : root.page;
    changed settings-open => {
        if (root.settings-open) {
            root.page = "settings";
        } else if (root.page == "settings") {
            root.page = "home";
        }
    }

    // The stage's geometry (Rust reads it to place the mouth).
    out property <length> character-cx: Grid.stage-width / 2;
    // Where the pop-ups over everything are centred: on the desk column while the character is on
    // the stage (they never cover it), on the screen over a full view (Home Assistant, mirroring).
    property <length> dialog-cx: CasaBridge.visible || root.mirror-t > 0.001 ? root.width / 2 : Grid.col-cx;
    out property <length> character-top: 30px;
    out property <length> character-height: 740px;
    // The action band's slots (x of each 160 px wide slot).
    property <length> slot-left: Grid.col-cx - Grid.slot-dx - Grid.slot-width / 2;
    property <length> slot-mid: Grid.col-cx - Grid.slot-width / 2;
    property <length> slot-right: Grid.col-cx + Grid.slot-dx - Grid.slot-width / 2;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == "s" || event.text == "S") {
                root.screenshot-requested();
                return accept;
            }
            if (event.text == "1") { root.state = "home"; return accept; }
            if (event.text == "2") { root.state = "listening"; return accept; }
            if (event.text == "3") { root.state = "thinking"; return accept; }
            if (event.text == "4") { root.state = "speaking"; return accept; }
            if (event.text == "5") { root.state = "error"; return accept; }
            if (event.text == "n" || event.text == "N") { root.notifications-toggled(); return accept; }
            if (event.text == "+" || event.text == "=") { root.volume-key(1); return accept; }
            if (event.text == "-") { root.volume-key(-1); return accept; }
            reject
        }
    }
    init => {
        keys.focus();
    }

    // How much of the screen Home Assistant's view covers (0 = not shown, 1 = in place): the
    // same way in and out as casa.slint, animated with the same duration and curve.
    property <length> casa-len: CasaBridge.edge == "left" || CasaBridge.edge == "right" ? root.width : root.height;
    property <length> casa-away: CasaBridge.slide;
    animate casa-away {
        duration: CasaBridge.slide-animated ? 400ms : 0ms;
        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
    }
    property <float> casa-cover: CasaBridge.visible ? clamp(1 - max(CasaBridge.pull, root.casa-away) / root.casa-len, 0, 1) : 0;

    // ---- Everything of Alfred's own screen, in one layer: while the view comes in it steps back
    // (scaled to 94 % around the centre, under a dark veil), and comes forward as it leaves or
    // follows the finger of the swipe. Not drawn at all while the view covers it.
    home-layer := Rectangle {
        width: root.width;
        height: root.height;
        visible: root.covered < 0.999;
        transform-scale: 1 - 0.06 * root.covered;

    // ---- The stage: the character, 740 px tall, centred in x 0..512. Nothing else is drawn here.
    Image {
        x: root.character-cx - self.width / 2;
        y: root.character-top;
        height: root.character-height;
        width: root.pose.height > 0 ? self.height * root.pose.width / root.pose.height : 0px;
        source: root.pose;
        image-fit: fill;
        visible: root.frame.width == 0;
    }
    Image {
        x: root.frame-x;
        y: root.frame-y;
        width: root.frame-width;
        height: root.frame-height;
        source: root.frame;
        image-fit: fill;
        visible: root.frame.width > 0;
    }
    // On the floor at the character's right foot, at the night's light by night; it fades in
    // and out with do not disturb.
    Image {
        // Not under the control center, which starts a little left of the desk column.
        // While the character is on the stage, whatever it does (a conversation, an animation,
        // a page): the prop is the state's sign, not a decoration of the home.
        property <bool> shown: root.dnd && root.dnd-prop.width > 0 && !root.starting
            && !root.control-open;
        width: 130px;
        height: root.dnd-prop.width > 0 ? self.width * root.dnd-prop.height / root.dnd-prop.width : 0px;
        // Inside the stage (it ends at Grid.stage-width), next to the right shoe.
        x: min(root.character-cx + 140px - self.width / 2, Grid.stage-width - self.width - 8px);
        // The night's figure stands a little higher (its feet at ~715 px, the day's at ~735).
        y: root.character-top + root.character-height - (root.night-home ? 38px : 18px) - self.height;
        source: root.dnd-prop;
        image-fit: fill;
        visible: self.opacity > 0.01;
        opacity: self.shown ? (root.night-home ? 0.55 : 1.0) : 0.0;
        animate opacity { duration: 400ms; easing: ease-in-out; }
    }
    // The gramophone at the character's left, standing on the stage's floor; notes rise from its
    // horn while the music plays (none in a pause or by night).
    music-prop-img := Image {
        property <bool> shown: root.music-playing && !root.night-home && root.music-prop.width > 0
            && !root.starting && !root.control-open;
        // About knee high next to the character, on the floor by its left shoe.
        height: 170px;
        width: root.music-prop.height > 0 ? self.height * root.music-prop.width / root.music-prop.height : 0px;
        x: max(8px, root.character-cx - 74px - self.width);
        y: root.character-top + root.character-height - 18px - self.height;
        source: root.music-prop;
        image-fit: fill;
        visible: self.opacity > 0.01;
        opacity: self.shown ? 1.0 : 0.0;
        animate opacity { duration: 400ms; easing: ease-in-out; }
    }
    for n in 3: Image {
        property <bool> on: music-prop-img.shown && !root.music-paused;
        // Each note on its own 3.6 s rise, a third apart; they drift right and fade.
        // The clock is read only while the notes rise: animation-tick() keeps the whole window
        // redrawing at the panel's rate (about a third of a core on the ThinkSmart View).
        property <float> t: !self.on ? 0 : root.still ? 0.3 + n * 0.25 : mod(animation-tick() / 1ms + n * 1200, 3600) / 3600;
        // From the horn's mouth (its top left), up and a little out.
        x: music-prop-img.x + 6px - self.t * 18px + (n == 1 ? 16px : 0px);
        y: music-prop-img.y - 6px - self.t * 110px;
        width: 26px;
        height: 26px;
        source: Icons.music-note-32;
        colorize: Theme.accent;
        visible: self.on;
        opacity: self.on ? (self.t < 0.2 ? self.t / 0.2 : 1 - (self.t - 0.2) / 0.8) * 0.8 : 0;
    }
    TouchArea {
        width: Grid.stage-width;
        height: root.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.character-touched();
            }
        }
    }
    // A double tap on the mouth opens the settings.
    if root.desk && root.desk-page == "home" && !root.night: TouchArea {
        x: root.mouth-x;
        y: root.mouth-y;
        width: root.mouth-width;
        height: root.mouth-height;
        double-clicked => {
            root.page = "settings";
        }
    }

    // ---- Start-up: the character's loading animation, its name, "Starting…". No clock (the time
    // may not be set yet).
    if root.starting && !root.conversation && !root.ringing: Rectangle {
        Text {
            x: Grid.col-x;
            y: 300px;
            width: Grid.col-width;
            text: root.character-name;
            font-size: 96px;
            font-weight: 300;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            x: Grid.col-x;
            y: 432px;
            width: Grid.col-width;
            text: root.phrase-starting;
            font-size: 28px;
            color: Theme.text-2;
            horizontal-alignment: center;
        }
        // An indeterminate line: a short gold segment sliding along a hairline (start-up only).
        Rectangle {
            x: Grid.col-cx - 120px;
            y: 496px;
            width: 240px;
            height: 4px;
            border-radius: 2px;
            background: Theme.line;
            clip: true;
            Rectangle {
                x: root.still ? 80px : (mod(animation-tick() / 1ms, 1400) / 1400) * (parent.width + self.width) - self.width;
                width: 80px;
                height: 4px;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
    }

    // ---- Night: the clock alone, dim, where it is by day; its one line under it. No gold, no
    // cards, no actions: a touch shows the home for a few seconds.
    if root.night-home: Rectangle {
        Text {
            x: Grid.col-x;
            y: 48px;
            width: Grid.col-width;
            text: root.clock;
            font-family: "Inter Tnum";
            font-size: 160px;
            font-weight: 300;
            letter-spacing: -2px;
            color: Theme.night;
            horizontal-alignment: center;
        }
        if root.night-line != "": HorizontalLayout {
            x: Grid.col-cx - self.width / 2;
            y: 244px;
            width: self.preferred-width;
            height: 44px;
            spacing: 12px;
            Rectangle {
                width: 28px;
                Icon {
                    y: 8px;
                    width: 28px;
                    height: 28px;
                    source: root.night-alarm ? Icons.alarm-28 : Icons.timer-24;
                    color: Theme.night;
                }
            }
            Text {
                text: root.night-line;
                font-family: "Inter Tnum";
                font-size: 34px;
                color: Theme.night;
                vertical-alignment: center;
            }
        }
    }

    // ---- Home: the time, the context cards, the actions.
    if root.desk && root.desk-page == "home" && !root.night: Rectangle {
        // On the compact home high on the screen, so the band below holds four cards.
        Text {
            x: Grid.col-x;
            y: Grid.compact ? -14px : 48px;
            width: Grid.col-width;
            text: root.clock;
            font-family: "Inter Tnum";
            font-size: 160px;
            font-weight: 300;
            letter-spacing: -2px;
            color: Theme.text;
            horizontal-alignment: center;
        }
        // One line: the date, then (only with real data) a gold dot, the sky and the temperature.
        HorizontalLayout {
            x: Grid.col-cx - self.width / 2;
            y: Grid.compact ? 172px : 240px;
            width: min(self.preferred-width, Grid.col-width);
            height: 44px;
            spacing: 14px;
            Text {
                text: root.date;
                font-size: 34px;
                color: Theme.text-2;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.weather-shown: Rectangle {
                width: 6px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.accent;
                }
            }
            if root.weather-shown: Rectangle {
                width: 32px;
                accessible-role: text;
                accessible-label: root.weather-condition;
                Icon {
                    y: 6px;
                    width: 32px;
                    height: 32px;
                    color: Theme.text;
                    source: root.weather-kind == "sunny" ? Icons.weather-sunny-32
                        : root.weather-kind == "clear-night" ? Icons.weather-night-32
                        : root.weather-kind == "partlycloudy" ? Icons.weather-partly-cloudy-32
                        : root.weather-kind == "cloudy" ? Icons.weather-cloudy-32
                        : root.weather-kind == "rainy" ? Icons.weather-rainy-32
                        : root.weather-kind == "pouring" ? Icons.weather-pouring-32
                        : root.weather-kind == "snowy" ? Icons.weather-snowy-32
                        : root.weather-kind == "snowy-rainy" ? Icons.weather-snowy-rainy-32
                        : root.weather-kind == "fog" ? Icons.weather-fog-32
                        : root.weather-kind == "hail" ? Icons.weather-hail-32
                        : root.weather-kind == "lightning" ? Icons.weather-lightning-32
                        : root.weather-kind == "lightning-rainy" ? Icons.weather-lightning-rainy-32
                        : root.weather-kind == "windy" ? Icons.weather-windy-32
                        : root.weather-kind == "windy-variant" ? Icons.weather-windy-variant-32
                        : Icons.alert-circle-32;
                }
            }
            if root.weather-shown: Text {
                text: root.temperature;
                font-size: 34px;
                color: Theme.text;
                vertical-alignment: center;
            }
            // On the compact home, do not disturb and the microphone off: their signs at the end
            // of the line (there is no room for their lines over the clock).
            if Grid.compact && (root.dnd || root.mic-off): Rectangle {
                width: 6px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.accent;
                }
            }
            if Grid.compact && root.dnd: Rectangle {
                width: 32px;
                Icon {
                    y: 6px;
                    width: 32px;
                    height: 32px;
                    source: Icons.bell-off-32;
                    color: Theme.text-2;
                }
            }
            if Grid.compact && root.mic-off: Rectangle {
                width: 32px;
                Icon {
                    y: 6px;
                    width: 32px;
                    height: 32px;
                    source: Icons.microphone-off-32;
                    color: Theme.danger;
                }
            }
        }

        // A tap on the weather opens its page.
        if root.weather-shown: TouchArea {
            x: Grid.col-x;
            y: Grid.compact ? 164px : 232px;
            width: Grid.col-width;
            height: 60px;
            clicked => {
                Feedback.tap();
                root.page = "weather";
            }
        }

        // Nothing alive: the invitation, quiet, in the middle of the band.
        if root.cards.length == 0 || root.notifications-hidden: Text {
            x: Grid.col-x;
            y: Grid.cards-y;
            width: Grid.col-width;
            height: Grid.cards-height;
            text: root.phrase-idle;
            font-size: 24px;
            color: Theme.text-3;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // The context band: at most three cards (four on the compact home), the most urgent first.
        if !root.notifications-hidden: VerticalLayout {
            x: Grid.col-x;
            y: Grid.cards-y;
            width: Grid.col-width;
            height: Grid.cards-height;
            spacing: Grid.card-gap;
            alignment: start;
            for c[i] in root.cards: Rectangle {
                height: Grid.card-height;
                if c.kind == "timer": TimerCard {
                    name: c.title;
                    detail: c.text;
                    left: c.left;
                    remaining: c.remaining;
                    paused: c.paused;
                    tapped => {
                        root.page = "timers";
                    }
                }
                if c.kind == "music": NowPlayingCard {
                    cover: root.music-cover;
                    title: c.title;
                    detail: c.text;
                    playing: !c.paused;
                    tapped => {
                        root.page = "music";
                    }
                    play-pause => {
                        root.music-toggle();
                    }
                    next => {
                        root.music-next();
                    }
                }
                if c.kind != "timer" && c.kind != "music": InfoCard {
                    icon: c.kind == "done" || c.kind == "done-undo" ? Icons.check-circle-32
                        : c.kind == "status" ? Icons.cloud-off-32
                        : c.kind == "setup" ? Icons.view-dashboard-32
                        : c.kind == "message" ? Icons.bell-32
                        : c.kind == "reminder" ? Icons.calendar-clock-32
                        : c.kind == "more" ? Icons.timer-32
                        : c.kind == "shopping" ? Icons.cart-32
                        : c.kind == "upcoming" ? Icons.calendar-clock-32
                        : c.kind == "alarm" ? Icons.alarm-32
                        : c.kind == "mirror" ? Icons.cast-connected-32
                        : c.kind == "ready" ? Icons.check-circle-32
                        : c.kind == "hc-alert" ? Icons.alert-circle-32
                        : c.kind == "hc-check" ? Icons.check-circle-32
                        : c.kind == "hc-cart" ? Icons.cart-32
                        : c.kind == "hc-calendar" ? Icons.calendar-clock-32
                        : c.kind == "hc-alarm" ? Icons.alarm-32
                        : c.kind == "hc-timer" ? Icons.timer-32
                        : c.kind == "hc-music" ? Icons.music-note-32
                        : c.kind == "hc-rain" ? Icons.weather-rainy-32
                        : c.kind == "hc-sun" ? Icons.weather-sunny-32
                        : Icons.forum-32;
                    icon-color: c.kind == "status" || c.kind == "hc-alert" ? Theme.danger
                        : c.kind == "more" || c.kind == "answer" ? Theme.text-2 : Theme.accent;
                    title: c.title;
                    text: c.text;
                    action: c.kind == "done-undo" ? root.t.undo
                        : c.kind == "message" || c.kind == "reminder" || c.kind.starts-with("hc-") ? root.t.ok : "";
                    closable: c.kind == "mirror" || c.kind == "ready";
                    action-clicked => {
                        if (c.kind == "done-undo") {
                            root.done-undo-clicked();
                        } else {
                            root.message-ok(i);
                        }
                    }
                    close-clicked => {
                        if (c.kind == "ready") {
                            root.ready-dismissed();
                        } else {
                            root.mirror-stop();
                        }
                    }
                    tapped => {
                        if (c.kind == "more") {
                            root.page = "timers";
                        } else if (c.kind == "setup") {
                            root.page-back = "home";
                            root.page = "ha";
                        } else if (c.kind == "answer") {
                            root.page = "chat";
                        } else if (c.kind == "shopping") {
                            root.page-back = "home";
                            root.page = "shopping";
                        } else if (c.kind == "alarm") {
                            root.page = "timers";
                        } else if (c.kind == "mirror") {
                            root.page = "mirror";
                        } else if (c.kind == "ready") {
                            root.ready-dismissed();
                            root.home-assistant-clicked();
                        } else if (c.kind == "upcoming" || c.kind == "reminder") {
                            root.page-back = "home";
                            root.page = "reminders";
                        }
                    }
                }
            }
        }

        BareButton {
            x: root.slot-left;
            y: Grid.band-y;
            icon: Icons.view-dashboard-48;
            label: root.t.ha-short;
            enabled: !root.offline;
            clicked => {
                root.home-assistant-clicked();
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
        BareButton {
            x: root.slot-right;
            y: Grid.band-y;
            icon: Icons.dots-horizontal-48;
            label: root.t.more;
            clicked => {
                root.page = "altro";
            }
        }
    }

    // ---- A conversation: the wave in the character's colour of the state, the words, "Ferma"
    // (in error the gold "Parla" stays, to try again).
    if root.conversation: Rectangle {
        for v[i] in root.wave: Rectangle {
            x: Grid.col-cx - 300px + i * (600px / root.wave.length) + (600px / root.wave.length - self.width) / 2;
            y: 240px - self.height / 2;
            width: 4px;
            height: 6px + v * 168px;
            border-radius: 2px;
            background: root.state-color.with-alpha(0.35 + 0.65 * min(1, v * 1.6));
        }
        if root.state != "speaking" && !root.answer-early: Text {
            x: Grid.col-x;
            y: root.state == "thinking" && root.heard != "" ? 356px : 376px;
            width: Grid.col-width;
            text: root.state == "listening" ? root.phrase-listening
                : root.state == "thinking" ? root.phrase-thinking : root.phrase-error;
            font-size: 48px;
            color: Theme.text;
            horizontal-alignment: center;
        }
        if root.state == "thinking" && root.heard != "" && !root.answer-early: Text {
            x: Grid.col-x + 24px;
            y: 432px;
            width: Grid.col-width - 48px;
            height: 80px;
            text: "«" + root.heard + "»";
            font-size: 28px;
            color: Theme.text-2;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
        if root.state == "error": Text {
            x: Grid.col-x + 24px;
            y: 448px;
            width: Grid.col-width - 48px;
            text: root.t.error-hint;
            font-size: 24px;
            color: Theme.text-2;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if (root.state == "speaking" || root.answer-early) && root.heard != "": Text {
            x: Grid.col-x;
            y: 348px;
            width: Grid.col-width;
            text: "«" + root.heard + "»";
            font-size: 20px;
            color: Theme.text-3;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.state == "speaking" || root.answer-early: Text {
            x: Grid.col-x;
            y: 392px;
            width: Grid.col-width;
            height: 212px;
            text: root.answer;
            font-size: 34px;
            color: Theme.text;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
        if root.state != "error": PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            stop: true;
            label: root.t.stop;
            tint: root.state-color;
            fill: Theme.bg.mix(root.state-color, 0.82);
            clicked => {
                root.stop-clicked();
            }
        }
        // It woke by itself: stop, and keep what it heard as a mistake.
        if root.state == "listening" || root.state == "thinking": BareButton {
            x: root.slot-right;
            y: Grid.band-y;
            icon: Icons.ear-hearing-off-48;
            label: root.t.false-wake;
            clicked => {
                root.false-wake-clicked();
            }
        }
        if root.state == "error": PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
    }

    // ---- A timer has finished: it takes over everything (the Home Assistant view included).
    // Its name large, how long ago, "Ferma"; a touch anywhere stops it too, "+1 minuto" is the
    // one exception.
    if root.ringing: Rectangle {
        TouchArea {
            x: Grid.stage-width;
            width: root.width - Grid.stage-width;
            clicked => {
                root.stop-clicked();
            }
        }
        HorizontalLayout {
            x: Grid.col-cx - self.width / 2;
            y: 120px;
            width: self.preferred-width;
            height: 40px;
            spacing: 12px;
            Rectangle {
                width: 32px;
                Icon {
                    y: 4px;
                    width: 32px;
                    height: 32px;
                    source: root.ringing-alarm ? Icons.alarm-32 : Icons.timer-32;
                    color: Theme.accent;
                }
            }
            Text {
                text: root.ringing-alarm ? root.t.alarm : root.t.timer-finished;
                font-size: 28px;
                color: Theme.accent;
                vertical-alignment: center;
            }
        }
        Text {
            x: Grid.col-x;
            y: 176px;
            width: Grid.col-width;
            text: root.ringing-name;
            font-size: 96px;
            font-weight: 300;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            x: Grid.col-x;
            y: 312px;
            width: Grid.col-width;
            text: root.ringing-since;
            font-family: "Inter Tnum";
            font-size: 34px;
            color: Theme.text-2;
            horizontal-alignment: center;
        }
        Text {
            x: Grid.col-x;
            y: 548px;
            width: Grid.col-width;
            text: root.t.touch-to-stop;
            font-size: 24px;
            color: Theme.text-3;
            horizontal-alignment: center;
        }
        // The gold disc breathes while it rings: one ring, alpha only.
        breath := Rectangle {
            property <bool> strong: false;
            x: root.slot-mid + 20px;
            y: Grid.band-y - 12px;
            width: 120px;
            height: 120px;
            border-radius: 60px;
            border-width: 2px;
            border-color: Theme.accent.with-alpha(self.strong ? 0.45 : 0.15);
            animate border-color { duration: 800ms; easing: ease-in-out; }
        }
        Timer {
            interval: 800ms;
            running: !root.still;
            triggered => {
                breath.strong = !breath.strong;
            }
        }
        BareButton {
            x: root.slot-left;
            y: Grid.band-y;
            icon: Icons.plus-48;
            label: root.t.plus-minute;
            clicked => {
                root.snooze();
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            stop: true;
            label: root.t.stop;
            clicked => {
                root.stop-clicked();
            }
        }
    }

    // ---- A reminder is due: it takes the desk (not a conversation or a ringing timer). Its
    // words large, when it was for, "OK" (done) and "in ten minutes"; no touch elsewhere stops
    // it, so a passing hand does not lose it.
    if root.noticing: Rectangle {
        // The time now: the shared corner clock (below), "Ore 16:00" reads against it.
        HorizontalLayout {
            x: Grid.col-cx - self.width / 2;
            y: 120px;
            width: self.preferred-width;
            height: 40px;
            spacing: 12px;
            Rectangle {
                width: 32px;
                Icon {
                    y: 4px;
                    width: 32px;
                    height: 32px;
                    source: Icons.calendar-clock-32;
                    color: Theme.accent;
                }
            }
            Text {
                text: root.notice-title;
                font-size: 28px;
                color: Theme.accent;
                vertical-alignment: center;
            }
        }
        Text {
            x: Grid.col-x;
            y: 176px;
            width: Grid.col-width;
            height: 264px;
            text: root.notice-text;
            font-size: root.notice-text.character-count > 12 ? 48px : 96px;
            font-weight: root.notice-text.character-count > 12 ? 400 : 300;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
        Text {
            x: Grid.col-x;
            y: 452px;
            width: Grid.col-width;
            text: root.notice-when;
            font-family: "Inter Tnum";
            font-size: 34px;
            color: Theme.text-2;
            horizontal-alignment: center;
        }
        // The gold disc breathes, like a ringing timer but slower: it waits, it does not ring.
        notice-breath := Rectangle {
            property <bool> strong: false;
            x: root.slot-mid + 20px;
            y: Grid.band-y - 12px;
            width: 120px;
            height: 120px;
            border-radius: 60px;
            border-width: 2px;
            border-color: Theme.accent.with-alpha(self.strong ? 0.45 : 0.12);
            animate border-color { duration: 1400ms; easing: ease-in-out; }
        }
        Timer {
            interval: 1400ms;
            running: !root.still;
            triggered => {
                notice-breath.strong = !notice-breath.strong;
            }
        }
        BareButton {
            x: root.slot-left;
            y: Grid.band-y;
            icon: Icons.timer-plus-48;
            label: root.notice-later;
            clicked => {
                root.notice-snooze();
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.check-44;
            label: root.t.ok;
            clicked => {
                root.notice-ok();
            }
        }
    }

    // ---- "Altro": every place that is not alive right now, as tiles; Home Assistant stays in
    // the left slot, where it is on the home.
    if root.desk && root.desk-page == "altro": altro-page := Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.more;
            clock: root.clock;
            back => {
                root.page = "home";
            }
        }
        // Two columns; five or six tiles: three rows of compact ones. Six at most: what plays
        // gives its tile up when everything else is there (it has its card on the home).
        // Seven or eight: four rows of dense ones.
        property <int> n-fixed: 4 + (root.brain-present ? 2 : 0) + (root.shopping-on ? 1 : 0);
        property <bool> music-tile: root.music-playing && self.n-fixed < 8;
        property <int> n-tiles: self.n-fixed + (self.music-tile ? 1 : 0);
        property <bool> compact: self.n-tiles > 4;
        property <bool> dense: self.n-tiles > 6;
        property <length> row-step: self.dense ? 124px : self.compact ? 160px : 220px;
        // Two columns across the desk column.
        property <length> tile-w: (Grid.col-width - 24px) / 2;
        // Settings last, in the bottom right corner (a gap on its left when the count is odd).
        property <int> i-ha: self.music-tile ? 3 : 2;
        property <int> i-settings: self.n-tiles - 1 + mod(self.n-tiles, 2);
        property <int> i-memories: self.i-ha + 1;
        property <int> i-reminders: self.i-memories + 1;
        property <int> i-shopping: self.i-memories + (root.brain-present ? 2 : 0);
        Tile {
            x: Grid.col-x;
            y: 128px;
            width: parent.tile-w;
            compact: parent.compact;
            dense: parent.dense;
            icon: Icons.forum-48;
            label: root.t.conversations;
            status: root.tile-chat;
            clicked => {
                root.page = "chat";
            }
        }
        Tile {
            x: Grid.col-x + parent.tile-w + 24px;
            y: 128px;
            width: parent.tile-w;
            compact: parent.compact;
            dense: parent.dense;
            icon: Icons.timer-48;
            label: root.t.timers-alarms;
            status: root.tile-timers;
            clicked => {
                root.page = "timers";
            }
        }
        if altro-page.music-tile: Tile {
            x: Grid.col-x;
            y: 128px + parent.row-step;
            width: parent.tile-w;
            compact: parent.compact;
            dense: parent.dense;
            icon: Icons.music-note-48;
            label: root.t.music;
            status: root.music-title;
            clicked => {
                root.page = "music";
            }
        }
        Tile {
            x: Grid.col-x + mod(parent.i-settings, 2) * (parent.tile-w + 24px);
            y: 128px + floor(parent.i-settings / 2) * parent.row-step;
            width: parent.tile-w;
            compact: parent.compact;
            dense: parent.dense;
            icon: Icons.cog-48;
            label: root.t.settings;
            status: root.tile-settings;
            clicked => {
                root.page = "settings";
            }
        }
        // Home Assistant: the setup's checks (linked), else the QR code.
        Tile {
            x: Grid.col-x + mod(parent.i-ha, 2) * (parent.tile-w + 24px);
            y: 128px + floor(parent.i-ha / 2) * parent.row-step;
            width: parent.tile-w;
            compact: parent.compact;
            dense: parent.dense;
            icon: Icons.view-dashboard-48;
            label: "Home Assistant";
            status: root.ha-status;
            clicked => {
                root.page-back = "altro";
                root.page = root.ha-linked ? "ha" : "setup";
            }
        }
        if root.brain-present: Tile {
            x: Grid.col-x + mod(parent.i-memories, 2) * (parent.tile-w + 24px);
            y: 128px + floor(parent.i-memories / 2) * parent.row-step;
            width: parent.tile-w;
            compact: parent.compact;
            dense: parent.dense;
            icon: Icons.brain-48;
            label: root.t.memories;
            status: root.tile-memories;
            clicked => {
                root.page-back = "altro";
                root.page = "memories";
            }
        }
        if root.brain-present: Tile {
            x: Grid.col-x + mod(parent.i-reminders, 2) * (parent.tile-w + 24px);
            y: 128px + floor(parent.i-reminders / 2) * parent.row-step;
            width: parent.tile-w;
            compact: parent.compact;
            dense: parent.dense;
            icon: Icons.calendar-clock-48;
            label: root.t.reminders;
            status: root.tile-reminders;
            clicked => {
                root.page-back = "altro";
                root.page = "reminders";
            }
        }
        if root.shopping-on: Tile {
            x: Grid.col-x + mod(parent.i-shopping, 2) * (parent.tile-w + 24px);
            y: 128px + floor(parent.i-shopping / 2) * parent.row-step;
            width: parent.tile-w;
            compact: parent.compact;
            dense: parent.dense;
            icon: Icons.cart-48;
            label: root.t.shopping;
            status: root.tile-shopping;
            clicked => {
                root.page-back = "altro";
                root.page = "shopping";
            }
        }
        BareButton {
            x: root.slot-left;
            y: Grid.band-y;
            icon: Icons.view-dashboard-48;
            label: root.t.ha-short;
            enabled: !root.offline;
            clicked => {
                root.home-assistant-clicked();
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
        // What the user can say (its own page).
        BareButton {
            x: root.slot-right;
            y: Grid.band-y;
            icon: Icons.account-voice-48;
            label: root.t.what-short;
            clicked => {
                root.page-back = "altro";
                root.page = "what";
            }
        }
    }

    // ---- What to say: the groups of things the character does, with sentences to try.
    if root.desk && root.desk-page == "what": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.what-title;
            clock: root.clock;
            back => {
                root.page = root.page-back;
            }
        }
        Text {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            text: root.t.what-intro;
            font-size: 24px;
            color: Theme.text-2;
            overflow: elide;
        }
        what-flick := Flickable {
            x: Grid.col-x;
            y: Grid.page-y + 44px;
            width: Grid.col-width;
            // To the page band's end (608), clear of the action band.
            height: Grid.page-y + Grid.page-height - self.y;
            content-height: what-list.preferred-height;
            what-list := VerticalLayout {
                spacing: 18px;
                for g in root.what-rows: HorizontalLayout {
                    spacing: 20px;
                    Rectangle {
                        width: 32px;
                        Icon {
                            y: 2px;
                            width: 32px;
                            height: 32px;
                            color: Theme.accent;
                            source: g.icon == "timer" ? Icons.timer-32
                                : g.icon == "alarm" ? Icons.alarm-32
                                : g.icon == "calendar-clock" ? Icons.calendar-clock-32
                                : g.icon == "cart" ? Icons.cart-32
                                : g.icon == "view-dashboard" ? Icons.view-dashboard-32
                                : g.icon == "music-note" ? Icons.music-note-32
                                : Icons.weather-night-32;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: g.title;
                            font-size: 28px;
                            color: Theme.text;
                        }
                        Text {
                            text: g.examples;
                            font-size: 24px;
                            color: Theme.text-2;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
        ScrollFade {
            x: Grid.col-x;
            y: what-flick.y + what-flick.height - self.height;
            width: Grid.col-width;
            more: what-flick.content-height > what-flick.height + 1px
                && what-flick.content-y > what-flick.height - what-flick.content-height + 1px;
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
    }

    // ---- Conversations: what was said, newest at the bottom; it scrolls inside the middle band.
    if root.desk && root.desk-page == "chat": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.conversations;
            clock: root.clock;
            back => {
                root.page = "altro";
            }
        }
        if root.chat.length == 0: Text {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            height: Grid.page-height;
            text: root.t.chat-empty;
            font-size: 24px;
            color: Theme.text-3;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        chat-list := Flickable {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            height: Grid.page-height;
            content-height: max(self.height, lines.preferred-height);
            // Newest at the bottom: starts scrolled to the end (a flick replaces this binding).
            content-y: min(0px, self.height - self.content-height);
            lines := VerticalLayout {
                y: max(0px, chat-list.height - self.preferred-height);
                width: chat-list.width;
                spacing: 16px;
                for line in root.chat: Rectangle {
                    height: line.kind == "sep" ? 40px : line.kind == "user" ? user.height : char.height;
                    if line.kind == "sep": ChatSeparator {
                        width: parent.width;
                        text: line.text;
                    }
                    user := ChatUser {
                        width: parent.width;
                        visible: line.kind == "user";
                        text: line.kind == "user" ? line.text : "";
                    }
                    char := ChatCharacter {
                        width: parent.width;
                        visible: line.kind == "character";
                        text: line.kind == "character" ? line.text : "";
                    }
                }
            }
        }
        // Older lines fade out under the header (one small gradient, not over the whole list).
        Rectangle {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            height: 48px;
            background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg.with-alpha(0) 100%);
        }
        BareButton {
            x: root.slot-left;
            y: Grid.band-y;
            icon: Icons.message-plus-48;
            label: root.t.start-over;
            clicked => {
                root.chat-new();
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
        BareButton {
            x: root.slot-right;
            y: Grid.band-y;
            icon: Icons.delete-48;
            label: root.t.clear;
            enabled: root.chat.length > 0;
            clicked => {
                root.dialog = "clear";
            }
        }
    }

    // ---- Timers and alarms: what runs and what is set; new ones by touch or by voice.
    if root.desk && root.desk-page == "timers": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.timers-alarms;
            clock: root.clock;
            back => {
                root.page = "altro";
            }
        }
        Flickable {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            height: Grid.page-height;
            content-height: max(self.height, timers-col.preferred-height);
            timers-col := VerticalLayout {
                alignment: start;
                spacing: 8px;
                SectionTitle {
                    x: 8px;
                    text: root.t.timers-section;
                }
                if root.timer-rows.length == 0: Text {
                    height: 56px;
                    text: root.t.timers-empty;
                    font-size: 24px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
                if root.timer-rows.length > 0: Group {
                    height: root.timer-rows.length * 96px;
                    for tr[i] in root.timer-rows: TimerLine {
                        y: i * 96px;
                        width: parent.width;
                        first: i == 0;
                        name: tr.name;
                        detail: tr.detail;
                        left: tr.left;
                        remaining: tr.remaining;
                        paused: tr.paused;
                        pause-resume => {
                            root.timer-pause(tr.id);
                        }
                        cancel => {
                            root.timer-cancel(tr.id);
                        }
                    }
                }
                Rectangle {
                    height: 8px;
                }
                SectionTitle {
                    text: root.t.alarms-section;
                }
                if root.alarm-rows.length == 0: Text {
                    height: 56px;
                    text: root.t.alarms-empty;
                    font-size: 24px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
                if root.alarm-rows.length > 0: Group {
                    height: root.alarm-rows.length * 88px;
                    for a[i] in root.alarm-rows: AlarmLine {
                        y: i * 88px;
                        width: parent.width;
                        first: i == 0;
                        time: a.time;
                        days: a.days;
                        on: a.on;
                        toggled(v) => {
                            root.alarm-toggled(a.id, v);
                        }
                        delete => {
                            root.alarm-delete(a.id);
                        }
                    }
                }
            }
        }
        BareButton {
            x: root.slot-left;
            y: Grid.band-y;
            icon: Icons.timer-plus-48;
            label: root.t.new-timer;
            clicked => {
                root.dialog = "new-timer";
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
        BareButton {
            x: root.slot-right;
            y: Grid.band-y;
            icon: Icons.alarm-plus-48;
            label: root.t.new-alarm;
            clicked => {
                root.dialog = "new-alarm";
            }
        }
    }

    // ---- Settings: grouped rows; Language and Screen open their own page, Suspend a question.
    if root.desk && root.desk-page == "settings": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.settings;
            clock: root.clock;
            back => {
                root.page = "home";
            }
        }
        Flickable {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            // No action band here: the rows go down to the bottom of the screen.
            height: root.height - Grid.page-y - 16px;
            content-height: max(self.height, settings-col.preferred-height);
            settings-col := VerticalLayout {
                alignment: start;
                spacing: 8px;
                SectionTitle {
                    text: root.character-name.to-uppercase();
                }
                Group {
                    height: 3 * 76px;
                    Row {
                        y: 0;
                        width: parent.width;
                        first: true;
                        icon: Icons.translate-28;
                        label: root.t.language;
                        value: root.language-name;
                        clicked => {
                            root.language-back = "settings";
                            root.page = "language";
                        }
                    }
                    Row {
                        y: 76px;
                        width: parent.width;
                        kind: "toggle";
                        icon: Icons.forum-32;
                        label: root.t.save-conversations;
                        on: root.save-chat;
                        toggled(v) => {
                            root.save-chat-toggled(v);
                        }
                    }
                    // How readily he answers to his name: a step around the wake word's cutoff.
                    Row {
                        y: 152px;
                        width: parent.width;
                        kind: "";
                        icon: Icons.microphone-32;
                        label: root.t.wake-sensitivity;
                    }
                    Stepper {
                        x: parent.width - 16px - self.width;
                        y: 152px + 6px;
                        value-width: 200px;
                        font-size: 28px;
                        value: root.wake-step < 0 ? root.t.wake-less : root.wake-step > 0 ? root.t.wake-more : root.t.wake-normal;
                        step(d) => {
                            root.wake-step-changed(max(-1, min(1, root.wake-step + d)));
                        }
                    }
                }
                Rectangle {
                    height: 8px;
                }
                SectionTitle {
                    text: root.t.section-device;
                }
                Group {
                    height: 4 * 76px;
                    Row {
                        y: 0;
                        width: parent.width;
                        first: true;
                        kind: "";
                        icon: Icons.volume-high-28;
                        label: root.t.volume;
                        value: root.volume + "%";
                    }
                    Row {
                        y: 76px;
                        width: parent.width;
                        icon: Icons.brightness-6-28;
                        label: root.t.screen;
                        value: root.screen-status;
                        clicked => {
                            root.page = "screen";
                        }
                    }
                    Row {
                        y: 152px;
                        width: parent.width;
                        kind: "";
                        icon: Icons.information-28;
                        label: root.t.info;
                        value: root.version;
                    }
                    Row {
                        y: 228px;
                        width: parent.width;
                        icon: Icons.power-sleep-28;
                        label: root.t.suspend-row;
                        value: root.t.suspend-hint;
                        clicked => {
                            root.dialog = "suspend";
                        }
                    }
                }
            }
        }
    }

    // ---- Settings → Home Assistant: one row per check of the setup after the QR link.
    if root.desk && root.desk-page == "ha": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: "Home Assistant";
            clock: root.clock;
            back => {
                root.page = root.page-back;
            }
        }
        ha-flick := Flickable {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            height: Grid.page-height;
            content-height: max(self.height, ha-col.preferred-height);
            ha-col := VerticalLayout {
                alignment: start;
                spacing: 8px;
                // Only the introduction, before the first setup: what the setup is doing is in
                // the pop-up, "all set" is said by the character, a failure is a pop-up (nothing
                // here changes size, the rows stay put).
                if !root.ha-configured: Text {
                    text: root.t.ha-intro;
                    font-size: 22px;
                    color: Theme.text-2;
                    wrap: word-wrap;
                }
                if root.ha-picks.length > 0: Group {
                    height: root.ha-picks.length * 76px;
                    for r[i] in root.ha-picks: Row {
                        y: i * 76px;
                        width: parent.width;
                        first: i == 0;
                        label: r.label;
                        value: r.value;
                        clicked => {
                            if !root.ha-busy {
                                root.ha-pick(r.id);
                            }
                        }
                    }
                }
                if root.usage-line != "": Group {
                    height: 76px;
                    Row {
                        width: parent.width;
                        first: true;
                        icon: Icons.brain-28;
                        label: root.usage-label;
                        value: root.usage-line;
                        clicked => {
                            root.page-back = "ha";
                            root.page = "usage";
                        }
                    }
                }
                for r in root.ha-rows: HaCheck {
                    check: r;
                    repair-label: root.t.ha-repair;
                    enabled: !root.ha-busy;
                    repair => {
                        root.ha-repair(r.id);
                    }
                }
                if root.ha-configured: Group {
                    height: 76px;
                    Row {
                        width: parent.width;
                        first: true;
                        icon: Icons.view-dashboard-28;
                        label: root.t.ha-lists;
                        clicked => {
                            root.page = "ha-lists";
                        }
                    }
                }
            }
        }
        ScrollFade {
            x: Grid.col-x;
            y: ha-flick.y + ha-flick.height - self.height;
            width: Grid.col-width;
            more: ha-flick.content-height > ha-flick.height + 1px
                && ha-flick.content-y > ha-flick.height - ha-flick.content-height + 1px;
        }
        // The heaviest action on the screen: on the right, with its own sign (not the X).
        BareButton {
            x: root.slot-right;
            y: Grid.band-y;
            icon: Icons.link-variant-off-48;
            label: root.t.ha-unlink;
            enabled: !root.ha-busy;
            clicked => {
                root.dialog = "unlink";
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            spinning: root.ha-busy;
            enabled: !root.ha-busy;
            icon: root.ha-busy || (root.ha-configured && !root.ha-done) ? Icons.refresh-44 : Icons.check-44;
            label: root.ha-busy ? root.t.ha-working-short : root.ha-done ? root.t.ok
                : root.ha-configured ? root.t.ha-check : root.t.ha-configure;
            clicked => {
                if root.ha-done {
                    root.ha-ok();
                } else if !root.ha-busy {
                    root.ha-check();
                }
            }
        }
    }

    // ---- Home Assistant → the AI's use: today large, this month, the last 30 days, and where the
    // numbers come from (an estimate of the body, or the integration that counts them).
    if root.desk && root.desk-page == "usage": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.usage-label;
            clock: root.clock;
            back => {
                root.page = "ha";
            }
        }
        SectionTitle {
            x: Grid.col-x + 8px;
            y: Grid.page-y;
            text: root.usage-today-label;
        }
        Text {
            x: Grid.col-x;
            y: Grid.page-y + 36px;
            text: root.usage-today;
            font-family: "Inter Tnum";
            font-size: 96px;
            font-weight: 300;
            color: Theme.text;
        }
        Text {
            x: Grid.col-x + 8px;
            y: Grid.page-y + 156px;
            text: root.usage-month;
            font-family: "Inter Tnum";
            font-size: 24px;
            color: Theme.text-2;
        }
        if root.usage-detail != "": Text {
            x: Grid.col-x + 8px;
            y: Grid.page-y + 190px;
            width: Grid.col-width - 16px;
            text: root.usage-detail;
            font-family: "Inter Tnum";
            font-size: 20px;
            color: Theme.text-3;
            overflow: elide;
        }
        // The last 30 days: thin bars on a baseline, today gold, the tallest day's amount on a
        // faint top line, the day of the month under today and every week before it.
        chart := Rectangle {
            x: Grid.col-x + 8px;
            y: Grid.page-y + 236px;
            width: Grid.col-width - 16px;
            height: 268px;
            property <length> top: 72px;
            property <length> plot-h: 156px;
            property <length> step: self.width / max(1, root.usage-bars.length);
            property <length> bar-w: min(10px, self.step * 0.5);
            SectionTitle {
                x: 0;
                y: 0;
                text: root.usage-chart-label;
            }
            if root.usage-max != "": Rectangle {
                y: chart.top;
                height: 1px;
                background: Theme.line.with-alpha(0.6);
            }
            if root.usage-max != "": Text {
                x: parent.width - self.width;
                y: chart.top - 26px;
                text: root.usage-max;
                font-family: "Inter Tnum";
                font-size: 20px;
                color: Theme.text-3;
            }
            Rectangle {
                y: chart.top + chart.plot-h;
                height: 2px;
                background: Theme.line;
            }
            for b[i] in root.usage-bars: Rectangle {
                x: i * chart.step;
                y: chart.top;
                width: chart.step;
                height: chart.plot-h + 40px;
                property <bool> today: i == root.usage-bars.length - 1;
                if b.height > 0: Rectangle {
                    x: (parent.width - chart.bar-w) / 2;
                    y: chart.plot-h - self.height;
                    width: chart.bar-w;
                    height: max(3px, chart.plot-h * b.height);
                    border-radius: chart.bar-w / 2;
                    background: parent.today ? Theme.accent : Theme.text-3.with-alpha(0.55);
                }
                if b.label != "": Text {
                    x: (parent.width - self.width) / 2;
                    y: chart.plot-h + 10px;
                    text: b.label;
                    font-family: "Inter Tnum";
                    font-size: 20px;
                    color: parent.today ? Theme.accent : Theme.text-3;
                }
            }
        }
        // Where the numbers come from: the way to precise ones, or that they are.
        Text {
            x: Grid.col-x + 8px;
            y: chart.y + chart.height + 8px;
            width: Grid.col-width - 16px;
            text: root.usage-note;
            font-size: 20px;
            color: root.usage-precise ? Theme.text-3 : Theme.text-2;
            wrap: word-wrap;
        }
    }

    // ---- Home Assistant → one choice (the AI, speech-to-text, voice): a tap picks, back to the page.
    if root.desk && root.desk-page == "ha-pick": Rectangle {
        PickPage {
            title: root.ha-pick-title;
            clock: root.clock;
            hint: root.ha-pick-hint;
            rows: root.ha-pick-rows;
            back => {
                root.page = "ha";
            }
            picked(id) => {
                root.page = "ha";
                root.ha-picked(id);
            }
        }
    }

    // ---- The weather: the current condition and the daily forecast (Home Assistant).
    if root.desk && root.desk-page == "weather": Rectangle {
        WeatherPage {
            title: root.t.weather-title;
            clock: root.clock;
            icon: root.weather-icon;
            temperature: root.temperature;
            condition: root.weather-condition;
            high: root.weather-high;
            low: root.weather-low;
            forecast-title: root.t.weather-forecast;
            empty: root.t.weather-no-forecast;
            rows: root.forecast-rows;
            back => {
                root.page = "home";
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
    }

    // ---- Home Assistant → Lists and calendars: which ones the screen (and the brain) use.
    if root.desk && root.desk-page == "ha-lists": Rectangle {
        ListsPage {
            title: root.t.lists-title;
            clock: root.clock;
            hint: root.t.lists-hint;
            todo-title: root.t.lists-todo;
            calendars-title: root.t.lists-calendars;
            empty: root.t.lists-empty;
            todo: root.choice-todo;
            calendars: root.choice-calendars;
            back => {
                root.page = "ha";
            }
            toggled(id) => {
                root.choice-toggled(id);
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
    }

    // ---- Memories (home-companion-brain): what Alfred heard once, to confirm (Right / Wrong), then what he
    // knows (in the order the assistant reads it, each deletable); "Dimentica tutto" in the action band.
    if root.desk && root.desk-page == "memories": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.memories;
            clock: root.clock;
            back => {
                root.page = root.page-back;
            }
        }
        mem-flick := Flickable {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            height: Grid.page-height;
            content-height: max(self.height, mem-col.preferred-height);
            mem-col := VerticalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: root.memories-status;
                    font-size: 20px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
                if root.confirm-rows.length > 0: SectionTitle {
                    text: root.t.memories-confirm;
                }
                for m in root.confirm-rows: ConfirmRow {
                    text: m.text;
                    detail: m.date;
                    right: root.t.memories-right;
                    wrong: root.t.memories-wrong;
                    confirm => {
                        root.memory-confirm(m.id);
                    }
                    reject => {
                        root.memory-delete(m.id);
                    }
                }
                if root.memory-rows.length > 0: SectionTitle {
                    text: root.t.memories-about;
                }
                if root.memory-rows.length > 0 && root.memories-sent != "": Text {
                    text: root.memories-sent;
                    font-size: 20px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
                for m in root.memory-rows: DeletableRow {
                    text: m.text;
                    detail: m.date;
                    dim: m.dim;
                    ask: root.t.delete-question;
                    delete => {
                        root.memory-delete(m.id);
                    }
                }
                if root.memory-rows.length > 0 && root.memories-more != "": Text {
                    text: root.memories-more;
                    font-size: 20px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
                if root.brain-present && root.memory-rows.length == 0 && root.confirm-rows.length == 0: Text {
                    height: 120px;
                    text: root.t.memories-empty;
                    font-size: 24px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        ScrollFade {
            x: Grid.col-x;
            y: mem-flick.y + mem-flick.height - self.height;
            width: Grid.col-width;
            more: mem-flick.content-height > mem-flick.height + 1px
                && mem-flick.content-y > mem-flick.height - mem-flick.content-height + 1px;
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
        BareButton {
            x: root.slot-right;
            y: Grid.band-y;
            icon: Icons.delete-48;
            label: root.t.forget-all;
            enabled: root.brain-present && (root.memory-rows.length > 0 || root.confirm-rows.length > 0);
            clicked => {
                root.dialog = "forget";
            }
        }
    }

    // ---- Promemoria: home-companion-brain's reminders still to come (a reminder is not a memory, nor a timer
    // or an alarm: its own page), soonest first; a row asks before it is deleted.
    if root.desk && root.desk-page == "reminders": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.reminders;
            clock: root.clock;
            back => {
                root.page = root.page-back;
            }
        }
        Flickable {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            height: Grid.page-height;
            content-height: max(self.height, rem-col.preferred-height);
            rem-col := VerticalLayout {
                alignment: start;
                spacing: 8px;
                for j in root.job-rows: DeletableRow {
                    text: j.text;
                    detail: j.when;
                    ask: root.t.delete-question;
                    delete => {
                        root.job-cancel(j.id);
                    }
                }
                if root.event-rows.length > 0: SectionTitle {
                    text: root.t.calendar-events;
                }
                for e in root.event-rows: EventRow {
                    text: e.text;
                    detail: e.when;
                }
                if root.job-rows.length == 0 && root.event-rows.length == 0: Text {
                    height: 120px;
                    text: root.t.reminders-empty;
                    font-size: 24px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
    }

    // ---- The shopping list (Home Assistant's `todo` entity): open items, a tap ticks one.
    if root.desk && root.desk-page == "shopping": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.shopping;
            clock: root.clock;
            back => {
                root.page = root.page-back;
            }
        }
        if root.shop-rows.length == 0: Text {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            height: Grid.page-height;
            text: root.t.shopping-empty;
            font-size: 24px;
            color: Theme.text-3;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Flickable {
            x: Grid.col-x;
            y: Grid.page-y;
            width: Grid.col-width;
            height: Grid.page-height;
            content-height: max(self.height, shop-col.preferred-height);
            shop-col := VerticalLayout {
                alignment: start;
                spacing: 8px;
                for item in root.shop-rows: VerticalLayout {
                    if item.uid == "": SectionTitle {
                        text: item.text;
                    }
                    if item.uid != "": ShopItem {
                        text: item.text;
                        done => {
                            root.shop-done(item.uid);
                        }
                    }
                }
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            icon: Icons.microphone-44;
            label: root.t.talk;
            clicked => {
                root.talk-clicked();
            }
        }
    }

    // ---- Settings → Language.
    if root.desk && root.desk-page == "language": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.language;
            clock: root.clock;
            back => {
                root.page = root.language-back;
            }
        }
        Group {
            x: Grid.col-x;
            y: Grid.page-y + 16px;
            width: Grid.col-width;
            height: root.languages.length * 76px;
            for l[i] in root.languages: Row {
                y: i * 76px;
                width: parent.width;
                first: i == 0;
                kind: "check";
                label: l.name;
                on: l.selected;
                clicked => {
                    root.language-chosen(l.code);
                    root.page = root.language-back;
                }
            }
        }
    }

    // ---- Settings → Screen: the night hours.
    if root.desk && root.desk-page == "screen": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.screen;
            clock: root.clock;
            back => {
                root.page = "settings";
            }
        }
        Group {
            x: Grid.col-x;
            y: Grid.page-y + 16px;
            width: Grid.col-width;
            height: root.night-on ? 3 * 76px + 2 * 12px : 76px;
            Row {
                y: 0;
                width: parent.width;
                first: true;
                kind: "toggle";
                icon: Icons.weather-night-28;
                label: root.t.night-mode;
                on: root.night-on;
                toggled(v) => {
                    root.night-changed(v, root.night-start, root.night-end);
                }
            }
            if root.night-on: Row {
                y: 88px;
                width: parent.width;
                kind: "";
                label: root.t.night-from;
            }
            if root.night-on: Stepper {
                x: parent.width - 16px - self.width;
                y: 94px;
                value-width: 120px;
                font-size: 40px;
                value: (root.night-start < 10 ? "0" : "") + root.night-start + ":00";
                step(d) => {
                    root.night-changed(true, mod(root.night-start + d + 24, 24), root.night-end);
                }
            }
            if root.night-on: Row {
                y: 176px;
                width: parent.width;
                kind: "";
                label: root.t.night-to;
            }
            if root.night-on: Stepper {
                x: parent.width - 16px - self.width;
                y: 182px;
                value-width: 120px;
                font-size: 40px;
                value: (root.night-end < 10 ? "0" : "") + root.night-end + ":00";
                step(d) => {
                    root.night-changed(true, root.night-start, mod(root.night-end + d + 24, 24));
                }
            }
        }
        night-hint := Text {
            x: Grid.col-x + 8px;
            y: Grid.page-y + 16px + (root.night-on ? 3 * 76px + 2 * 12px : 76px) + 16px;
            width: Grid.col-width - 16px;
            text: root.t.night-hint;
            font-size: 24px;
            color: Theme.text-3;
            wrap: word-wrap;
        }
        // The home's layout: normal (three cards) or compact (the clock higher, four cards).
        Group {
            x: Grid.col-x;
            y: night-hint.y + night-hint.preferred-height + 24px;
            width: Grid.col-width;
            height: 76px;
            Row {
                y: 0;
                width: parent.width;
                first: true;
                kind: "toggle";
                icon: Icons.view-dashboard-28;
                label: root.t.home-compact;
                // How many cards the home shows now.
                value: root.home-compact ? root.t.home-compact-on : root.t.home-compact-off;
                on: root.home-compact;
                toggled(v) => {
                    root.home-compact-changed(v);
                }
            }
        }
    }

    // ---- Music: what is playing, large; the transport in the action band. Only while something
    // plays (AirPlay is not there yet: the data is a placeholder).
    if root.desk && root.desk-page == "music": Rectangle {
        PageHeader {
            x: Grid.col-x;
            y: Grid.header-y;
            title: root.t.music;
            clock: root.clock;
            back => {
                root.page = "home";
            }
        }
        // The cover on top, centred in the column; the title and the artist under it; at the
        // bottom the spectrum, segmented like an old LCD player's.
        // The frame takes the picture's shape (a video's 16:9 thumbnail too), 320 px tall and
        // at most the column wide, so nothing is cut; square without a picture.
        music-cover-frame := Rectangle {
            x: Grid.col-cx - self.width / 2;
            y: root.music-spectrum-shown ? 104px : root.music-layout == 1 ? 100px : root.music-layout == 3 ? 104px : 112px;
            height: root.music-spectrum-shown ? 288px : root.music-layout == 1 ? 420px
                : root.music-layout == 3 ? music-bar.y - 28px - self.y : 352px;
            width: root.music-cover.height > 0
                ? min(Grid.col-width, self.height * root.music-cover.width / root.music-cover.height)
                : self.height;
            border-radius: 20px;
            background: Theme.surface;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.music-cover;
                image-fit: ImageFit.contain;
            }
            // No cover art for this track: a note, never the previous track's picture.
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 96px;
                height: 96px;
                source: Icons.music-note-48;
                color: Theme.text-3;
                visible: root.music-cover.width == 0;
            }
        }
        if root.music-layout != 3: Text {
            x: Grid.col-x;
            // Title and artist (about 76 px together) halfway between the picture and the bar
            // (layout 1: right under the picture).
            y: root.music-layout == 1 ? music-cover-frame.y + music-cover-frame.height + 20px
                : (music-cover-frame.y + music-cover-frame.height + music-bar.y) / 2 - 38px;
            width: Grid.col-width;
            text: root.music-title;
            font-size: 34px;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.music-layout != 3: Text {
            x: Grid.col-x;
            y: root.music-layout == 1 ? music-cover-frame.y + music-cover-frame.height + 66px
                : (music-cover-frame.y + music-cover-frame.height + music-bar.y) / 2 + 8px;
            width: Grid.col-width;
            text: root.music-album != "" && root.music-artist != "" ? root.music-artist + " · " + root.music-album
                : root.music-artist;
            font-size: 24px;
            color: Theme.text-2;
            horizontal-alignment: center;
            overflow: elide;
        }
        // The spectrum, as a quiet moving background: one bar per band (low on the left), lit
        // segments from the bottom and a peak segment that falls back slowly. Values 0..1
        // (music-bands, music-peaks).
        // Low and short (seven rows), on the action band: there under the rest, not a block.
        if root.music-spectrum-shown: spectrum := Rectangle {
            // Narrow, centred under the title: thin bars with air between them.
            x: Grid.col-cx - self.width / 2;
            // Between the artist's line (it ends near 482) and the bar, the same air above and below.
            y: (482px + music-bar.y - self.height) / 2;
            width: 480px;
            height: 7 * 13px;
            property <int> rows: floor(self.height / 13px);
            property <length> bar-step: self.width / max(1, root.music-bands.length);
            for v[i] in root.music-bands: Rectangle {
                x: i * spectrum.bar-step + (spectrum.bar-step - self.width) / 2;
                width: min(20px, spectrum.bar-step - 8px);
                property <int> lit: round(v * spectrum.rows);
                property <int> peak: round((root.music-peaks.length > i ? root.music-peaks[i] : 0) * spectrum.rows);
                for j in spectrum.rows: Rectangle {
                    y: spectrum.height - (j + 1) * 13px;
                    height: 8px;
                    // A background that moves, not a meter to read: faint, the peak a little more.
                    background: j < parent.lit ? Theme.text.with-alpha(0.14)
                        : j == parent.peak - 1 && parent.peak > parent.lit ? Theme.text.with-alpha(0.22)
                        : transparent;
                }
            }
        }
        // Where the sound comes from and its controls: the mirrored screen's bar, the same pill,
        // in the action band as the other pages' buttons.
        music-bar := MusicBar {
            x: Grid.col-cx - self.width / 2;
            y: Grid.band-y + (Grid.slot-height - self.height) / 2;
            source: root.music-source;
            title: root.music-layout == 3 ? root.music-title : "";
            detail: root.music-layout == 3 ? root.music-artist : "";
            paused: root.music-paused;
            previous => {
                root.music-previous();
            }
            toggle => {
                root.music-toggle();
            }
            next => {
                root.music-next();
            }
        }
    }

    // ---- First start, 1: the language (none in the configuration, none chosen yet). The
    // character on his stage, "Welcome" in each language, one big button per language named in
    // itself; a tap applies it at once (as Settings → Language) and goes on.
    if root.desk && root.desk-page == "welcome": Rectangle {
        Text {
            x: Grid.col-x;
            y: 48px;
            width: Grid.col-width;
            text: root.welcome-title;
            font-size: 48px;
            color: Theme.text;
            wrap: word-wrap;
        }
        Flickable {
            x: Grid.col-x;
            y: 200px;
            width: Grid.col-width;
            height: 776px - self.y;
            content-height: max(self.height, welcome-col.preferred-height);
            welcome-col := VerticalLayout {
                alignment: start;
                spacing: 16px;
                for l in root.welcome-rows: Rectangle {
                    height: 112px;
                    border-radius: Grid.card-radius;
                    background: welcome-touch.pressed ? Theme.surface-2 : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.line;
                    Icon {
                        x: 34px;
                        y: 42px;
                        width: 28px;
                        height: 28px;
                        source: Icons.translate-28;
                        color: Theme.accent;
                    }
                    Text {
                        x: 88px;
                        width: parent.width - 88px - 72px;
                        height: parent.height;
                        text: l.name;
                        font-size: 34px;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Icon {
                        x: parent.width - 60px;
                        y: 42px;
                        width: 28px;
                        height: 28px;
                        source: Icons.chevron-right-28;
                        color: Theme.text-3;
                    }
                    welcome-touch := TouchArea {
                        clicked => {
                            Feedback.tap();
                            root.language-chosen(l.code);
                        }
                    }
                }
            }
        }
    }

    // ---- First start, 2: Home Assistant (no address in the configuration, none picked yet),
    // found on the network over mDNS (crates/home-companion/src/ha/discover.rs). One row per
    // instance (its name and address); a tap saves it and the body restarts with it, then the
    // QR link page follows. Band: the language · Search again (gold) · Later.
    if root.desk && root.desk-page == "find-ha": Rectangle {
        Text {
            x: Grid.col-x;
            y: 36px;
            width: Grid.col-width;
            text: root.t.find-title;
            font-size: 34px;
            color: Theme.text;
        }
        Text {
            x: Grid.col-x;
            y: 84px;
            width: Grid.col-width;
            text: root.find-state == "searching" ? root.t.find-searching
                : root.find-state == "found" ? root.t.find-found
                : root.find-state == "none" ? root.t.find-none : "";
            font-size: 24px;
            color: Theme.text-2;
            overflow: elide;
        }
        if root.find-state == "searching": Rectangle {
            x: Grid.col-cx - 120px;
            y: 360px;
            width: 240px;
            height: 4px;
            border-radius: 2px;
            background: Theme.line;
            clip: true;
            Rectangle {
                x: root.still ? 80px : (mod(animation-tick() / 1ms, 1400) / 1400) * (parent.width + self.width) - self.width;
                width: 80px;
                height: 4px;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
        if root.find-state == "found": Flickable {
            x: Grid.col-x;
            y: 140px;
            width: Grid.col-width;
            height: 600px - self.y;
            content-height: max(self.height, found-group.height);
            found-group := Group {
                x: 0;
                y: 0;
                width: parent.width;
                height: root.find-rows.length * 104px;
                for f[i] in root.find-rows: Rectangle {
                    y: i * 104px;
                    width: parent.width;
                    height: 104px;
                    background: found-touch.pressed ? Theme.surface-2 : transparent;
                    if i > 0: Separator {
                        y: 0;
                        width: parent.width - 72px;
                    }
                    Icon {
                        x: 24px;
                        y: 22px;
                        width: 28px;
                        height: 28px;
                        source: Icons.view-dashboard-28;
                        color: Theme.accent;
                    }
                    Text {
                        x: 72px;
                        y: 16px;
                        width: parent.width - 72px - 64px;
                        text: f.name;
                        font-size: 28px;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        x: 72px;
                        y: 56px;
                        width: parent.width - 72px - 64px;
                        text: f.url;
                        font-size: 24px;
                        color: Theme.text-2;
                        overflow: elide;
                    }
                    Icon {
                        x: parent.width - 52px;
                        y: 38px;
                        width: 28px;
                        height: 28px;
                        source: Icons.chevron-right-28;
                        color: Theme.text-3;
                    }
                    found-touch := TouchArea {
                        clicked => {
                            Feedback.tap();
                            root.find-pick(f.url);
                        }
                    }
                }
            }
        }
        if root.find-line != "": VerticalLayout {
            x: Grid.col-x;
            y: 140px;
            width: Grid.col-width;
            height: Grid.band-y - 160px;
            alignment: start;
            SetupRow {
                icon: root.find-state == "saving" ? Icons.check-28 : Icons.information-28;
                text: root.find-line;
                color: root.find-state == "saving" ? Theme.accent : Theme.text-2;
            }
        }
        BareButton {
            x: root.slot-left;
            y: Grid.band-y;
            icon: Icons.translate-48;
            label: root.language-name;
            enabled: root.find-state != "saving";
            clicked => {
                root.language-back = "find-ha";
                root.page = "language";
            }
        }
        PrimaryButton {
            x: root.slot-mid;
            y: Grid.band-y;
            spinning: root.find-state == "searching" && !root.still;
            enabled: root.find-state == "found" || root.find-state == "none";
            icon: Icons.refresh-44;
            label: root.t.find-again;
            clicked => {
                root.find-search();
            }
        }
        BareButton {
            x: root.slot-right;
            y: Grid.band-y;
            icon: Icons.close-48;
            label: root.t.later;
            leaves: true;
            enabled: root.find-state != "saving";
            clicked => {
                root.setup-later();
                root.page = "home";
            }
        }
    }

    // ---- Link Home Assistant (Settings → Home Assistant, or the first start without a token).
    // The code opens Home Assistant's authorisation page on the phone; once confirmed there, the
    // body gets its tokens (design.md section 8, crates/home-companion/src/ha/link.rs).
    if root.desk && root.desk-page == "setup": Rectangle {
        Text {
            x: Grid.col-x;
            y: 36px;
            text: root.t.setup-title;
            font-size: 34px;
            color: Theme.text;
        }
        Text {
            x: Grid.col-x;
            y: 84px;
            text: root.t.setup-subtitle;
            font-size: 24px;
            color: Theme.text-2;
        }
        // The code: dark modules on ivory (phones read light-on-dark codes poorly).
        Rectangle {
            x: Grid.col-x;
            y: 140px;
            width: 296px;
            height: 296px;
            border-radius: 16px;
            background: Theme.text;
            Image {
                x: 16px;
                y: 16px;
                width: 264px;
                height: 264px;
                source: root.setup-qr;
                image-rendering: pixelated;
                opacity: root.setup-linked ? 0.25 : 1.0;
            }
        }
        Step {
            x: Grid.col-x + 336px;
            y: 148px;
            width: Grid.col-x + Grid.col-width - self.x;
            number: "1";
            text: root.t.setup-step1;
            done: root.setup-linked;
        }
        Step {
            x: Grid.col-x + 336px;
            y: 260px;
            width: Grid.col-x + Grid.col-width - self.x;
            number: "2";
            text: root.t.setup-step2;
            done: root.setup-linked;
        }
        Step {
            x: Grid.col-x + 336px;
            y: 372px;
            width: Grid.col-x + Grid.col-width - self.x;
            number: "3";
            text: root.t.setup-step3;
            done: root.setup-linked;
        }
        // Three rows under the code and the steps, across both columns, each as tall as its text:
        // Wi-Fi (the network's name), Home Assistant's address (a long DNS name wraps), how the
        // link went.
        VerticalLayout {
            x: Grid.col-x;
            y: 476px;
            width: 1232px - Grid.col-x;
            height: Grid.band-y - 476px;
            spacing: 8px;
            alignment: start;
            if root.setup-wifi != "": SetupRow {
                icon: Icons.wifi-28;
                text: root.setup-wifi;
                color: Theme.text-2;
            }
            if root.setup-ha != "": SetupRow {
                icon: Icons.view-dashboard-28;
                text: root.setup-ha;
                color: Theme.text-2;
                wrap: char-wrap;
            }
            if root.setup-status != "": SetupRow {
                icon: root.setup-linked ? Icons.check-28 : Icons.information-28;
                text: root.setup-status;
                color: root.setup-linked ? Theme.accent : Theme.danger;
            }
        }
        BareButton {
            x: root.slot-left;
            y: Grid.band-y;
            icon: Icons.translate-48;
            label: root.language-name;
            clicked => {
                root.language-back = "setup";
                root.page = "language";
            }
        }
        BareButton {
            x: root.slot-right;
            y: Grid.band-y;
            icon: Icons.close-48;
            label: root.setup-linked ? root.t.close : root.t.later;
            leaves: true;
            clicked => {
                if !root.setup-linked {
                    root.setup-later();
                }
                root.page = "home";
            }
        }
    }

    // ---- The undo chip after a timer or an alarm was removed (5 s), above the action band.
    if root.desk && root.undo-text != "": Rectangle {
        x: Grid.col-cx - self.width / 2;
        y: 560px;
        width: undo-label.preferred-width + 200px;
        height: 64px;
        border-radius: 32px;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: Theme.line;
        undo-label := Text {
            x: 28px;
            height: parent.height;
            text: root.undo-text;
            font-size: 24px;
            color: Theme.text;
            vertical-alignment: center;
        }
        PillButton {
            x: parent.width - 8px - self.width;
            y: 6px;
            height: 52px;
            width: 140px;
            label: root.t.undo;
            clicked => {
                root.undo-clicked();
            }
        }
    }

    // ---- Do not disturb and the microphone off: quiet lines over the clock (and over the
    // night's clock), side by side when both are on.
    if (root.dnd || root.mic-off) && (root.night-home || (root.desk && root.desk-page == "home" && !Grid.compact)): HorizontalLayout {
        x: Grid.col-cx - self.width / 2;
        y: 12px;
        width: min(self.preferred-width, Grid.col-width);
        height: 32px;
        spacing: 10px;
        if root.dnd: Rectangle {
            width: 28px;
            Icon {
                y: 2px;
                width: 28px;
                height: 28px;
                source: Icons.bell-off-28;
                color: root.night-home ? Theme.night : Theme.text-3;
            }
        }
        // 24 px: a state to see from across the room.
        if root.dnd: Text {
            text: root.dnd-line;
            font-size: 24px;
            color: root.night-home ? Theme.night : Theme.text-2;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.dnd && root.mic-off: Rectangle {
            width: 14px;
        }
        if root.mic-off: Rectangle {
            width: 28px;
            Icon {
                y: 2px;
                width: 28px;
                height: 28px;
                source: Icons.microphone-off-32;
                color: root.night-home ? Theme.night : Theme.danger;
            }
        }
        if root.mic-off: Text {
            text: root.mic-off-line;
            font-size: 24px;
            color: root.night-home ? Theme.night : Theme.danger;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // ---- The time, small at the top right, where a screen has no clock of its own: the
    // conversation, a ringing timer, a due reminder, the link and first-start pages (the home and
    // the night have the big one, the pages their header; not over a full view or the control
    // center, whose tiles fill the top).
    if !CasaBridge.visible && root.mirror-t < 0.001 && !root.control-open && !root.starting
        && (root.conversation || root.ringing || root.noticing
            || (root.desk && (root.desk-page == "setup" || root.desk-page == "welcome" || root.desk-page == "find-ha"))): CornerClock {
        x: Grid.col-x + Grid.col-width - self.width;
        y: Grid.header-y;
        clock: root.clock;
    }

    // ---- Dialogs on the desk.
    if root.dialog == "suspend": Dialog {
        icon: Icons.power-sleep-48;
        title: root.t.suspend-question;
        text: root.t.suspend-text;
        cancel: root.t.cancel;
        confirm: root.t.suspend;
        answered(yes) => {
            root.dialog = "";
            if (yes) {
                root.page = "home";
                root.suspend-confirmed();
            }
        }
    }
    if root.dialog == "unlink": Dialog {
        icon: Icons.close-48;
        title: root.t.ha-unlink-question;
        cancel: root.t.cancel;
        confirm: root.t.ha-unlink;
        answered(yes) => {
            root.dialog = "";
            if (yes) {
                root.ha-unlink();
            }
        }
    }
    if root.dialog == "forget": Dialog {
        icon: Icons.delete-48;
        title: root.t.forget-question;
        text: root.t.forget-text;
        cancel: root.t.cancel;
        confirm: root.t.forget-all;
        answered(yes) => {
            root.dialog = "";
            if (yes) {
                root.memories-forget();
            }
        }
    }
    if root.dialog == "clear": Dialog {
        icon: Icons.delete-48;
        title: root.t.clear-question;
        text: root.t.clear-text;
        cancel: root.t.cancel;
        confirm: root.t.clear;
        answered(yes) => {
            root.dialog = "";
            if (yes) {
                root.chat-clear();
            }
        }
    }
    if root.dialog == "new-timer": new-timer := Dialog {
        property <int> minutes: 5;
        title: root.t.new-timer;
        cancel: root.t.cancel;
        confirm: root.t.start;
        content-height: 64px + 24px + 64px + 24px + 64px;
        Stepper {
            x: (672px - self.width) / 2;
            y: 0;
            value-width: 240px;
            value: new-timer.minutes + " " + root.t.minutes;
            step(d) => {
                new-timer.minutes = max(1, min(180, new-timer.minutes + d));
            }
        }
        for m[i] in [1, 3, 5, 10, 15, 30]: Chip {
            x: 48px + mod(i, 3) * 200px;
            y: 88px + floor(i / 3) * 88px;
            width: 176px;
            label: m + " " + root.t.minutes;
            chosen: new-timer.minutes == m;
            clicked => {
                new-timer.minutes = m;
            }
        }
        answered(yes) => {
            root.dialog = "";
            if (yes) {
                root.timer-start(new-timer.minutes);
            }
        }
    }
    if root.dialog == "new-alarm": new-alarm := Dialog {
        property <int> hour: 7;
        property <int> minute: 0;
        // Bit i (Monday = 0) set: the alarm rings that day.
        property <int> days: 31;
        title: root.t.new-alarm;
        cancel: root.t.cancel;
        confirm: root.t.save;
        content-height: 64px + 24px + 64px;
        Stepper {
            x: 48px;
            y: 0;
            value-width: 96px;
            value: (new-alarm.hour < 10 ? "0" : "") + new-alarm.hour;
            step(d) => {
                new-alarm.hour = mod(new-alarm.hour + d + 24, 24);
            }
        }
        Text {
            x: (672px - self.width) / 2;
            y: 0;
            width: 32px;
            height: 64px;
            text: ":";
            font-family: "Inter Tnum";
            font-size: 48px;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Stepper {
            x: 672px - 48px - self.width;
            y: 0;
            value-width: 96px;
            value: (new-alarm.minute < 10 ? "0" : "") + new-alarm.minute;
            step(d) => {
                new-alarm.minute = mod(new-alarm.minute + 5 * d + 60, 60);
            }
        }
        for d[i] in root.day-letters: Chip {
            property <bool> on: mod(floor(new-alarm.days / pow(2, i)), 2) == 1;
            x: 40px + i * 84px;
            y: 88px;
            width: 76px;
            label: d;
            chosen: self.on;
            clicked => {
                new-alarm.days = new-alarm.days + (self.on ? -1 : 1) * pow(2, i);
            }
        }
        answered(yes) => {
            root.dialog = "";
            if (yes) {
                root.alarm-save(new-alarm.hour, new-alarm.minute, new-alarm.days);
            }
        }
    }

    // Home Assistant's own frontend, full screen over everything else (casa.slint). A ringing
    // timer is drawn over it (below).
    }

    // The veil over the stepped-back home (one flat rectangle; only while the view is moving).
    if (CasaBridge.visible || root.mirror-t > 0) && root.covered > 0.001 && root.covered < 0.999: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000.with-alpha(0.35 * root.covered);
    }

    // ---- Screen mirroring: the sender's screen centred on the character's background, as large
    // as it fits (no plate around his pose). With wide bands at the sides (a portrait sender) the character keeps a stage in the left one
    // (his state, small, while the wake word is answered) and the controls stay in the right
    // one; over a video that fills the screen nothing is on top at rest, a tap brings up a bar
    // of controls at the bottom for 4 s and a conversation comes as Home Assistant's bar.
    if root.mirror-t > 0.001: Rectangle {
        // It moves the way the swipe that closes it goes, as Home Assistant's view: in from the
        // side away from the home button's edge, out towards it (edge right: out to the left).
        property <length> off-w: round((1 - root.mirror-t) * root.width / 1px) * 1px;
        property <length> off-h: round((1 - root.mirror-t) * root.height / 1px) * 1px;
        x: CasaBridge.edge == "right" ? -self.off-w : CasaBridge.edge == "left" ? self.off-w : 0;
        y: CasaBridge.edge == "bottom" ? -self.off-h : CasaBridge.edge == "top" ? self.off-h : 0;
        width: root.width;
        height: root.height;
        background: root.character-background;
        // A tap on the picture: with the bar shown it goes, otherwise it comes up.
        TouchArea {
            clicked => {
                if (root.mirror-chrome && !root.mirror-sides) {
                    root.mirror-chrome = false;
                } else {
                    root.mirror-poked();
                }
            }
        }
        // The video grows the last tenth of its size while the page comes in.
        Rectangle {
            property <float> grow: 0.9 + 0.1 * root.mirror-t;
            width: root.mirror-w * self.grow;
            height: root.mirror-h * self.grow;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.mirror-frame;
                image-fit: fill;
            }
            // Before the first picture: the sender's name and a sliding line.
            if root.mirror-frame.width == 0: Rectangle {
                Text {
                    x: 24px;
                    y: parent.height / 2 - 72px;
                    width: parent.width - 48px;
                    text: root.mirror-source;
                    font-size: 28px;
                    color: Theme.text;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    x: 24px;
                    y: parent.height / 2 - 28px;
                    width: parent.width - 48px;
                    text: root.t.mirror-waiting;
                    font-size: 24px;
                    color: Theme.text-2;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height / 2 + 48px;
                    width: min(240px, parent.width - 48px);
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.line;
                    clip: true;
                    Rectangle {
                        x: root.still ? 80px : (mod(animation-tick() / 1ms, 1400) / 1400) * (parent.width + self.width) - self.width;
                        width: 80px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
            }
        }

        // -- The left band: the character, his state while the wake word is answered.
        if root.mirror-sides: Rectangle {
            x: 0;
            width: root.mirror-band;
            height: root.height;
            // At rest the character and his invitation are centred in the height; a
            // conversation lifts him to make room for the phrase and Ferma under him, never
            // into the home button's corner (top 24 + 72 px + a gap): he is a little smaller.
            property <length> pose-max: root.conversation ? 400px : 480px;
            property <length> pose-h: root.pose.width > 0
                ? min(self.pose-max, (self.width - 48px) * root.pose.height / root.pose.width) : self.pose-max;
            animate pose-h { duration: 250ms; easing: ease-in-out; }
            property <length> pose-y: root.conversation ? 520px - self.pose-h
                : (self.height - (self.pose-h + 62px)) / 2;
            animate pose-y { duration: 250ms; easing: ease-in-out; }
            Image {
                x: (parent.width - self.width) / 2;
                y: parent.pose-y;
                height: parent.pose-h;
                width: root.pose.height > 0 ? self.height * root.pose.width / root.pose.height : 0px;
                source: root.pose;
                image-fit: fill;
            }
            // Nothing going on: the invitation, quiet.
            if !root.conversation: Text {
                x: 24px;
                y: parent.pose-y + parent.pose-h + 32px;
                width: parent.width - 48px;
                text: root.phrase-idle;
                font-size: 24px;
                color: Theme.text-3;
                horizontal-alignment: center;
                overflow: elide;
            }
            // A conversation: a small wave in the state's colour, the phrase or the answer,
            // Ferma (in error the phrase alone: "Okay Alfred" still works).
            if root.conversation: Rectangle {
                for v[i] in root.wave: Rectangle {
                    visible: mod(i, 3) == 0;
                    x: (parent.width - 24 * 9px) / 2 + floor(i / 3) * 9px;
                    y: 548px - self.height / 2;
                    width: 4px;
                    height: 4px + v * 40px;
                    border-radius: 2px;
                    background: root.state-color.with-alpha(0.35 + 0.65 * min(1, v * 1.6));
                }
                Text {
                    x: 24px;
                    y: 576px;
                    width: parent.width - 48px;
                    height: 60px;
                    text: root.state == "speaking" ? root.answer
                        : root.state == "listening" ? root.phrase-listening
                        : root.state == "thinking" ? (root.answer != "" ? root.answer : root.heard != "" ? "«" + root.heard + "»" : root.phrase-thinking)
                        : root.state == "error" ? root.phrase-error : root.answer;
                    font-size: root.state == "speaking" || (root.state == "thinking" && (root.heard != "" || root.answer != "")) ? 24px : 28px;
                    color: Theme.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
                if root.state != "error": PrimaryButton {
                    x: (parent.width - self.width) / 2;
                    y: Grid.band-y + 16px;
                    stop: true;
                    label: "";
                    tint: root.state-color;
                    fill: Theme.bg.mix(root.state-color, 0.82);
                    clicked => {
                        root.stop-clicked();
                    }
                }
            }
            // Home, top left (the same button as over a sideways video), drawn last: nothing
            // of the band ever covers it.
            MirrorHomeButton {
                x: 24px;
                y: 24px;
                clicked => {
                    root.page = "home";
                }
            }
        }

        // -- The right band: the time, who mirrors, the sender's transport, the volume, home.
        if root.mirror-sides: Rectangle {
            x: root.width - root.mirror-band;
            width: root.mirror-band;
            height: root.height;
            property <length> cx: self.width / 2;
            Text {
                x: 0;
                y: 40px;
                width: parent.width;
                text: root.clock;
                font-family: "Inter Tnum";
                font-size: 96px;
                font-weight: 300;
                letter-spacing: -1px;
                color: Theme.text;
                horizontal-alignment: center;
            }
            // The date under the time, as on the home.
            Text {
                x: 24px;
                y: 176px;
                width: parent.width - 48px;
                height: 40px;
                text: root.date;
                font-size: 28px;
                color: Theme.text-2;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            // Who mirrors, at the bottom, level with "Okay Alfred" (it is stopped from the home's card).
            HorizontalLayout {
                x: (parent.width - self.width) / 2;
                y: Grid.band-y + 12px;
                width: min(self.preferred-width, parent.width - 48px);
                height: 40px;
                spacing: 12px;
                accessible-role: text;
                accessible-label: root.t.mirror + " · " + root.mirror-source;
                Rectangle {
                    width: 28px;
                    Icon {
                        y: 6px;
                        width: 28px;
                        height: 28px;
                        source: Icons.cast-connected-28;
                        color: Theme.accent;
                    }
                }
                Text {
                    text: root.mirror-source;
                    font-size: 24px;
                    color: Theme.text-2;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            GlyphButton {
                x: parent.cx - 144px;
                y: 344px;
                icon: Icons.skip-previous-36;
                clicked => {
                    root.music-previous();
                }
            }
            PrimaryButton {
                x: parent.cx - self.width / 2;
                y: 328px;
                icon: root.music-paused ? Icons.play-44 : Icons.pause-44;
                label: "";
                clicked => {
                    root.music-toggle();
                }
            }
            GlyphButton {
                x: parent.cx + 80px;
                y: 344px;
                icon: Icons.skip-next-36;
                clicked => {
                    root.music-next();
                }
            }
            LevelBar {
                x: 32px;
                y: 488px;
                width: parent.width - 64px;
                icon: root.volume == 0 ? Icons.volume-off-28
                    : root.volume >= 67 ? Icons.volume-high-28
                    : root.volume >= 34 ? Icons.volume-medium-28 : Icons.volume-low-28;
                level: root.volume;
                value: root.volume + "%";
                changed(v) => {
                    root.control-volume(v);
                }
            }
        }

        // -- Over a video that fills the width: home (left) and the time (right) above, shown
        // and hidden with the bar below (a tap). In the band above the video when there is one
        // (a sideways phone leaves ~104 px), else over the picture on a veil.
        if !root.mirror-sides: mirror-top := Rectangle {
            property <length> band: (root.height - root.mirror-h) / 2;
            property <bool> fits: self.band >= 56px;
            x: 0;
            y: 0;
            width: root.width;
            height: max(104px, self.band);
            opacity: root.mirror-chrome ? 1 : 0;
            animate opacity { duration: 180ms; }
            background: self.fits ? transparent : Theme.bg.with-alpha(0.55);
            MirrorHomeButton {
                x: 24px;
                y: max(16px, (parent.height - self.height) / 2);
                enabled-touch: mirror-top.opacity > 0.5;
                clicked => {
                    root.page = "home";
                }
            }
            Text {
                x: parent.width - 24px - self.width;
                y: (parent.height - self.height) / 2;
                text: root.clock;
                font-size: 40px;
                font-weight: 300;
                color: Theme.text;
            }
        }

        // -- Over a video that fills the screen: the bar of controls, up from the bottom edge
        // on a tap (in the bottom band of a sideways phone), away 4 s after the last touch.
        if !root.mirror-sides: MusicBar {
            x: (parent.width - self.width) / 2;
            // Centred in the band below the video when it has room (a sideways phone), else
            // 16 px off the bottom edge, over the picture.
            property <length> vband: (root.height - root.mirror-h) / 2;
            y: !root.mirror-chrome ? parent.height + 8px
                : self.vband >= self.height + 8px ? parent.height - self.vband + (self.vband - self.height) / 2
                : parent.height - 16px - self.height;
            animate y {
                duration: 180ms;
                easing: ease-out;
            }
            source: root.mirror-source;
            paused: root.music-paused;
            poked => {
                root.mirror-poked();
            }
            previous => {
                root.mirror-poked();
                root.music-previous();
            }
            toggle => {
                root.mirror-poked();
                root.music-toggle();
            }
            next => {
                root.mirror-poked();
                root.music-next();
            }
        }
    }


    CasaScreen {
        width: root.width;
        height: root.height;
        character-name: root.character-name;
        stage-pose: root.pose;
        error-pose: root.error-pose;
        stage-cx: root.character-cx;
        stage-top: root.character-top;
        stage-height: root.character-height;
        stage-background: root.character-background;
        // Swipe in from the home button's edge, as over Home Assistant's view (the same edge,
        // CasaBridge.edge): far enough in, home; the mirroring goes on.
        mirror-swipe := TouchArea {
            property <string> e: CasaBridge.edge;
            property <length> d: self.e == "right" ? self.pressed-x - self.mouse-x
                : self.e == "left" ? self.mouse-x - self.pressed-x
                : self.e == "top" ? self.mouse-y - self.pressed-y : self.pressed-y - self.mouse-y;
            x: self.e == "right" ? parent.width - 36px : 0;
            y: self.e == "bottom" ? parent.height - 36px : 0;
            width: self.e == "left" || self.e == "right" ? 36px : parent.width;
            height: self.e == "left" || self.e == "right" ? parent.height : 36px;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.up && self.d > 120px) {
                    Feedback.back();
                    root.page = "home";
                }
            }
        }
    }

    // "Okay Alfred" with Home Assistant's view open: a bar over its toolbar instead of leaving
    // the dashboard (you see the switch flip while he answers). Two lines at most; a longer
    // answer goes to Alfred's layout and comes back (Rust closes and reopens the view).
    // It slides down from the top edge when the conversation starts and back up when it ends
    // (translate only); out of the way above the screen otherwise.
    if CasaBridge.visible || (root.mirror-t > 0.999 && !root.mirror-sides): Rectangle {
        property <length> bar-height: clamp(bar-text.preferred-height + 32px, 80px, 128px);
        x: (root.width - self.width) / 2;
        y: root.conversation ? 16px : -self.height - 8px;
        animate y {
            duration: 180ms;
            easing: ease-out;
        }
        width: 720px;
        height: self.bar-height;
        border-radius: 28px;
        background: Theme.surface;
        border-width: 2px;
        border-color: root.state-color.with-alpha(0.6);
        TouchArea { }
        Rectangle {
            x: 12px;
            y: (parent.height - self.height) / 2;
            width: 56px;
            height: 56px;
            border-radius: 28px;
            background: Theme.bg;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: CasaBridge.visible ? CasaBridge.face : root.face;
                image-fit: cover;
            }
        }
        bar-text := Text {
            x: 84px;
            y: (parent.height - min(self.preferred-height, 68px)) / 2;
            width: parent.width - 84px - 200px;
            height: min(self.preferred-height, 68px);
            text: root.state == "speaking" ? root.answer
                : root.state == "listening" ? root.phrase-listening
                : root.state == "thinking" ? (root.answer != "" ? root.answer : root.heard != "" ? "«" + root.heard + "»" : root.phrase-thinking)
                : root.state == "error" ? root.phrase-error : root.answer;
            font-size: 28px;
            color: Theme.text;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: center;
        }
        // A small wave: every third bar of the big one.
        for v[i] in root.wave: Rectangle {
            visible: mod(i, 3) == 0;
            x: parent.width - 196px + floor(i / 3) * 5px;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: 4px + v * 40px;
            border-radius: 1.5px;
            background: root.state-color.with-alpha(0.35 + 0.65 * min(1, v * 1.6));
        }
        Rectangle {
            x: parent.width - 76px;
            y: (parent.height - self.height) / 2;
            width: 64px;
            height: 64px;
            Rectangle {
                x: 4px;
                y: 4px;
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: bar-stop.pressed ? Theme.surface-2 : Theme.bg.mix(root.state-color, 0.82);
                border-width: 2px;
                border-color: root.state-color.with-alpha(0.9);
                Rectangle {
                    x: 19px;
                    y: 19px;
                    width: 18px;
                    height: 18px;
                    border-radius: 3px;
                    background: Theme.text;
                }
            }
            bar-stop := TouchArea {
                clicked => {
                    root.stop-clicked();
                }
            }
        }
    }

    // ---- A house command went through: a card over the desk for 8 s (over Home Assistant's
    // view or a mirrored screen: the same card, centred at the top). In the home's
    // third card slot, above the action band; during a conversation at the top of the desk,
    // over nothing it says.
    // (On the home it is the first card of the context band instead: cards.rs; on the other
    // desk pages none, it would cover them.)
    if root.done-shown && !root.done-popup && !root.night-home && !root.starting && !root.ringing
        && (CasaBridge.visible || root.mirror-t > 0.001 || root.conversation): DoneCard {
        property <bool> full: CasaBridge.visible || (root.mirror-t > 0.999 && !root.mirror-sides);
        x: self.full ? (root.width - self.width) / 2 : Grid.col-x;
        // Over a full view: top centre (bottom centre while the conversation bar is at the top).
        y: self.full ? (root.conversation ? root.height - 24px - self.height : 24px)
            : root.conversation ? 24px : Grid.cards-y + 2 * (Grid.card-height + Grid.card-gap);
        line: root.done-line;
        undo-label: root.done-undo ? root.t.undo : "";
        undo => {
            root.done-undo-clicked();
        }
    }

    // ---- The same command, undoable: the big pop-up first, over everything (Home Assistant's
    // view and a mirrored screen included), centred on the screen as the microphone's card.
    if root.done-shown && root.done-popup && !root.done-from-ask && !root.starting: Dialog {
        scrim: false;
        closable: true;
        box-width: 520px;
        centre-x: root.dialog-cx;
        icon: Icons.check-circle-48;
        title: root.done-name;
        text: root.done-state;
        text-gold: true;
        confirm: root.t.undo;
        confirm-icon: Icons.undo-36;
        left: root.done-left;
        answered(yes) => {
            root.done-undo-clicked();
        }
        closed => {
            root.done-ok-clicked();
        }
    }

    // ---- Home Assistant's setup at work (after a choice, Configure, Check and repair): the
    // pop-up with a turning icon over the page, nothing to touch until it is done.
    // ---- Home Assistant's setup ended badly: its reason, until OK.
    // Its end: "All set" (done) with the gold check, or what went wrong in red.
    if !root.ha-busy && root.ha-line != "" && root.desk && (root.desk-page == "ha" || root.desk-page == "ha-pick"): Dialog {
        icon: root.ha-done ? Icons.check-circle-48 : Icons.alert-circle-64;
        icon-color: root.ha-done ? Theme.accent : Theme.danger;
        title: root.ha-line;
        confirm: root.t.ok;
        answered(yes) => {
            root.ha-dismiss();
        }
    }

    if root.ha-popup && root.desk && (root.desk-page == "ha" || root.desk-page == "ha-pick"): Dialog {
        icon: Icons.refresh-44;
        spinning: true;
        busy-bar: true;
        title: root.t.ha-working;
        text: root.ha-step != "" ? root.ha-step : root.t.ha-working-wait;
    }

    // ---- A house command waits for a yes (covers, valves): the question, No and Yes, the time
    // left as a thin line. Over everything but the volume (Home Assistant's view and a mirrored
    // screen included: then centred on the screen); it wakes the screen.
    // After the yes the SAME window goes on: "Doing it…" with a turning icon and Cancel (a no
    // within a spoken yes's seconds, else an undo as soon as it is done), then the done ("Closed",
    // Cancel = Undo, its time left), then it closes. One window, one Cancel in one place.
    property <bool> ask-done: !root.ask-shown && root.done-shown && root.done-popup && root.done-from-ask;
    if (root.ask-shown || root.ask-done) && !root.starting: Dialog {
        property <bool> asking: root.ask-shown && !root.ask-working;
        // The veil stays to the end: one window, and the page under it does not read through.
        scrim: true;
        closable: root.ask-done;
        icon: root.ask-done ? Icons.check-circle-48 : root.ask-working ? Icons.refresh-44 : Icons.help-circle-48;
        title: root.ask-done ? root.done-name : root.ask-working ? root.ask-working-title : root.ask-text;
        text: root.ask-done ? root.done-state : root.ask-working ? root.t.ask_executing : root.ask-names;
        text-gold: root.ask-done;
        cancel: self.asking ? root.t.no : "";
        confirm: self.asking ? root.t.yes
            : root.ask-done ? (root.done-undo ? root.t.undo : "")
            : root.ask-cancelled ? "" : root.t.undo;
        confirm-icon: self.asking ? @image-url("") : Icons.undo-36;
        spinning: root.ask-working && !root.ask-done;
        busy-bar: root.ask-working && !root.ask-done;
        left: root.ask-done ? root.done-left : self.asking ? root.ask-left : -1;
        centre-x: root.dialog-cx;
        answered(yes) => {
            if (self.asking) {
                root.ask-answered(yes);
            } else {
                root.ask-cancel();
            }
        }
        closed => {
            if (root.ask-done) {
                root.done-ok-clicked();
            }
        }
    }

    // ---- The control center: a pull down from the top edge of the desk (never over the stage),
    // what is on at a glance and the levels; a tap on the stage, a swipe up or the chevron closes
    // it. Not over Home Assistant's view (its own pages scroll from the top).
    if !CasaBridge.visible && root.desk && !root.control-open && !root.night && root.page != "mirror": TouchArea {
        x: Grid.stage-width;
        y: 0;
        width: root.width - Grid.stage-width;
        height: 40px;
        moved => {
            if self.mouse-y - self.pressed-y > 48px {
                root.control-opened();
                root.control-open = true;
            }
        }
    }
    if root.control-open: TouchArea {
        x: 0;
        width: Grid.stage-width;
        height: root.height;
        clicked => {
            root.control-open = false;
        }
    }
    control := Rectangle {
        x: Grid.col-x - 24px;
        y: root.control-open ? 0 : -root.height;
        width: Grid.col-width + 48px;
        height: root.height;
        background: Theme.bg;
        clip: true;
        animate y {
            duration: 260ms;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }
        // Behind the controls: a swipe up closes.
        TouchArea {
            moved => {
                if self.pressed-y - self.mouse-y > 48px {
                    root.control-open = false;
                }
            }
        }
        // Three rows of compact tiles (seven: the last row starts with "do not disturb").
        for t[i] in root.control-tiles: ControlTile {
            compact: true;
            // Three to a row across the column.
            width: (Grid.col-width - 2 * 24px) / 3;
            x: 24px + mod(i, 3) * (self.width + 24px);
            y: 24px + floor(i / 3) * (self.height + 12px);
            icon: t.key == "wifi" ? (Status.wifi-level >= 0 ? Status.wifi-icon(t.on ? Status.wifi-level : 0, true)
                    : t.on ? Icons.wifi-32 : Icons.wifi-off-32)
                : t.key == "bluetooth" ? (t.on ? Icons.bluetooth-32 : Icons.bluetooth-off-32)
                : t.key == "airplay" ? Icons.cast-audio-32
                : t.key == "mic" ? (t.on ? Icons.microphone-32 : Icons.microphone-off-32)
                : t.key == "night" ? Icons.weather-night-32
                : t.key == "dnd" ? (t.on ? Icons.bell-off-32 : Icons.bell-32)
                : Icons.view-dashboard-32;
            label: t.label;
            status: t.status;
            on: t.on;
            enabled: t.enabled;
            tappable: t.tappable;
            clicked => {
                root.control-tile(t.key);
            }
        }
        LevelBar {
            x: 24px;
            y: 364px;
            width: Grid.col-width;
            icon: root.volume == 0 ? Icons.volume-off-28
                : root.volume >= 67 ? Icons.volume-high-28
                : root.volume >= 34 ? Icons.volume-medium-28 : Icons.volume-low-28;
            level: root.volume;
            value: root.volume + "%";
            changed(v) => {
                root.control-volume(v);
            }
        }
        LevelBar {
            x: 24px;
            y: 448px;
            width: Grid.col-width - 136px - 16px;
            icon: Icons.brightness-6-28;
            level: root.brightness;
            value: root.brightness-auto ? "" : root.brightness + "%";
            dim: root.brightness-auto;
            changed(v) => {
                root.control-brightness(v);
            }
        }
        Chip {
            x: 24px + Grid.col-width - 136px;
            y: 452px;
            width: 136px;
            label: root.brightness-label;
            chosen: root.brightness-auto;
            clicked => {
                root.control-brightness-auto();
            }
        }
        if root.music-playing: Rectangle {
            x: 24px;
            y: 532px;
            width: Grid.col-width;
            height: 104px;
            border-radius: Grid.tile-radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.line;
            Rectangle {
                x: 16px;
                y: 16px;
                width: 72px;
                height: 72px;
                border-radius: 12px;
                clip: true;
                background: Theme.surface-2;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.music-cover;
                    image-fit: ImageFit.cover;
                }
                // No cover art for this track: a note, never the previous track's picture.
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 32px;
                    height: 32px;
                    source: Icons.music-note-32;
                    color: Theme.text-3;
                    visible: root.music-cover.width == 0;
                }
            }
            Text {
                x: 108px;
                y: 18px;
                width: parent.width - 108px - 96px;
                text: root.music-title;
                font-size: 28px;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                x: 108px;
                y: 56px;
                width: parent.width - 108px - 96px;
                text: root.music-artist + " · " + root.music-source;
                font-size: 24px;
                color: Theme.text-2;
                overflow: elide;
            }
            GlyphButton {
                x: parent.width - 80px;
                y: 20px;
                icon: root.music-paused ? Icons.play-28 : Icons.pause-28;
                icon-color: Theme.accent;
                clicked => {
                    root.music-toggle();
                }
            }
        }
        BareButton {
            x: Grid.col-cx - (Grid.col-x - 24px) - self.width / 2;
            y: Grid.band-y;
            icon: Icons.chevron-up-48;
            label: root.t.close;
            clicked => {
                root.control-open = false;
            }
        }
    }

    // ---- The volume HUD, next to the keys (top right at 270 degrees), over everything.
    if root.volume-shown: VolumeHud {
        x: Grid.col-x + Grid.col-width - self.width;
        y: 16px;
        level: root.volume;
    }

    // ---- The microphone's switch moved: a big card in the middle, over everything.
    if root.mic-hud-shown: Dialog {
        scrim: false;
        box-width: 420px;
        centre-x: root.dialog-cx;
        icon: root.mic-hud-on ? Icons.microphone-32 : Icons.microphone-off-32;
        icon-color: root.mic-hud-on ? Theme.text : Theme.danger;
        border: root.mic-hud-on ? Theme.line : Theme.danger;
        title: root.mic-hud-text;
    }
}
