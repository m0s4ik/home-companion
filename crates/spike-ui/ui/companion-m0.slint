// The M0/M1 companion screen, frozen for this spike's simulator (src/bin/companion-sim.rs); the body
// (crates/home-companion) uses companion.slint, in the "quiet desk" layout.
//
// The companion's screen in landscape (1280x800), for any character
// (characters/README.md): the character on the left, on the right either the
// home (clock, date, weather, timers and messages) or a
// conversation state (sound wave, phrase, "Stop"). Layout first ported from
// the Python screen of the ThinkSmart View. The character gives the poses,
// its colours and its phrases; fonts, icons and the rest of the text belong to
// the body. Fonts: Inter (OFL 1.1), subsets in ../fixtures/fonts. Icons:
// Material Design Icons path data (Pictogrammers Free License, GPL friendly).
//
// The defaults below (Alfred's colours and phrases, sample timers and
// messages) are what the live preview shows; the simulator
// (src/bin/companion-sim.rs) sets them from the character and the clock.

import "../fixtures/fonts/Inter-Light-subset.ttf";
import "../fixtures/fonts/Inter-Regular-subset.ttf";
import "../fixtures/fonts/Inter-Medium-subset.ttf";
import "../fixtures/fonts/Inter-SemiBold-subset.ttf";
import { WeatherBox } from "weather.slint";
import { CasaScreen } from "casa.slint";
export { CasaBridge, CasaMenuRow } from "casa.slint";

export struct TimerRow {
    name: string,
    left: string,
}

export struct LanguageRow {
    code: string,
    name: string,
    selected: bool,
}

export struct MessageRow {
    title: string,
    text: string,
}

// Colours of the body, the same for every character.
global Theme {
    out property <color> text: #ebebec;
    out property <color> text-dim: #8e8f92;
    out property <color> weather: #bebec0;
    out property <color> accent: #28c8e6;
    out property <color> pill: #21232a;
    out property <color> pill-border: #35373d;
    out property <color> card: #15171e;
    out property <color> answer: #d2d7e1;
}

component Icon inherits Path {
    in property <color> color;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: color;
    stroke-width: 0;
}

// A pill button: icon (optional) and label, centred.
component Pill inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <color> icon-color: Theme.text;
    callback clicked();
    border-radius: self.height / 2;
    background: white.with-alpha(touch.pressed ? 0.32 : 0.12);
    border-color: white.with-alpha(0.8);
    border-width: 2px;
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        if root.icon != "": Icon {
            width: 32px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            color: root.icon-color;
        }
        Text {
            text: root.label;
            font-size: 30px;
            font-weight: 500;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A round button: a thin light ring on frosted glass, a line icon in the
// middle, the label underneath (the size given is the circle's).
component RoundButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    // Drawn instead of the icon when set (the stop square).
    in property <bool> square: false;
    in property <color> tint: white;
    in property <length> size: 92px;
    callback clicked();
    width: self.size;
    height: self.size + 46px;
    Rectangle {
        y: 0;
        width: root.size;
        height: root.size;
        border-radius: self.width / 2;
        background: root.tint.with-alpha(touch.pressed ? 0.32 : 0.12);
        border-color: white.with-alpha(0.8);
        border-width: 2px;
        if root.icon != "": Icon {
            width: root.size * 0.42;
            height: self.width;
            commands: root.icon;
            color: white;
        }
        if root.square: Rectangle {
            width: root.size * 0.3;
            height: self.width;
            border-radius: 4px;
            background: white;
        }
    }
    Text {
        y: root.size + 10px;
        width: root.width + 120px;
        x: -60px;
        text: root.label;
        font-size: 24px;
        color: Theme.text;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The volume bar (volume keys): a self-contained overlay, shown for 2 s by the body; the
// speaker icon has one to three waves with the level.
component VolumeBar inherits Rectangle {
    in property <int> level: 40;  // percent
    width: 560px;
    height: 84px;
    border-radius: self.height / 2;
    background: Theme.card.with-alpha(0.94);
    border-color: Theme.pill-border;
    border-width: 2px;
    Icon {
        x: 28px;
        y: (parent.height - self.height) / 2;
        width: 40px;
        height: 40px;
        commands: root.level >= 67
            ? "M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.76 16.5,12M3,9V15H7L12,20V4L7,9H3Z"
            : root.level >= 34
            ? "M5,9V15H9L14,20V4L9,9M18.5,12C18.5,10.23 17.5,8.71 16,7.97V16C17.5,15.29 18.5,13.76 18.5,12Z"
            : "M7,9V15H11L16,20V4L11,9H7Z";
        color: Theme.text;
    }
    property <length> track-x: 88px;
    property <length> track-width: self.width - self.track-x - 116px;
    Rectangle {
        x: root.track-x;
        y: (parent.height - self.height) / 2;
        width: root.track-width;
        height: 12px;
        border-radius: self.height / 2;
        background: white.with-alpha(0.16);
    }
    Rectangle {
        x: root.track-x;
        y: (parent.height - self.height) / 2;
        width: max(self.height, root.track-width * clamp(root.level, 0, 100) / 100);
        height: 12px;
        border-radius: self.height / 2;
        background: Theme.accent;
    }
    Text {
        x: parent.width - 28px - self.width;
        width: 80px;
        height: parent.height;
        text: root.level + "%";
        font-size: 30px;
        font-weight: 500;
        color: Theme.text;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

export component CompanionWindow inherits Window {
    width: 1280px;
    height: 800px;
    title: root.character-name;
    default-font-family: "Inter";
    background: root.character-background;

    // "home", "listening", "thinking", "speaking" or "error".
    in-out property <string> state: "home";
    // From the character: the pose of the current state, already cropped
    // (drawn 740 px tall, so every pose keeps the same scale), colours, phrases.
    in property <image> pose;
    // An animation frame of the character, drawn instead of the pose while it is set (Rust
    // places it where the animation's rect falls on the pose; only this box redraws).
    in property <image> frame;
    in property <length> frame-x;
    in property <length> frame-y;
    in property <length> frame-width;
    in property <length> frame-height;
    in property <string> character-name: "Alfred";
    in property <color> character-background: #03050d;
    in property <color> color-listening: #28c8e6;
    in property <color> color-thinking: #966ef0;
    in property <color> color-speaking: #f5aa3c;
    in property <color> color-error: #eb4646;
    in property <string> phrase-listening: "I'm listening…";
    in property <string> phrase-thinking: "Let me think…";
    in property <string> phrase-error: "I didn't understand";
    // Shown in the home when there are no notifications.
    in property <string> phrase-idle: "Say \"Okay Alfred\"";
    // The body's own words, in the user's language (English by default).
    in property <string> label-home-assistant: "Home Assistant";
    in property <string> label-talk: "Talk";
    in property <string> label-stop: "Stop";
    in property <string> label-ok: "OK";
    in property <string> label-you-said: "You said:";
    in property <string> label-language: "Language";
    in property <string> label-settings: "Settings";
    // The character's languages, each named in itself, listed in the settings
    // panel; it opens from the Settings button or a double tap on the
    // character's mouth (home only) and slides in from the right.
    in property <[LanguageRow]> languages: [
        { code: "en", name: "English", selected: true },
        { code: "it", name: "Italiano", selected: false },
    ];
    in-out property <bool> settings-open: false;
    // Settings → Suspend (the whole device to sleep): the entry, its question, and the
    // question on screen.
    in property <string> label-suspend: "Suspend";
    in property <string> label-suspend-question: "Suspend Alfred? It won't listen until you press Vol+ or Vol–.";
    in property <string> label-cancel: "Cancel";
    in-out property <bool> suspend-confirm-open: false;
    // Simulator only: the sample notifications are hidden (key N).
    in-out property <bool> notifications-hidden: false;
    // The mouth on screen (from the character's `mouth`, scaled like the pose).
    in property <length> mouth-x: 270px;
    in property <length> mouth-y: 138px;
    in property <length> mouth-width: 72px;
    in property <length> mouth-height: 43px;
    in property <string> clock: "14:25";
    in property <string> date: "TUESDAY 3 NOVEMBER";
    // The weather (weather.slint), only while Home Assistant gives real data.
    in property <bool> weather-shown: true;
    in property <string> weather-icon: "M6,19A5,5 0 0,1 1,14A5,5 0 0,1 6,9C7,6.65 9.3,5 12,5C15.43,5 18.24,7.66 18.5,11.03L19,11A4,4 0 0,1 23,15A4,4 0 0,1 19,19H6M19,13H17V12A5,5 0 0,0 12,7C9.5,7 7.45,8.82 7.06,11.19C6.73,11.07 6.37,11 6,11A3,3 0 0,0 3,14A3,3 0 0,0 6,17H19A2,2 0 0,0 21,15A2,2 0 0,0 19,13Z";
    in property <string> weather-condition: "Cloudy";
    in property <string> temperature: "13.7°C";
    in property <string> temperature-high: "15°";
    in property <string> temperature-low: "8°";
    in property <[TimerRow]> timers: [{ name: "Pasta", left: "07:42" }];
    in property <[MessageRow]> messages: [{ title: "Washing machine", text: "Done: time to hang out the laundry" }];
    in property <string> heard: "";
    in property <string> answer: "Done: the living room blind is up. It is 14 degrees outside and cloudy.";
    // Bar heights 0..1, left to right (72 bars).
    in property <[float]> wave: [0.05, 0.1, 0.2, 0.35, 0.5, 0.35, 0.2, 0.1, 0.05];

    callback screenshot-requested();
    // The state changed (keys, buttons or Rust): Rust sets the matching pose.
    callback state-changed(string);
    callback talk-clicked();
    // A tap on the character (wakes the screen; on the device any touch does).
    callback character-touched();
    // The Home Assistant button: opens its dashboard (M6).
    callback home-assistant-clicked();
    callback stop-clicked();
    callback message-ok(int);
    callback language-chosen(string);
    callback suspend-confirmed();
    // The volume (percent) and whether its bar is on screen (Rust hides it after 2 s).
    in property <int> volume: 40;
    in property <bool> volume-shown: false;
    // Keys + and - in the simulator: the volume keys (+1 up, -1 down).
    callback volume-key(int);
    // Key N in the simulator: hide or show the sample notifications.
    callback notifications-toggled();

    // Slint pre-renders only ASCII and the characters found in this file's
    // strings; text set from Rust (phrases, dates, names) may use any character
    // of characters/README.md ("Text"), so they are listed here (public, so
    // the compiler keeps the unused property).
    out property <string> glyphs: "\u{a0}¡¢£¤¥¦§¨©ª«¬®¯°±²³´µ¶·¸¹º»¼½¾¿ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ×ØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿ…–—•";
    property <color> state-color: state == "listening" ? color-listening
        : state == "thinking" ? color-thinking
        : state == "speaking" ? color-speaking
        : color-error;
    changed state => {
        root.settings-open = false;
        root.suspend-confirm-open = false;
        root.state-changed(root.state);
    }
    // Right column: 720 px wide, 48 px from the right edge.
    property <length> x0: 512px;
    property <length> x1: 1232px;
    property <length> cx: (self.x0 + self.x1) / 2;
    // Where the character's pose is drawn (Rust reads it to place the mouth).
    out property <length> character-cx: self.x0 / 2;
    out property <length> character-top: 30px;
    out property <length> character-height: 740px;
    // Action bar: the only place for buttons, at the bottom of the column.
    property <length> bar-y: 640px;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == "s" || event.text == "S") {
                root.screenshot-requested();
                return accept;
            }
            if (event.text == "1") { root.state = "home"; return accept; }
            if (event.text == "2") { root.state = "listening"; return accept; }
            if (event.text == "3") { root.state = "thinking"; return accept; }
            if (event.text == "4") { root.state = "speaking"; return accept; }
            if (event.text == "5") { root.state = "error"; return accept; }
            if (event.text == "n" || event.text == "N") { root.notifications-toggled(); return accept; }
            if (event.text == "+" || event.text == "=") { root.volume-key(1); return accept; }
            if (event.text == "-") { root.volume-key(-1); return accept; }
            reject
        }
    }
    init => {
        keys.focus();
    }

    // The character: centred in the area left of the column, 740 px tall.
    Image {
        x: root.character-cx - self.width / 2;
        y: root.character-top;
        height: root.character-height;
        width: root.pose.height > 0 ? self.height * root.pose.width / root.pose.height : 0px;
        source: root.pose;
        image-fit: fill;
        visible: root.frame.width == 0;
    }
    Image {
        x: root.frame-x;
        y: root.frame-y;
        width: root.frame-width;
        height: root.frame-height;
        source: root.frame;
        image-fit: fill;
        visible: root.frame.width > 0;
    }
    TouchArea {
        width: root.x0;
        height: root.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.character-touched();
            }
        }
    }

    if state == "home": TouchArea {
        x: root.mouth-x;
        y: root.mouth-y;
        width: root.mouth-width;
        height: root.mouth-height;
        double-clicked => {
            root.settings-open = true;
        }
    }

    if state == "home": Rectangle {
        // Clock, centred in the column like the buttons; under it one info line:
        // the date, then the weather as a small piece of information.
        Text {
            x: root.cx - self.width / 2;
            y: 46px;
            width: self.preferred-width;
            text: root.clock;
            font-size: 96px;
            font-weight: 300;
            color: Theme.text;
        }
        HorizontalLayout {
            x: root.cx - self.width / 2;
            y: 160px;
            width: self.preferred-width;
            height: 40px;
            spacing: 14px;
            Text {
                text: root.date;
                font-size: 26px;
                font-weight: 500;
                letter-spacing: 2.5px;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
            if root.weather-shown: Text {
                text: "•";
                font-size: 26px;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
            if root.weather-shown: WeatherBox {
                icon: root.weather-icon;
                condition: root.weather-condition;
                temperature: root.temperature;
                high: root.temperature-high;
                low: root.temperature-low;
                text-color: Theme.text-dim;
            }
        }

        // No notifications: the character's invitation, centred in their space.
        if root.timers.length == 0 && root.messages.length == 0: Text {
            x: root.x0;
            y: 230px;
            width: root.x1 - root.x0;
            height: root.bar-y - self.y;
            text: root.phrase-idle;
            font-size: 34px;
            color: Theme.text-dim;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // Notifications: running timers, then short messages with "OK".
        VerticalLayout {
            x: root.x0;
            y: 230px;
            width: root.x1 - root.x0;
            height: root.bar-y - self.y - 16px;
            alignment: start;
            spacing: 12px;
            for t in root.timers: Rectangle {
                height: 72px;
                border-radius: 22px;
                background: Theme.card;
                Icon {
                    x: 24px;
                    y: 16px;
                    width: 40px;
                    height: 40px;
                    commands: "M12,20A7,7 0 0,1 5,13A7,7 0 0,1 12,6A7,7 0 0,1 19,13A7,7 0 0,1 12,20M19.03,7.39L20.45,5.97C20,5.46 19.55,5 19.04,4.56L17.62,6C16.07,4.74 14.12,4 12,4A9,9 0 0,0 3,13A9,9 0 0,0 12,22C17,22 21,17.97 21,13C21,10.88 20.26,8.93 19.03,7.39M11,14H13V8H11M15,1H9V3H15V1Z";
                    color: Theme.accent;
                }
                Text {
                    x: 80px;
                    width: parent.width - 300px;
                    height: parent.height;
                    text: t.name;
                    font-size: 32px;
                    font-weight: 500;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    x: parent.width - 26px - self.width;
                    width: self.preferred-width;
                    height: parent.height;
                    text: t.left;
                    font-size: 46px;
                    font-weight: 300;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            for m[i] in root.messages: Rectangle {
                height: 100px;
                border-radius: 22px;
                background: Theme.card;
                Icon {
                    x: 24px;
                    y: 30px;
                    width: 40px;
                    height: 40px;
                    commands: "M10 21H14C14 22.1 13.1 23 12 23S10 22.1 10 21M21 19V20H3V19L5 17V11C5 7.9 7 5.2 10 4.3V4C10 2.9 10.9 2 12 2S14 2.9 14 4V4.3C17 5.2 19 7.9 19 11V17L21 19M17 11C17 8.2 14.8 6 12 6S7 8.2 7 11V18H17V11Z";
                    color: Theme.text-dim;
                }
                Text {
                    x: 80px;
                    y: 12px;
                    width: parent.width - 80px - 140px;
                    text: m.title;
                    font-size: 30px;
                    font-weight: 500;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    x: 80px;
                    y: 50px;
                    width: parent.width - 80px - 140px;
                    text: m.text;
                    font-size: 28px;
                    color: Theme.text-dim;
                    overflow: elide;
                }
                Pill {
                    x: parent.width - 20px - self.width;
                    y: 22px;
                    width: 104px;
                    height: 56px;
                    label: root.label-ok;
                    clicked => {
                        root.message-ok(i);
                    }
                }
            }
        }
    }

    if state != "home": Rectangle {
        // Sound wave: 72 bars between x 555 and 1175, centred on y 300.
        for v[i] in root.wave: Rectangle {
            x: root.cx - 310px + i * (620px / root.wave.length) + (620px / root.wave.length - self.width) / 2;
            y: 300px - self.height / 2;
            width: 4px;
            height: 6px + v * 140px;
            background: root.character-background.mix(root.state-color, 1 - (0.4 + 0.6 * min(1, v * 1.5)));
        }

        VerticalLayout {
            x: root.cx - 360px;
            y: 420px;
            width: 720px;
            height: root.bar-y - 16px - self.y;
            alignment: start;
            spacing: 16px;
            if root.state != "speaking": Text {
                text: root.state == "listening" ? root.phrase-listening
                    : root.state == "thinking" ? root.phrase-thinking
                    : root.phrase-error;
                font-size: 58px;
                font-weight: 600;
                color: root.state-color.mix(white, 0.7);
                horizontal-alignment: center;
            }
            if root.state == "speaking" || (root.state == "thinking" && root.heard != ""): Text {
                text: root.state == "speaking" ? root.answer : root.label-you-said + " " + root.heard;
                font-size: 42px;
                color: Theme.answer;
                horizontal-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }

    // Action bar: every button of every screen lives here, same place and same
    // size, centred under the column (home: Home Assistant, Talk, Settings; conversation:
    // Stop).
    HorizontalLayout {
        x: root.x0;
        y: root.bar-y;
        width: root.x1 - root.x0;
        height: 138px;
        alignment: center;
        spacing: 88px;  // room for labels wider than the circle ("Home Assistant")
        if root.state == "home": RoundButton {
            label: root.label-home-assistant;
            icon: "M21.8,13H20V21H13V17.67L15.79,14.88L16.5,15C17.66,15 18.6,14.06 18.6,12.9C18.6,11.74 17.66,10.8 16.5,10.8A2.1,2.1 0 0,0 14.4,12.9L14.5,13.61L13,15.13V9.65C13.66,9.29 14.1,8.6 14.1,7.8A2.1,2.1 0 0,0 12,5.7A2.1,2.1 0 0,0 9.9,7.8C9.9,8.6 10.34,9.29 11,9.65V15.13L9.5,13.61L9.6,12.9A2.1,2.1 0 0,0 7.5,10.8A2.1,2.1 0 0,0 5.4,12.9A2.1,2.1 0 0,0 7.5,15L8.21,14.88L11,17.67V21H4V13H2.25C1.83,13 1.42,13 1.42,12.79C1.43,12.57 1.85,12.15 2.28,11.72L11,3C11.33,2.67 11.67,2.33 12,2.33C12.33,2.33 12.67,2.67 13,3L17,7V6H19V9L21.78,11.78C22.18,12.18 22.59,12.59 22.6,12.8C22.6,13 22.2,13 21.8,13M7.5,12A0.9,0.9 0 0,1 8.4,12.9A0.9,0.9 0 0,1 7.5,13.8A0.9,0.9 0 0,1 6.6,12.9A0.9,0.9 0 0,1 7.5,12M16.5,12C17,12 17.4,12.4 17.4,12.9C17.4,13.4 17,13.8 16.5,13.8A0.9,0.9 0 0,1 15.6,12.9A0.9,0.9 0 0,1 16.5,12M12,6.9C12.5,6.9 12.9,7.3 12.9,7.8C12.9,8.3 12.5,8.7 12,8.7C11.5,8.7 11.1,8.3 11.1,7.8C11.1,7.3 11.5,6.9 12,6.9Z";
            clicked => {
                root.home-assistant-clicked();
            }
        }
        if root.state == "home": RoundButton {
            label: root.label-talk;
            icon: "M17.3,11C17.3,14 14.76,16.1 12,16.1C9.24,16.1 6.7,14 6.7,11H5C5,14.41 7.72,17.23 11,17.72V21H13V17.72C16.28,17.23 19,14.41 19,11M10.8,4.9C10.8,4.24 11.34,3.7 12,3.7C12.66,3.7 13.2,4.24 13.2,4.9L13.19,11.1C13.19,11.76 12.66,12.3 12,12.3C11.34,12.3 10.8,11.76 10.8,11.1M12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 12,2A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14Z";
            tint: Theme.accent;
            clicked => {
                root.talk-clicked();
            }
        }
        if root.state == "home": RoundButton {
            label: root.label-settings;
            icon: "M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.54,21.82 9.5,21.58L9.13,18.93C8.5,18.68 7.96,18.34 7.44,17.94L4.95,18.95C4.73,19.03 4.46,18.95 4.34,18.73L2.34,15.27C2.21,15.05 2.27,14.78 2.46,14.63L4.57,12.97L4.5,12L4.57,11L2.46,9.37C2.27,9.22 2.21,8.95 2.34,8.73L4.34,5.27C4.46,5.05 4.73,4.96 4.95,5.05L7.44,6.05C7.96,5.66 8.5,5.32 9.13,5.07L9.5,2.42C9.54,2.18 9.75,2 10,2H14C14.25,2 14.46,2.18 14.5,2.42L14.87,5.07C15.5,5.32 16.04,5.66 16.56,6.05L19.05,5.05C19.27,4.96 19.54,5.05 19.66,5.27L21.66,8.73C21.79,8.95 21.73,9.22 21.54,9.37L19.43,11L19.5,12L19.43,13L21.54,14.63C21.73,14.78 21.79,15.05 21.66,15.27L19.66,18.73C19.54,18.95 19.27,19.04 19.05,18.95L16.56,17.95C16.04,18.34 15.5,18.68 14.87,18.93L14.5,21.58C14.46,21.82 14.25,22 14,22H10M11.25,4L10.88,6.61C9.68,6.86 8.62,7.5 7.85,8.39L5.44,7.35L4.69,8.65L6.8,10.2C6.4,11.37 6.4,12.64 6.8,13.8L4.68,15.36L5.43,16.66L7.86,15.62C8.63,16.5 9.68,17.14 10.87,17.38L11.24,20H12.76L13.13,17.39C14.32,17.14 15.37,16.5 16.14,15.62L18.57,16.66L19.32,15.36L17.2,13.81C17.6,12.64 17.6,11.37 17.2,10.2L19.31,8.65L18.56,7.35L16.15,8.39C15.38,7.5 14.32,6.86 13.12,6.62L12.75,4H11.25Z";
            clicked => {
                root.settings-open = true;
            }
        }
        if root.state != "home" && root.state != "error": RoundButton {
            label: root.label-stop;
            square: true;
            tint: root.state-color;
            clicked => {
                root.stop-clicked();
            }
        }
    }

    // Settings panel: slides in from the right over a dimmed screen; a tap
    // outside closes it. One section for now: the language.
    if root.settings-open: Rectangle {
        background: #000000.with-alpha(0.45);
        TouchArea {
            clicked => {
                root.settings-open = false;
            }
        }
    }
    Rectangle {
        x: root.settings-open ? root.width - self.width : root.width;
        width: 420px;
        height: root.height;
        background: Theme.card;
        animate x {
            duration: 180ms;
            easing: ease-out;
        }
        TouchArea { }  // taps on the panel do not reach the screen below
        VerticalLayout {
            padding: 32px;
            padding-top: 48px;
            spacing: 12px;
            alignment: start;
            Text {
                text: root.label-settings;
                font-size: 34px;
                font-weight: 500;
                color: Theme.text;
                height: 64px;
            }
            Text {
                text: root.label-language;
                font-size: 24px;
                font-weight: 500;
                letter-spacing: 2.5px;
                color: Theme.text-dim;
                height: 56px;
            }
            for l in root.languages: Rectangle {
                height: 84px;
                border-radius: 22px;
                background: row.pressed ? Theme.pill-border : l.selected ? Theme.pill : transparent;
                border-color: l.selected ? Theme.pill-border : transparent;
                border-width: 2px;
                Text {
                    x: 28px;
                    height: parent.height;
                    text: l.name;
                    font-size: 32px;
                    font-weight: 500;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                if l.selected: Icon {
                    x: parent.width - 28px - self.width;
                    y: (parent.height - self.height) / 2;
                    width: 36px;
                    height: 36px;
                    commands: "M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z";
                    color: Theme.accent;
                }
                row := TouchArea {
                    clicked => {
                        root.language-chosen(l.code);
                        root.settings-open = false;
                    }
                }
            }
            Rectangle {
                height: 24px;
            }
            Rectangle {
                height: 84px;
                border-radius: 22px;
                background: suspend-row.pressed ? Theme.pill-border : transparent;
                Icon {
                    x: 28px;
                    y: (parent.height - self.height) / 2;
                    width: 36px;
                    height: 36px;
                    // A crescent moon.
                    commands: "M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95Z";
                    color: Theme.text-dim;
                }
                Text {
                    x: 84px;
                    height: parent.height;
                    text: root.label-suspend;
                    font-size: 32px;
                    font-weight: 500;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                suspend-row := TouchArea {
                    clicked => {
                        root.settings-open = false;
                        root.suspend-confirm-open = true;
                    }
                }
            }
        }
    }

    // Settings → Suspend: the question first.
    if root.suspend-confirm-open: Rectangle {
        background: #000000.with-alpha(0.6);
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 760px;
            height: 320px;
            border-radius: 28px;
            background: Theme.card;
            border-color: Theme.pill-border;
            border-width: 2px;
            VerticalLayout {
                padding: 40px;
                spacing: 28px;
                Text {
                    text: root.label-suspend-question;
                    font-size: 30px;
                    color: Theme.text;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 24px;
                    alignment: center;
                    Rectangle {
                        width: 260px;
                        height: 72px;
                        border-radius: 36px;
                        background: cancel-touch.pressed ? Theme.pill-border : Theme.accent.with-alpha(0.22);
                        border-color: Theme.accent;
                        border-width: 2px;
                        Text {
                            text: root.label-cancel;
                            font-size: 28px;
                            font-weight: 500;
                            color: Theme.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cancel-touch := TouchArea {
                            clicked => {
                                root.suspend-confirm-open = false;
                            }
                        }
                    }
                    Rectangle {
                        width: 260px;
                        height: 72px;
                        border-radius: 36px;
                        background: ok-touch.pressed ? Theme.pill-border : transparent;
                        border-color: white.with-alpha(0.6);
                        border-width: 2px;
                        Text {
                            text: root.label-suspend;
                            font-size: 28px;
                            font-weight: 500;
                            color: Theme.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ok-touch := TouchArea {
                            clicked => {
                                root.suspend-confirm-open = false;
                                root.suspend-confirmed();
                            }
                        }
                    }
                }
            }
        }
    }

    // Home Assistant's own frontend, full screen over everything else (casa.slint).
    CasaScreen {
        width: root.width;
        height: root.height;
    }

    // The volume bar, over everything (Casa included), at the bottom of the screen.
    if root.volume-shown: VolumeBar {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 32px;
        level: root.volume;
    }
}
