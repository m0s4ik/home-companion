// The body's building blocks: icons, the three kinds of action (bare, primary, pill), the context
// cards, the page header, tiles, grouped rows, timer and alarm rows, chat lines, dialogs, the
// volume HUD. Flat fills and 1-2 px strokes only: no shadows, no blur, no gradients over content.
// Icons are SVG images (drawn at their exact size), never vector paths.
// Every touch target is at least 64 x 64.

import { Theme, Grid, Type } from "tokens.slint";
import { Icons } from "icons.slint";

// An icon: an SVG from icons.slint drawn at exactly its size (the size is in its name), tinted.
// Keep x and y whole pixels: the picture is rasterized once and drawn 1:1.
// A soft tick under the finger: every control here calls it when it is pressed (Rust plays the
// character's `tap` sound; Home Assistant's own page does not go through these).
export global Feedback {
    callback tap();
    // The back of a page: Rust plays the home sound when it lands on the home, else the tap.
    callback back();
}

export component Icon inherits Image {
    in property <color> color: Theme.text;
    colorize: root.color;
    image-fit: fill;
}

// A bare action of the action band: the icon alone, no ring, the label under it. The box is the
// same as PrimaryButton's so the three slots line up; the whole 160 x 136 box is the target.
export component BareButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    // It leaves the page (Later, Close): the home sound when it lands on the home, as a page's
    // back does, instead of the tap.
    in property <bool> leaves: false;
    callback clicked();
    width: Grid.slot-width;
    height: Grid.slot-height;
    // Pressed: a soft disc behind the icon, no animation.
    Rectangle {
        x: 36px;
        y: 4px;
        width: 88px;
        height: 88px;
        border-radius: 44px;
        background: touch.pressed ? Theme.surface-2 : transparent;
    }
    Icon {
        x: 56px;
        y: 24px;
        width: 48px;
        height: 48px;
        source: root.icon;
        color: !root.enabled ? Theme.text-2.with-alpha(0.35) : touch.pressed ? Theme.text : Theme.text-2;
    }
    if root.label != "": Text {
        x: -20px;
        y: 104px;
        width: parent.width + 40px;
        text: root.label;
        font-size: 24px;
        font-weight: 500;
        color: root.enabled ? Theme.text-2 : Theme.text-2.with-alpha(0.35);
        horizontal-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if root.leaves {
                Feedback.back();
            } else {
                Feedback.tap();
            }
            root.clicked();
        }
    }
}

// The primary action, in the middle slot: a 96 px disc, gold ring on deep brown, the label under
// it. `stop` draws the stop square instead of an icon; `tint` and `fill` let "Ferma" take the
// character's state colour during a conversation.
export component PrimaryButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> stop: false;
    // Working (Home Assistant's setup): the icon turns until it is done.
    in property <bool> spinning: false;
    // Off: dimmed, taps ignored (a run of the setup in progress).
    in property <bool> enabled: true;
    in property <color> tint: Theme.accent;
    in property <color> fill: Theme.accent-deep;
    callback clicked();
    width: Grid.slot-width;
    height: Grid.slot-height;
    opacity: root.enabled ? 1.0 : 0.55;
    Rectangle {
        x: 32px;
        y: 0;
        width: Grid.primary-size;
        height: Grid.primary-size;
        border-radius: self.width / 2;
        background: touch.pressed ? root.fill.brighter(0.5) : root.fill;
        border-width: 2px;
        border-color: root.tint.with-alpha(0.9);
        animate border-color { duration: 160ms; }
        if !root.stop: Icon {
            x: 26px;
            y: 26px;
            width: 44px;
            height: 44px;
            source: root.icon;
            // White on the gold ring, like the home button over Home Assistant's view (Andrea,
            // 2026-11-06).
            color: Theme.text;
            rotation-angle: root.spinning ? mod(animation-tick() / 1ms, 1200) / 1200 * 360deg : 0deg;
        }
        if root.stop: Rectangle {
            x: 34px;
            y: 34px;
            width: 28px;
            height: 28px;
            border-radius: 5px;
            background: Theme.text;
        }
    }
    if root.label != "": Text {
        x: -20px;
        y: 104px;
        width: parent.width + 40px;
        text: root.label;
        font-size: 24px;
        font-weight: 500;
        color: Theme.text;
        horizontal-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            Feedback.tap();
            root.clicked();
        }
    }
}

// A pill: an action inside a card or a dialog ("OK", "Annulla", "Apri"): 64 px tall (the touch
// minimum), a thin ivory ring; `primary` fills it gold (dialogs only, where no gold disc is shown).
export component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled-touch: true;
    callback clicked();
    height: 64px;
    border-radius: self.height / 2;
    background: root.primary ? (touch.pressed ? Theme.accent.darker(0.15) : Theme.accent)
        : (touch.pressed ? Theme.surface-2 : transparent);
    border-width: root.primary ? 0 : 2px;
    border-color: Theme.text.with-alpha(0.28);
    Text {
        text: root.label;
        font-size: 24px;
        font-weight: 500;
        color: root.primary ? Theme.on-accent : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled-touch;
        clicked => {
            Feedback.tap();
            root.clicked();
        }
    }
}

// A round icon button inside a card or a row (play/pause): 56 px ring, 64 px target, 28 px icon.
export component RingButton inherits Rectangle {
    in property <image> icon;
    callback clicked();
    width: 64px;
    height: 64px;
    Rectangle {
        x: 4px;
        y: 4px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: touch.pressed ? Theme.surface-2 : transparent;
        border-width: 2px;
        border-color: Theme.text.with-alpha(0.28);
        Icon {
            x: 14px;
            y: 14px;
            width: 28px;
            height: 28px;
            source: root.icon;
            color: Theme.text;
        }
    }
    touch := TouchArea {
        clicked => {
            Feedback.tap();
            root.clicked();
        }
    }
}

// A bare 36 px icon inside a card or a row (next track, cancel a timer): 64 px target.
export component GlyphButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color: Theme.text-2;
    callback clicked();
    width: 64px;
    height: 64px;
    Rectangle {
        x: 4px;
        y: 4px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: touch.pressed ? Theme.surface-2 : transparent;
    }
    Icon {
        x: 14px;
        y: 14px;
        width: 36px;
        height: 36px;
        source: root.icon;
        color: touch.pressed ? Theme.text : root.icon-color;
    }
    touch := TouchArea {
        clicked => {
            Feedback.tap();
            root.clicked();
        }
    }
}

// An on/off switch: the 72 x 40 track (gold when on) in a 96 x 64 target.
export component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);
    width: 96px;
    height: 64px;
    Rectangle {
        x: 12px;
        y: 12px;
        width: 72px;
        height: 40px;
        border-radius: 20px;
        background: root.on ? Theme.accent : Theme.line;
        Rectangle {
            x: root.on ? 36px : 4px;
            y: 4px;
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: root.on ? Theme.text : Theme.text-3;
            animate x {
                duration: 120ms;
                easing: ease-out;
            }
        }
    }
    TouchArea {
        clicked => {
            Feedback.tap();
            root.toggled(!root.on);
        }
    }
}

// The ring of a running timer: it empties clockwise from 12 o'clock (one short path, redrawn
// once a second), the timer glyph inside. 48 px.
export component TimerRing inherits Rectangle {
    in property <float> remaining: 0.77;
    in property <bool> paused: false;
    width: 48px;
    height: 48px;
    Rectangle {
        border-radius: 24px;
        border-width: 3px;
        border-color: Theme.line;
    }
    if root.remaining > 0.001: Path {
        viewbox-width: 48;
        viewbox-height: 48;
        fill: transparent;
        stroke: root.paused ? Theme.text-3 : Theme.accent;
        stroke-width: 3px;
        commands: "M 24 1.5 A 22.5 22.5 0 " + (root.remaining > 0.5 ? "1" : "0") + " 1 "
            + (24 + 22.5 * sin(360deg * min(root.remaining, 0.999))) + " "
            + (24 - 22.5 * cos(360deg * min(root.remaining, 0.999)));
    }
    Icon {
        x: 12px;
        y: 12px;
        width: 24px;
        height: 24px;
        source: root.paused ? Icons.pause-24 : Icons.timer-24;
        color: root.paused ? Theme.text-2 : Theme.accent;
    }
}

// --- Context cards: 672 x 88, only while something is alive. A tap on the card opens what it
// belongs to (the music, the timers, the message); actions on the item are inside it.

export component Card inherits Rectangle {
    callback tapped();
    width: Grid.col-width;
    height: Grid.card-height;
    border-radius: Grid.card-radius;
    background: card-touch.pressed ? Theme.surface-2 : Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    card-touch := TouchArea {
        clicked => {
            Feedback.tap();
            root.tapped();
        }
    }
}

// The title and the second line of a card, from x 92 (after the 64 px leading slot). The caller
// sets x, width and height.
export component CardText inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    Text {
        y: root.detail == "" ? (parent.height - self.height) / 2 : 10px;
        width: parent.width;
        text: root.title;
        font-size: 28px;
        color: Theme.text;
        overflow: elide;
    }
    if root.detail != "": Text {
        y: 48px;
        width: parent.width;
        text: root.detail;
        font-size: 24px;
        color: Theme.text-2;
        overflow: elide;
    }
}

// A card with an icon and two lines: a message, the body's status, "+2 timer", the last answer.
// `action` adds a pill at the right (OK on a message).
export component InfoCard inherits Card {
    in property <image> icon;
    in property <color> icon-color: Theme.accent;
    in property <string> title;
    in property <string> text;
    in property <string> action;
    // A cross on the right that ends what the card shows (the screen mirroring).
    in property <bool> closable: false;
    callback action-clicked();
    callback close-clicked();
    // The pill as wide as its word plus 24 px each side ("Annulla" no tighter than "OK"), 112 at
    // least; measured by a hidden twin of its label.
    action-measure := Text {
        visible: false;
        text: root.action;
        font-size: 24px;
        font-weight: 500;
    }
    property <length> action-w: max(112px, action-measure.preferred-width + 48px);
    Icon {
        x: 28px;
        y: 28px;
        width: 32px;
        height: 32px;
        source: root.icon;
        color: root.icon-color;
    }
    CardText {
        x: 92px;
        width: parent.width - 92px - (root.action != "" ? root.action-w + 32px : root.closable ? 84px : 28px);
        height: parent.height;
        title: root.title;
        detail: root.text;
    }
    if root.action != "": PillButton {
        x: parent.width - 12px - self.width;
        y: 12px;
        width: root.action-w;
        label: root.action;
        clicked => {
            Feedback.tap();
            root.action-clicked();
        }
    }
    if root.closable && root.action == "": GlyphButton {
        x: parent.width - 8px - 64px;
        y: (parent.height - 64px) / 2;
        icon: Icons.close-36;
        clicked => {
            root.close-clicked();
        }
    }
}

// A running timer: the ring, the name, the time left in tabular digits.
export component TimerCard inherits Card {
    in property <string> name;
    in property <string> detail;
    in property <string> left;
    in property <float> remaining: 0.77;
    in property <bool> paused: false;
    TimerRing {
        x: 20px;
        y: 20px;
        remaining: root.remaining;
        paused: root.paused;
    }
    CardText {
        x: 92px;
        width: parent.width - 92px - 200px;
        height: parent.height;
        title: root.name;
        detail: root.detail;
    }
    Text {
        x: parent.width - 28px - self.width;
        width: self.preferred-width;
        height: parent.height;
        text: root.left;
        font-family: "Inter Tnum";
        font-size: 40px;
        color: root.paused ? Theme.text-2 : Theme.text;
        vertical-alignment: center;
    }
}

// What is playing (AirPlay, Music Assistant…): the cover, title, artist and source, play/pause
// and next.
export component NowPlayingCard inherits Card {
    in property <image> cover;
    in property <string> title;
    in property <string> detail;
    in property <bool> playing: true;
    callback play-pause();
    callback next();
    Rectangle {
        x: 12px;
        y: 12px;
        width: 64px;
        height: 64px;
        border-radius: 12px;
        background: Theme.surface-2;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.cover;
            image-fit: ImageFit.cover;
        }
        // No cover art for this track: a note, never the previous track's picture.
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 32px;
            height: 32px;
            source: Icons.music-note-32;
            color: Theme.text-3;
            visible: root.cover.width == 0;
        }
    }
    CardText {
        x: 92px;
        width: parent.width - 92px - 176px;
        height: parent.height;
        title: root.title;
        detail: root.detail;
    }
    RingButton {
        x: parent.width - 168px;
        y: 12px;
        icon: root.playing ? Icons.pause-28 : Icons.play-28;
        clicked => {
            Feedback.tap();
            root.play-pause();
        }
    }
    GlyphButton {
        x: parent.width - 80px;
        y: 12px;
        icon: Icons.skip-next-36;
        clicked => {
            Feedback.tap();
            root.next();
        }
    }
}

// --- Pages on the desk ---------------------------------------------------------------------

// The top of every desk page: back (the chevron and the title are one 64 px tall target), the
// time small at the right.
// What the device knows of its own state, for every page (set from Rust).
export global Status {
    // Wi-Fi signal: 0 not connected, 1..4 bars (-1: not known, nothing shown).
    in-out property <int> wifi-level: -1;
    // The Wi-Fi icon for that level at 28 or 32 px (pages and the control center agree).
    pure public function wifi-icon(level: int, big: bool) -> image {
        if (big) {
            return level <= 0 ? Icons.wifi-strength-off-outline-32
                : level == 1 ? Icons.wifi-strength-1-32
                : level == 2 ? Icons.wifi-strength-2-32
                : level == 3 ? Icons.wifi-strength-3-32 : Icons.wifi-strength-4-32;
        }
        return level <= 0 ? Icons.wifi-strength-off-outline-28
            : level == 1 ? Icons.wifi-strength-1-28
            : level == 2 ? Icons.wifi-strength-2-28
            : level == 3 ? Icons.wifi-strength-3-28 : Icons.wifi-strength-4-28;
    }
}

export component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> clock;
    in property <bool> back-shown: true;
    callback back();
    width: Grid.col-width;
    height: 64px;
    if root.back-shown: Rectangle {
        x: -16px;
        width: 64px;
        height: 64px;
        border-radius: 32px;
        background: back-touch.pressed ? Theme.surface-2 : transparent;
    }
    if root.back-shown: Icon {
        x: -8px;
        y: 12px;
        width: 40px;
        height: 40px;
        source: Icons.chevron-left-40;
        color: Theme.text;
    }
    title-text := Text {
        x: root.back-shown ? 48px : 0;
        height: 64px;
        text: root.title;
        font-size: 34px;
        color: Theme.text;
        vertical-alignment: center;
    }
    back-touch := TouchArea {
        x: -16px;
        width: 80px + title-text.preferred-width;
        height: 64px;
        enabled: root.back-shown;
        clicked => {
            Feedback.back();
            root.back();
        }
    }
    // The Wi-Fi signal, left of the clock.
    if Status.wifi-level >= 0 && root.clock != "": Icon {
        x: clock-text.x - 12px - self.width;
        y: 18px;
        width: 28px;
        height: 28px;
        source: Status.wifi-icon(Status.wifi-level, false);
        color: Status.wifi-level == 0 ? Theme.danger : Theme.text-2;
    }
    clock-text := Text {
        x: parent.width - self.width;
        width: self.preferred-width;
        height: 64px;
        text: root.clock;
        font-family: "Inter Tnum";
        font-size: 28px;
        color: Theme.text-2;
        vertical-alignment: center;
    }
}

// The music bar: where the sound comes from, and back / play-pause / next, on one pill (the
// mirrored screen's bottom bar and the music page's, so they look the same).
export component MusicBar inherits Rectangle {
    in property <string> source;
    // A title and a second line in place of the source (the music page may show them here).
    in property <string> title;
    in property <string> detail;
    in property <bool> paused;
    callback poked();
    callback previous();
    callback toggle();
    callback next();
    width: 760px;
    height: 88px;
    border-radius: 44px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    TouchArea {
        clicked => {
            root.poked();
        }
    }
    Icon {
        x: 24px;
        y: 30px;
        width: 28px;
        height: 28px;
        source: Icons.cast-connected-28;
        color: Theme.accent;
    }
    if root.title == "": Text {
        x: 64px;
        width: parent.width - 64px - 248px;
        height: parent.height;
        text: root.source;
        font-size: 24px;
        color: Theme.text-2;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.title != "": Text {
        x: 64px;
        y: 14px;
        width: parent.width - 64px - 248px;
        text: root.title;
        font-size: 26px;
        color: Theme.text;
        overflow: elide;
    }
    if root.title != "": Text {
        x: 64px;
        y: 48px;
        width: parent.width - 64px - 248px;
        text: root.detail;
        font-size: 20px;
        color: Theme.text-2;
        overflow: elide;
    }
    GlyphButton {
        x: parent.width - 236px;
        y: 12px;
        icon: Icons.skip-previous-36;
        clicked => {
            root.previous();
        }
    }
    Rectangle {
        x: parent.width - 164px;
        y: 8px;
        width: 72px;
        height: 72px;
        border-radius: 36px;
        background: play-touch.pressed ? Theme.accent-deep.brighter(0.5) : Theme.accent-deep;
        border-width: 2px;
        border-color: Theme.accent.with-alpha(0.9);
        Icon {
            x: 22px;
            y: 22px;
            width: 28px;
            height: 28px;
            source: root.paused ? Icons.play-28 : Icons.pause-28;
            color: Theme.text;
        }
        play-touch := TouchArea {
            clicked => {
                Feedback.tap();
                root.toggle();
            }
        }
    }
    GlyphButton {
        x: parent.width - 80px;
        y: 12px;
        icon: Icons.skip-next-36;
        clicked => {
            root.next();
        }
    }
}

// The time now, small at the top right with the Wi-Fi signal, as on the pages' header: for the
// screens without a clock of their own (the conversation, a ringing timer, a due reminder, the
// link and first-start pages). Right-aligned in its own width.
export component CornerClock inherits Rectangle {
    in property <string> clock;
    width: 240px;
    height: 64px;
    if Status.wifi-level >= 0 && root.clock != "": Icon {
        x: corner-text.x - 12px - self.width;
        y: 18px;
        width: 28px;
        height: 28px;
        source: Status.wifi-icon(Status.wifi-level, false);
        color: Status.wifi-level == 0 ? Theme.danger : Theme.text-2;
    }
    corner-text := Text {
        x: parent.width - self.width;
        width: self.preferred-width;
        height: 64px;
        text: root.clock;
        font-family: "Inter Tnum";
        font-size: 28px;
        color: Theme.text-2;
        vertical-alignment: center;
    }
}

// A destination of "Altro": icon, name and what is going on there right now.
export component Tile inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> status;
    // Five or six tiles: 148 px tall, the icon on the left of the words.
    in property <bool> compact: false;
    // Seven or eight: 112 px tall (four rows), otherwise as compact.
    in property <bool> dense: false;
    callback clicked();
    width: 324px;
    height: root.dense ? 112px : root.compact ? 148px : 196px;
    border-radius: Grid.tile-radius;
    background: touch.pressed ? Theme.surface-2 : Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    Icon {
        x: root.compact ? 24px : 28px;
        y: root.dense ? 32px : root.compact ? 50px : 28px;
        width: 48px;
        height: 48px;
        source: root.icon;
        color: Theme.accent;
    }
    Text {
        x: root.compact ? 88px : 28px;
        y: root.dense ? 20px : root.compact ? 38px : 100px;
        width: parent.width - self.x - 28px;
        text: root.label;
        font-size: root.compact ? 24px : 28px;
        color: Theme.text;
        overflow: elide;
    }
    Text {
        x: root.compact ? 88px : 28px;
        y: root.dense ? 58px : root.compact ? 76px : 142px;
        width: parent.width - self.x - 28px;
        text: root.status;
        font-size: root.compact ? 20px : 24px;
        color: Theme.text-2;
        overflow: elide;
    }
    touch := TouchArea {
        clicked => {
            Feedback.tap();
            root.clicked();
        }
    }
}

// A section title above a group of rows.
// The bottom of a list that scrolls on: its last 48 px fade into the page while there is more
// below, so the cut line reads as "more" and not as a broken row. Put it over the Flickable's end.
export component ScrollFade inherits Rectangle {
    in property <bool> more;
    height: 48px;
    background: @linear-gradient(180deg, Theme.bg.with-alpha(0) 0%, Theme.bg 100%);
    visible: root.more;
}

export component SectionTitle inherits Text {
    height: 40px;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 1.5px;
    color: Theme.text-3;
    vertical-alignment: center;
}

// A group of rows: one rounded surface.
export component Group inherits Rectangle {
    border-radius: Grid.card-radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
}

// A hairline between rows of a group, from x 72 (after the icon column).
export component Separator inherits Rectangle {
    x: 72px;
    height: 1px;
    background: Theme.line;
}

// One row of a grouped list (settings): icon, label, value, then a chevron (it opens a page), a
// check (it is the chosen one) or a switch; 76 px.
export component Row inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> value;
    in property <bool> first: false;
    // "page" (chevron), "check", "toggle", "busy" (a turning sign where the toggle goes, while
    // what it switches is under way) or "" (information only).
    in property <string> kind: "page";
    in property <bool> on: false;
    callback clicked();
    callback toggled(bool);
    height: 76px;
    background: touch.pressed && root.kind != "" && root.kind != "toggle" ? Theme.surface-2 : transparent;
    if !root.first: Separator {
        y: 0;
        width: parent.width - 72px;
    }
    if root.icon.width > 0: Icon {
        x: 24px;
        y: 24px;
        width: 28px;
        height: 28px;
        source: root.icon;
        color: Theme.text-2;
    }
    Text {
        x: root.icon.width > 0 ? 72px : 28px;
        width: parent.width - self.x - 140px;
        height: parent.height;
        text: root.label;
        font-size: 28px;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> end: root.kind == "" ? 28px : root.kind == "toggle" || root.kind == "busy" ? 116px : 64px;
    if root.value != "": Text {
        x: parent.width - root.end - self.width;
        width: min(self.preferred-width, 320px);
        height: parent.height;
        text: root.value;
        font-size: 24px;
        color: Theme.text-2;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
    }
    if root.kind == "page": Icon {
        x: parent.width - 52px;
        y: 24px;
        width: 28px;
        height: 28px;
        source: Icons.chevron-right-28;
        color: Theme.text-3;
    }
    if root.kind == "check" && root.on: Icon {
        x: parent.width - 52px;
        y: 24px;
        width: 28px;
        height: 28px;
        source: Icons.check-28;
        color: Theme.accent;
    }
    touch := TouchArea {
        enabled: root.kind == "page" || root.kind == "check";
        clicked => {
            Feedback.tap();
            root.clicked();
        }
    }
    if root.kind == "busy": Icon {
        // In the middle of where the toggle is.
        x: parent.width - 12px - 48px - 14px;
        y: 24px;
        width: 28px;
        height: 28px;
        source: Icons.sync-28;
        color: Theme.accent;
        transform-rotation: -mod(animation-tick() / 1ms, 1400) / 1400 * 360deg;
    }
    if root.kind == "toggle": Toggle {
        x: parent.width - 12px - self.width;
        y: 6px;
        on: root.on;
        toggled(v) => {
            root.toggled(v);
        }
    }
}

// A value with − and + (an hour, minutes): 64 px targets, tabular digits between them.
export component Stepper inherits Rectangle {
    in property <string> value;
    in property <length> value-width: 160px;
    in property <length> font-size: 48px;
    callback step(int);
    width: 64px + root.value-width + 64px;
    height: 64px;
    GlyphButton {
        x: 0;
        icon: Icons.minus-36;
        icon-color: Theme.text;
        clicked => {
            Feedback.tap();
            root.step(-1);
        }
    }
    Text {
        x: 64px;
        width: root.value-width;
        height: parent.height;
        text: root.value;
        font-family: "Inter Tnum";
        font-size: root.font-size;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    GlyphButton {
        x: 64px + root.value-width;
        icon: Icons.plus-36;
        icon-color: Theme.text;
        clicked => {
            Feedback.tap();
            root.step(1);
        }
    }
}

// A choice among a few (a timer's preset, a day of the week): 64 px tall, gold ring when chosen.
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> chosen: false;
    callback clicked();
    height: 64px;
    border-radius: 32px;
    background: root.chosen ? Theme.accent-deep : touch.pressed ? Theme.surface-2 : transparent;
    border-width: 2px;
    border-color: root.chosen ? Theme.accent : Theme.text.with-alpha(0.2);
    Text {
        text: root.label;
        font-size: 24px;
        font-weight: 500;
        color: root.chosen ? Theme.accent : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            Feedback.tap();
            root.clicked();
        }
    }
}

// A timer in the timers page: ring, name and when it ends, time left, pause/resume, cancel. 96 px;
// 24 px between pause and cancel (a cancel has a 5 s "Annulla" chip, no question).
export component TimerLine inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> left;
    in property <float> remaining;
    in property <bool> paused: false;
    in property <bool> first: false;
    callback pause-resume();
    callback cancel();
    height: 96px;
    if !root.first: Separator {
        y: 0;
        width: parent.width - 72px;
    }
    TimerRing {
        x: 16px;
        y: 24px;
        remaining: root.remaining;
        paused: root.paused;
    }
    Text {
        x: 84px;
        y: 12px;
        width: parent.width - 84px - 360px;
        text: root.name;
        font-size: 28px;
        color: Theme.text;
        overflow: elide;
    }
    Text {
        x: 84px;
        y: 52px;
        width: parent.width - 84px - 360px;
        text: root.detail;
        font-size: 24px;
        color: Theme.text-2;
        overflow: elide;
    }
    Text {
        x: parent.width - 184px - self.width;
        width: self.preferred-width;
        height: parent.height;
        text: root.left;
        font-family: "Inter Tnum";
        font-size: 40px;
        color: root.paused ? Theme.text-2 : Theme.text;
        vertical-alignment: center;
    }
    RingButton {
        x: parent.width - 168px;
        y: 16px;
        icon: root.paused ? Icons.play-28 : Icons.pause-28;
        clicked => {
            Feedback.tap();
            root.pause-resume();
        }
    }
    GlyphButton {
        x: parent.width - 80px;
        y: 16px;
        icon: Icons.close-36;
        clicked => {
            Feedback.tap();
            root.cancel();
        }
    }
}

// An alarm: the time large, the days, on/off, delete. 88 px.
export component AlarmLine inherits Rectangle {
    in property <string> time;
    in property <string> days;
    in property <bool> on;
    in property <bool> first: false;
    callback toggled(bool);
    callback delete();
    height: 88px;
    if !root.first: Separator {
        y: 0;
        width: parent.width - 72px;
    }
    Icon {
        x: 26px;
        y: 30px;
        width: 28px;
        height: 28px;
        source: Icons.alarm-28;
        color: root.on ? Theme.accent : Theme.text-3;
    }
    time-text := Text {
        x: 72px;
        height: parent.height;
        text: root.time;
        font-family: "Inter Tnum";
        font-size: 40px;
        color: root.on ? Theme.text : Theme.text-2;
        vertical-alignment: center;
    }
    Text {
        x: 72px + time-text.preferred-width + 24px;
        width: parent.width - self.x - 200px;
        height: parent.height;
        text: root.days;
        font-size: 24px;
        color: Theme.text-2;
        vertical-alignment: center;
        overflow: elide;
    }
    Toggle {
        x: parent.width - 192px;
        y: 12px;
        on: root.on;
        toggled(v) => {
            root.toggled(v);
        }
    }
    GlyphButton {
        x: parent.width - 80px;
        y: 12px;
        icon: Icons.close-36;
        clicked => {
            Feedback.tap();
            root.delete();
        }
    }
}

// --- Conversations ---------------------------------------------------------------------------

// What the user said: a bubble on the right (towards the user's side of the desk), as wide as
// its text (at most 512 px), as tall as its lines.
export component ChatUser inherits Rectangle {
    in property <string> text;
    property <length> max-text: 468px;
    measure := Text {
        visible: false;
        text: root.text;
        font-size: 24px;
    }
    property <length> text-width: min(root.max-text, measure.preferred-width + 1px);
    height: body.preferred-height + 28px;
    Rectangle {
        x: parent.width - root.text-width - 44px;
        width: root.text-width + 44px;
        height: parent.height;
        background: Theme.surface-2;
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        border-bottom-left-radius: 22px;
        border-bottom-right-radius: 6px;
        body := Text {
            x: 22px;
            y: 14px;
            width: root.text-width;
            text: root.text;
            font-size: 24px;
            color: Theme.text;
            wrap: word-wrap;
        }
    }
}

// What the character answered: plain text on the left (towards the character), a gold rule.
export component ChatCharacter inherits Rectangle {
    in property <string> text;
    height: body.preferred-height + 8px;
    Rectangle {
        x: 0;
        y: 4px;
        width: 3px;
        height: parent.height - 8px;
        border-radius: 1.5px;
        background: Theme.accent.with-alpha(0.7);
    }
    body := Text {
        x: 24px;
        y: 4px;
        width: parent.width - 96px;
        text: root.text;
        font-size: 24px;
        color: Theme.text;
        wrap: word-wrap;
    }
}

// A session separator: "Oggi · 14:02 · Home Assistant".
export component ChatSeparator inherits Text {
    height: 40px;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: Theme.text-3;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// --- Setup -----------------------------------------------------------------------------------

// A numbered step: the number in a thin ring (gold and filled once done), the text.
export component Step inherits Rectangle {
    in property <string> number;
    in property <string> text;
    in property <bool> done: false;
    height: 104px;
    Rectangle {
        x: 0;
        y: 0;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        border-width: 2px;
        border-color: root.done ? Theme.accent : Theme.text-3;
        background: root.done ? Theme.accent : transparent;
        Text {
            text: root.number;
            font-size: 20px;
            font-weight: 500;
            color: root.done ? Theme.on-accent : Theme.text-2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 52px;
        y: 2px;
        width: parent.width - 52px;
        text: root.text;
        font-size: 24px;
        color: Theme.text;
        wrap: word-wrap;
    }
}

// A house command went through (the brain): a check, its line, Undo when it can be undone. A
// floating card, the desk column's width, a gold hairline so it reads over a page.
export component DoneCard inherits Rectangle {
    in property <string> line;
    // "" = no Undo.
    in property <string> undo-label;
    callback undo();
    width: Grid.col-width;
    height: Grid.card-height;
    border-radius: Grid.card-radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.accent.with-alpha(0.45);
    TouchArea { }
    Icon {
        x: 28px;
        y: 28px;
        width: 32px;
        height: 32px;
        source: Icons.check-circle-32;
        color: Theme.accent;
    }
    Text {
        x: 92px;
        width: parent.width - 92px - (root.undo-label != "" ? 176px : 28px);
        height: parent.height;
        text: root.line;
        font-size: 28px;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.undo-label != "": PillButton {
        x: parent.width - 12px - self.width;
        y: 12px;
        width: 152px;
        label: root.undo-label;
        clicked => {
            root.undo();
        }
    }
}


// --- Overlays --------------------------------------------------------------------------------

// Alfred's pop-up: the one style of every dialog, question and passing card (change it here).
// A box in the middle with a gold border: an icon on top, a title, a text (gold when `text-gold`,
// the state of a thing), extra content in the children (laid out between the text and the
// buttons; the box is `box-width` wide and children's `parent` is the pop-up itself, so they use
// that width, not parent.width), then up to two large ringed buttons (`cancel` plain, `confirm`
// gold; none: a card that only tells), a close X (`closable`), the time left as a thin line
// (`left` 0..1, below 0: none). `scrim` darkens what is behind (a question that needs an answer:
// taps outside do nothing); without it a tap outside closes, like the X.
export component Dialog inherits Rectangle {
    in property <image> icon;
    // Or an MDI glyph's path data (a board tile's icon), drawn in the icon's place.
    in property <string> icon-path: "";
    in property <color> icon-color: Theme.accent;
    in property <string> title;
    in property <string> text;
    in property <bool> text-gold: false;
    in property <string> cancel;
    in property <string> confirm;
    in property <image> confirm-icon;
    in property <bool> closable: false;
    // False: the buttons ignore touches (a dialog that just appeared, so a tap meant for what
    // was there before does not answer it).
    in property <bool> touch-enabled: true;
    // Working: the icon turns (a wait with nothing to touch); `busy-bar`: a light running
    // along a line under the text, so it is clearly alive.
    in property <bool> spinning: false;
    in property <bool> busy-bar: false;
    in property <float> left: -1;
    in property <bool> scrim: true;
    in property <color> border: Theme.accent.with-alpha(0.5);
    in property <length> box-width: 672px;
    in property <length> content-height: 0px;
    // Centred on the desk (Alfred's dialogs), or on the whole screen (over Home Assistant).
    in property <length> centre-x: Grid.col-cx;
    callback answered(bool);
    callback closed();
    background: root.scrim ? Theme.scrim : transparent;
    // The question's window losing its scrim after the yes: a fade, not a jump.
    animate background { duration: 200ms; }
    TouchArea {
        clicked => {
            if (!root.scrim) {
                root.closed();
            }
        }
    }
    property <bool> buttons: root.cancel != "" || root.confirm != "";
    box := Rectangle {
        property <length> top-pad: root.icon.width > 0 || root.icon-path != "" ? 104px : 48px;
        property <length> body-y: title-text.y + title-text.preferred-height
            + (root.text != "" ? 8px + body-text.preferred-height : 0px);
        property <length> buttons-y: self.body-y + 32px + root.content-height
            + (root.content-height > 0 ? 24px : 0px);
        x: root.centre-x - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: root.box-width;
        height: self.buttons-y + (root.buttons ? 88px + 24px : 0px)
            + (root.left >= 0 || root.busy-bar ? 4px + 24px : 0px)
            + (root.buttons || root.left >= 0 || root.busy-bar ? 12px : 8px);
        border-radius: 32px;
        // 90 % opaque over its scrim: what is behind shows faintly (no blur on this device).
        // Without a scrim (the done pop-up, the microphone switch) 98 %: the text under it would
        // read through, line by line, next to the pop-up's own.
        background: Theme.surface.with-alpha(root.scrim ? 0.9 : 0.98);
        border-width: 2px;
        border-color: root.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000a0;
        TouchArea { }
        if root.closable: close-touch := TouchArea {
            x: parent.width - 12px - 72px;
            y: 12px;
            width: 72px;
            height: 72px;
            clicked => {
                Feedback.tap();
                root.closed();
            }
            Rectangle {
                x: 12px;
                y: 12px;
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: close-touch.pressed ? Theme.surface-2 : transparent;
                Icon {
                    x: 6px;
                    y: 6px;
                    width: 36px;
                    height: 36px;
                    source: Icons.close-36;
                    color: Theme.text-3;
                }
            }
        }
        if root.icon.width > 0: Icon {
            x: (parent.width - self.width) / 2;
            y: 40px;
            width: 48px;
            height: 48px;
            source: root.icon;
            color: root.icon-color;
            rotation-angle: root.spinning ? mod(animation-tick() / 1ms, 1200) / 1200 * 360deg : 0deg;
        }
        if root.icon-path != "": Path {
            x: (parent.width - self.width) / 2;
            y: 40px;
            width: 48px;
            height: 48px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.icon-path;
            fill: root.icon-color;
            stroke-width: 0;
        }
        title-text := Text {
            x: 40px;
            y: box.top-pad;
            width: parent.width - 80px;
            text: root.title;
            font-size: 34px;
            color: Theme.text;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        body-text := Text {
            x: 48px;
            y: title-text.y + title-text.preferred-height + 8px;
            width: parent.width - 96px;
            text: root.text;
            font-size: root.text-gold ? 26px : 24px;
            color: root.text-gold ? Theme.accent : Theme.text-2;
            horizontal-alignment: center;
            wrap: word-wrap;
            visible: root.text != "";
        }
        Rectangle {
            x: 0;
            y: box.body-y + 24px;
            width: parent.width;
            height: root.content-height;
            @children
        }
        // The buttons: one alone takes the width; two share it.
        property <length> btn-w: root.cancel != "" && root.confirm != ""
            ? (self.width - 96px - 16px) / 2 : self.width - 96px;
        if root.cancel != "": cancel-btn := Rectangle {
            x: 48px;
            y: box.buttons-y;
            width: box.btn-w;
            height: 88px;
            border-radius: self.height / 2;
            background: cancel-touch.pressed ? Theme.surface-2 : transparent;
            border-width: 2px;
            border-color: Theme.text.with-alpha(0.28);
            Text {
                text: root.cancel;
                font-size: 30px;
                font-weight: 500;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            cancel-touch := TouchArea {
                enabled: root.touch-enabled;
                clicked => {
                    Feedback.tap();
                    root.answered(false);
                }
            }
        }
        if root.confirm != "": confirm-btn := Rectangle {
            property <color> ink: Theme.accent;
            x: root.cancel != "" ? 48px + box.btn-w + 16px : 48px;
            y: box.buttons-y;
            width: box.btn-w;
            height: 88px;
            border-radius: self.height / 2;
            background: confirm-touch.pressed ? Theme.accent.with-alpha(0.18) : transparent;
            border-width: 2px;
            border-color: Theme.accent;
            HorizontalLayout {
                alignment: center;
                spacing: 16px;
                if root.confirm-icon.width > 0: Rectangle {
                    width: 36px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: 36px;
                        height: 36px;
                        source: root.confirm-icon;
                        color: confirm-btn.ink;
                    }
                }
                Text {
                    text: root.confirm;
                    font-size: 30px;
                    font-weight: 500;
                    color: confirm-btn.ink;
                    vertical-alignment: center;
                }
            }
            confirm-touch := TouchArea {
                enabled: root.touch-enabled;
                clicked => {
                    Feedback.tap();
                    root.answered(true);
                }
            }
        }
        // Working: a short light that runs along the line, over and over.
        if root.busy-bar: Rectangle {
            x: 48px;
            y: box.buttons-y + (root.buttons ? 88px + 24px : 0px);
            width: parent.width - 96px;
            height: 4px;
            border-radius: 2px;
            background: Theme.line;
            clip: true;
            property <float> t: mod(animation-tick() / 1ms, 1400) / 1400;
            Rectangle {
                x: (parent.width + self.width) * parent.t - self.width;
                width: parent.width * 0.3;
                height: parent.height;
                border-radius: 2px;
                background: Theme.accent;
            }
        }
        // The time left: a thin line that shrinks.
        if root.left >= 0: Rectangle {
            x: 48px;
            y: box.buttons-y + (root.buttons ? 88px + 24px : 0px);
            width: parent.width - 96px;
            height: 4px;
            border-radius: 2px;
            background: Theme.line;
            Rectangle {
                x: 0;
                width: parent.width * root.left;
                height: parent.height;
                border-radius: 2px;
                background: Theme.accent.with-alpha(0.8);
            }
        }
    }
}

// The volume HUD (volume keys, 2 s): next to the keys, on the desk side of the screen; at 270
// degrees the keys are on the top edge near the right corner, so it sits top right and grows
// towards Vol+. Never over the action band or the stage.
export component VolumeHud inherits Rectangle {
    in property <int> level: 40;
    width: 360px;
    height: 56px;
    border-radius: self.height / 2;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    Icon {
        x: 20px;
        y: 14px;
        width: 28px;
        height: 28px;
        source: root.level == 0 ? Icons.volume-off-28
            : root.level >= 67 ? Icons.volume-high-28
            : root.level >= 34 ? Icons.volume-medium-28 : Icons.volume-low-28;
        color: Theme.text;
    }
    property <length> track-x: 64px;
    property <length> track-width: self.width - self.track-x - 96px;
    Rectangle {
        x: root.track-x;
        y: 25px;
        width: root.track-width;
        height: 6px;
        border-radius: 3px;
        background: Theme.line;
    }
    Rectangle {
        x: root.track-x;
        y: 25px;
        width: max(self.height, root.track-width * clamp(root.level, 0, 100) / 100);
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }
    Text {
        x: parent.width - 20px - self.width;
        width: 68px;
        height: parent.height;
        text: root.level + "%";
        font-family: "Inter Tnum";
        font-size: 24px;
        color: Theme.text;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}


// The control center's tile (pulled down from the top of the desk): what is on is gold, a tap
// switches it or opens its page.
export component ControlTile inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> status;
    in property <bool> on;
    in property <bool> enabled: true;
    // A tile that only tells (Wi-Fi): no touch, not greyed.
    in property <bool> tappable: true;
    // Three rows instead of two: 100 px tall, the lines closer.
    in property <bool> compact: false;
    callback clicked();
    width: 208px;
    height: root.compact ? 100px : 120px;
    border-radius: Grid.tile-radius;
    background: touch.pressed ? Theme.surface-2 : root.on ? Theme.accent-deep : Theme.surface;
    border-width: 1px;
    border-color: root.on ? Theme.accent.with-alpha(0.35) : Theme.line;
    Icon {
        x: 20px;
        y: root.compact ? 14px : 18px;
        width: 32px;
        height: 32px;
        source: root.icon;
        color: !root.enabled ? Theme.text-3.with-alpha(0.5) : root.on ? Theme.accent : Theme.text-2;
    }
    Text {
        x: 20px;
        y: root.compact ? 48px : 58px;
        width: parent.width - 32px;
        text: root.label;
        font-size: 24px;
        font-weight: 500;
        color: root.enabled ? Theme.text : Theme.text-3;
        overflow: elide;
    }
    Text {
        x: 20px;
        y: root.compact ? 72px : 86px;
        width: parent.width - 32px;
        text: root.status;
        font-size: 20px;
        color: root.on ? Theme.accent : Theme.text-3;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled && root.tappable;
        clicked => {
            Feedback.tap();
            root.clicked();
        }
    }
}

// A level the finger drags (volume, brightness): the filled part warm, the icon and the value
// inside the bar, 72 px tall so it is easy to hit from the sofa.
export component LevelBar inherits Rectangle {
    in property <image> icon;
    in property <int> level;
    in property <string> value;
    in property <bool> dim: false;
    callback changed(int);
    height: 72px;
    border-radius: 36px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;
    Rectangle {
        x: 0;
        width: max(72px, parent.width * clamp(root.level, 0, 100) / 100);
        height: parent.height;
        border-radius: 36px;
        background: root.dim ? Theme.surface-2 : Theme.accent-deep;
    }
    Icon {
        x: 24px;
        y: 22px;
        width: 28px;
        height: 28px;
        source: root.icon;
        color: root.dim ? Theme.text-3 : Theme.accent;
    }
    Text {
        x: parent.width - 24px - self.width;
        width: 120px;
        height: parent.height;
        text: root.value;
        font-family: "Inter Tnum";
        font-size: 24px;
        color: root.dim ? Theme.text-3 : Theme.text;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    // Only a finger that pressed here moves it: not the pull that opened the control center
    // passing over it, nor a hover.
    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.changed(round(clamp(self.mouse-x / self.width, 0, 1) * 100));
            }
        }
        moved => {
            if self.pressed {
                root.changed(round(clamp(self.mouse-x / self.width, 0, 1) * 100));
            }
        }
    }
}

// --- The board (ui/board.rs, ui/board/draw.rs): tiles of Home Assistant's entities on a grid of
// cells, on the board's pages (6 x 4 cells of 195 x 157) and in the custom widget (4 x 2 of
// 193 x 130; one line of 193 x 88). Every value is data from Rust, icons included (MDI path
// data, drawn with a Path in a 24 x 24 box). Nothing moves at rest: a tile redraws when its data
// changes; after a tap its icon dims once (180 ms) while it waits for Home Assistant.

export struct BoardTileData {
    // Its index in its canvas's tiles (what a tap names).
    id: int,
    // Place and size, in cells.
    x: int,
    y: int,
    w: int,
    h: int,
    // "button", "sensor", "level".
    kind: string,
    // "off", "on", "pending", "unavailable", "failed", "stale" (Home Assistant not reachable:
    // the last state known, dimmed).
    state: string,
    // SVG path data in a 24 x 24 box.
    icon: string,
    name: string,
    value: string,
    status: string,
    range: string,
    // 0-100, -1 none.
    level: int,
    // The day's curve, path commands in the tile's curve box (draw.rs `curve_box`).
    curve: string,
    tappable: bool,
}

// An MDI glyph from its path data.
component TileGlyph inherits Path {
    in property <string> data;
    in property <color> color;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.data;
    fill: root.color;
    stroke-width: 0;
}

export component BoardTile inherits Rectangle {
    in property <BoardTileData> tile;
    // The widget's cells (130 px tall): a little tighter.
    in property <bool> small: false;
    // The widget's one line: icon, name and value side by side.
    in property <bool> line: false;
    callback tapped();
    // A level dragged: the value, and whether the finger lifted.
    callback level-changed(int, bool);
    // A swipe across the tile (+1 to the next page, -1 back).
    callback swiped(int);
    // A finger moving across the tile (the board's page follows it): how far from where it
    // went down; and when it lifts (or the touch is taken away), how far it went.
    callback slide(length);
    callback slide-end(length);
    property <bool> on: root.tile.state == "on";
    property <bool> pending: root.tile.state == "pending";
    property <bool> gone: root.tile.state == "unavailable";
    property <bool> failed: root.tile.state == "failed";
    property <bool> stale: root.tile.state == "stale";
    property <bool> level: root.tile.kind == "level";
    property <bool> sensor: root.tile.kind == "sensor";
    // The gold ground of a thing that is on (a level's bar shows it instead).
    property <bool> gold: root.on && !root.level;
    property <length> pad-x: root.small ? 18px : 20px;
    property <length> pad-y: root.small ? 14px : 18px;
    property <color> icon-color: root.gone ? #4a4740 : root.pending || root.gold ? Theme.accent : Theme.text-2;
    property <color> name-color: root.gone ? Theme.text-3 : Theme.text;
    property <color> status-color: root.gone ? Theme.night : root.failed ? Theme.danger
        : root.pending ? Theme.text-2 : root.gold ? Theme.accent : Theme.text-3;
    // After a tap the icon dims once and stays so until Home Assistant answers.
    property <float> icon-alpha: root.pending ? 0.55 : 1;
    animate icon-alpha { duration: 180ms; }
    // While a finger drags the bar: its value (-1: none).
    property <int> drag: -1;
    property <int> shown-level: root.drag >= 0 ? root.drag : root.tile.level;
    border-radius: root.line ? Grid.card-radius : Grid.tile-radius;
    // Home Assistant away: the whole tile dimmed (what it shows may be old).
    opacity: root.stale ? 0.45 : 1;
    background: touch.pressed && !touch.dragging && root.tile.tappable && !root.level ? Theme.surface-2
        : root.gold ? Theme.accent-deep : Theme.surface;
    border-width: 1px;
    border-color: root.failed ? Theme.danger : root.gold ? Theme.accent.with-alpha(0.35) : Theme.line;
    clip: true;

    // The whole tile: a tap does its action; a swipe across is the page's (or the widget's turn).
    touch := TouchArea {
        enabled: !root.level || root.line;
        // Across, 12 px or more: a drag of the page, no tap any more.
        property <bool> dragging: false;
        // In the screen's coordinates: the page moves under the finger.
        property <length> down-at: 0;
        property <length> moved-by: self.absolute-position.x + self.mouse-x - self.down-at;
        moved => {
            if (self.pressed && (self.dragging || abs(self.moved-by) > 12px)) {
                self.dragging = true;
                root.slide(self.moved-by);
            }
        }
        pointer-event(e) => {
            let slid = self.dragging;
            if (e.kind == PointerEventKind.down) {
                self.dragging = false;
                self.down-at = self.absolute-position.x + self.pressed-x;
            } else if (self.dragging && (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel)) {
                self.dragging = false;
                root.slide-end(e.kind == PointerEventKind.up ? self.moved-by : 0);
            }
            if (e.kind == PointerEventKind.up && self.has-hover) {
                if (slid && abs(self.moved-by) > 48px) {
                    root.swiped(self.moved-by < 0 ? 1 : -1);
                } else if (!slid && abs(self.mouse-y - self.pressed-y) < 48px && root.tile.tappable) {
                    Feedback.tap();
                    root.tapped();
                }
            }
        }
    }

    // ---- One line (the widget with one free slot).
    if root.line: Rectangle {
        TileGlyph {
            x: 18px;
            y: (parent.height - self.height) / 2;
            width: 32px;
            height: 32px;
            data: root.tile.icon;
            color: root.icon-color;
            opacity: root.icon-alpha;
        }
        VerticalLayout {
            x: 64px;
            width: parent.width - 64px - 14px;
            alignment: center;
            Text {
                text: root.tile.name;
                font-size: 20px;
                font-weight: 500;
                color: root.name-color;
                overflow: elide;
            }
            Text {
                text: root.tile.value != "" ? root.tile.value : root.tile.status;
                font-family: root.tile.value != "" ? "Inter Tnum" : "";
                font-size: 18px;
                color: root.status-color;
                overflow: elide;
            }
        }
    }

    // ---- A button: the icon at the top, the name and the state at the bottom; 2 x 2 centred.
    if !root.line && root.tile.kind == "button" && root.tile.h < 2: Rectangle {
        TileGlyph {
            x: root.pad-x;
            y: root.pad-y;
            width: root.small ? 36px : 40px;
            height: self.width;
            data: root.tile.icon;
            color: root.icon-color;
            opacity: root.icon-alpha;
        }
        VerticalLayout {
            x: root.pad-x;
            y: parent.height - root.pad-y - self.height;
            width: parent.width - 2 * root.pad-x;
            height: self.preferred-height;
            Text {
                text: root.tile.name;
                font-size: root.small ? 22px : 24px;
                font-weight: 500;
                color: root.name-color;
                overflow: elide;
            }
            if root.tile.status != "": Text {
                text: root.tile.status;
                font-size: root.small ? 18px : 20px;
                color: root.status-color;
                overflow: elide;
            }
        }
    }
    if !root.line && root.tile.kind == "button" && root.tile.h >= 2: VerticalLayout {
        x: root.pad-x;
        width: parent.width - 2 * root.pad-x;
        alignment: center;
        spacing: 4px;
        Rectangle {
            height: 96px + 12px;
            TileGlyph {
                x: (parent.width - self.width) / 2;
                y: 0;
                width: 96px;
                height: 96px;
                data: root.tile.icon;
                color: root.icon-color;
                opacity: root.icon-alpha;
            }
        }
        Text {
            text: root.tile.name;
            font-size: 24px;
            font-weight: 500;
            color: root.name-color;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.tile.status != "": Text {
            text: root.tile.status;
            font-size: 20px;
            color: root.status-color;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    // ---- A sensor 1 x 1: the icon, the value, the name under it.
    if !root.line && root.sensor && root.tile.w == 1: Rectangle {
        TileGlyph {
            x: root.pad-x;
            y: root.pad-y;
            width: 28px;
            height: 28px;
            data: root.tile.icon;
            color: root.gone ? #4a4740 : Theme.text-2;
        }
        VerticalLayout {
            x: root.pad-x;
            y: parent.height - root.pad-y - self.height;
            width: parent.width - 2 * root.pad-x;
            height: self.preferred-height;
            spacing: 2px;
            Text {
                text: root.tile.value;
                font-family: "Inter Tnum";
                font-size: root.small ? 34px : 40px;
                color: root.name-color;
                overflow: elide;
            }
            Text {
                text: root.tile.name;
                font-size: root.small ? 18px : 20px;
                color: Theme.text-3;
                overflow: elide;
            }
        }
    }
    // ---- A wide sensor: the icon and the name in a header, the value, the day's curve.
    if !root.line && root.sensor && root.tile.w > 1: wide := Rectangle {
        property <bool> tall: root.tile.h >= 2;
        TileGlyph {
            x: root.pad-x;
            y: root.pad-y;
            width: 28px;
            height: 28px;
            data: root.tile.icon;
            color: root.gone ? #4a4740 : Theme.text-2;
        }
        Text {
            x: root.pad-x + 28px + 10px;
            y: root.pad-y;
            width: parent.width - self.x - root.pad-x;
            height: 28px;
            text: root.tile.name;
            font-size: root.small ? 20px : 22px;
            color: root.gone ? Theme.text-3 : Theme.text-2;
            vertical-alignment: center;
            overflow: elide;
        }
        if !wide.tall: Text {
            x: root.pad-x;
            y: parent.height - root.pad-y - self.height;
            width: root.tile.curve != "" ? parent.width - 2 * root.pad-x - (root.tile.w > 2 ? 440px : 150px) - 12px
                : parent.width - 2 * root.pad-x;
            height: root.small ? 44px : 52px;
            text: root.tile.value;
            font-family: "Inter Tnum";
            font-size: root.small ? 40px : 48px;
            color: root.name-color;
            vertical-alignment: bottom;
            overflow: elide;
        }
        if !wide.tall && root.tile.curve != "": Path {
            x: parent.width - 20px - self.width;
            y: parent.height - 22px - self.height;
            width: root.tile.w > 2 ? 440px : 150px;
            height: 44px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: self.width / 1px;
            viewbox-height: 44;
            commands: root.tile.curve;
            stroke: Theme.text-2;
            stroke-width: 2px;
        }
        if wide.tall: Text {
            x: root.pad-x;
            y: root.pad-y + 28px + 18px;
            width: parent.width - 2 * root.pad-x;
            height: 100px;
            text: root.tile.value;
            font-family: "Inter Tnum";
            font-size: 96px;
            font-weight: 300;
            letter-spacing: -2px;
            color: root.name-color;
            vertical-alignment: center;
            overflow: elide;
        }
        if wide.tall && root.tile.curve != "": Path {
            x: 20px;
            y: parent.height - root.pad-y - 26px - 10px - self.height;
            width: parent.width - 40px;
            height: 84px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: self.width / 1px;
            viewbox-height: 84;
            commands: root.tile.curve;
            stroke: Theme.accent;
            stroke-width: 2px;
        }
        if wide.tall: Text {
            x: root.pad-x;
            y: parent.height - root.pad-y - 26px;
            width: parent.width - 2 * root.pad-x;
            height: 26px;
            text: root.tile.range;
            font-family: "Inter Tnum";
            font-size: 20px;
            color: Theme.text-3;
            overflow: elide;
        }
    }

    // ---- A level: the name and its state over a bar the finger drags (a tap on its icon
    // switches it on and off).
    if !root.line && root.level: Rectangle {
        property <length> bar-h: root.small ? 56px : 72px;
        HorizontalLayout {
            x: root.pad-x;
            y: root.pad-y;
            width: parent.width - 2 * root.pad-x;
            height: 30px;
            spacing: 12px;
            Text {
                text: root.tile.name;
                font-size: root.small ? 22px : 24px;
                font-weight: 500;
                color: root.name-color;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.tile.status != "": Text {
                text: root.tile.status;
                font-size: root.small ? 18px : 20px;
                color: root.failed ? Theme.danger : Theme.text-3;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }
        bar := Rectangle {
            x: root.pad-x;
            y: parent.height - root.pad-y - self.height;
            width: parent.width - 2 * root.pad-x;
            height: parent.bar-h;
            border-radius: self.height / 2;
            background: Theme.surface-2;
            clip: true;
            if root.shown-level > 0: Rectangle {
                x: 0;
                width: max(bar.height, bar.width * clamp(root.shown-level, 0, 100) / 100);
                height: bar.height;
                border-radius: bar.height / 2;
                background: root.gone ? Theme.surface : Theme.accent-deep;
            }
            TileGlyph {
                x: 22px;
                y: (bar.height - self.height) / 2;
                width: 32px;
                height: 32px;
                data: root.tile.icon;
                color: root.gone ? #4a4740 : Theme.accent;
                opacity: root.icon-alpha;
            }
            Text {
                x: bar.width - 22px - self.width;
                width: 120px;
                height: bar.height;
                text: root.drag >= 0 ? root.drag + "%" : root.tile.value;
                font-family: "Inter Tnum";
                font-size: 24px;
                color: root.gone ? Theme.text-3 : Theme.text;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            // The icon's end of the bar: a tap there switches it; anywhere else a drag sets it.
            // Released, the bar shows Rust's level: the one let go until Home Assistant has it
            // (board::Pending), so it does not jump back meanwhile. A touch taken away (cancel)
            // ends the drag where it was sent last.
            bar-touch := TouchArea {
                enabled: root.tile.tappable;
                property <int> at: round(clamp(self.mouse-x / self.width, 0, 1) * 100);
                property <bool> dragging: false;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.dragging = false;
                    } else if (e.kind == PointerEventKind.up) {
                        if (self.dragging) {
                            root.level-changed(self.at, true);
                            root.drag = -1;
                        } else if (self.pressed-x < 76px) {
                            Feedback.tap();
                            root.tapped();
                        } else {
                            root.drag = -1;
                            root.level-changed(self.at, true);
                        }
                        self.dragging = false;
                    } else if (e.kind == PointerEventKind.cancel) {
                        self.dragging = false;
                        root.drag = -1;
                    }
                }
                moved => {
                    if (self.pressed && (self.dragging || abs(self.mouse-x - self.pressed-x) > 8px)) {
                        self.dragging = true;
                        root.drag = self.at;
                        root.level-changed(self.at, false);
                    }
                }
            }
        }
    }
}

// Tiles on a grid of `columns` x `rows` cells: each where its x, y, w, h say. A swipe across
// the grid (on a gap, an empty cell or a tile) says +1 or -1; a tile's tap and level say its
// `id`.
export component BoardGrid inherits Rectangle {
    in property <[BoardTileData]> tiles;
    in property <int> columns: 4;
    in property <int> rows: 4;
    in property <length> cell-width: 193px;
    in property <length> cell-height: 157px;
    in property <length> gap: 12px;
    // The widget's one line.
    in property <bool> line: false;
    // Empty cells drawn as dashed places with a plus (a board with nothing on it yet).
    in property <bool> empty-cells: false;
    callback tapped(int);
    callback level-changed(int, int, bool);
    callback swiped(int);
    // A finger moving across the grid or a tile, and its lift (BoardTile's slide, slide-end).
    callback slide(length);
    callback slide-end(length);
    width: root.columns * root.cell-width + (root.columns - 1) * root.gap;
    height: root.rows * root.cell-height + (root.rows - 1) * root.gap;
    TouchArea {
        property <bool> dragging: false;
        // In the screen's coordinates: the page moves under the finger.
        property <length> down-at: 0;
        property <length> moved-by: self.absolute-position.x + self.mouse-x - self.down-at;
        moved => {
            if (self.pressed && (self.dragging || abs(self.moved-by) > 12px)) {
                self.dragging = true;
                root.slide(self.moved-by);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.dragging = false;
                self.down-at = self.absolute-position.x + self.pressed-x;
            } else if (self.dragging && (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel)) {
                self.dragging = false;
                root.slide-end(e.kind == PointerEventKind.up ? self.moved-by : 0);
            }
            if (e.kind == PointerEventKind.up && abs(self.moved-by) > 48px) {
                root.swiped(self.moved-by < 0 ? 1 : -1);
            }
        }
    }
    if root.empty-cells: Rectangle {
        for n in root.columns * root.rows: Rectangle {
            x: mod(n, root.columns) * (root.cell-width + root.gap);
            y: floor(n / root.columns) * (root.cell-height + root.gap);
            width: root.cell-width;
            height: root.cell-height;
            border-radius: Grid.tile-radius;
            border-width: 2px;
            border-color: #24262d;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 36px;
                height: 36px;
                source: Icons.plus-36;
                color: #33353d;
            }
        }
    }
    for t[i] in root.tiles: BoardTile {
        x: t.x * (root.cell-width + root.gap);
        y: t.y * (root.cell-height + root.gap);
        width: t.w * root.cell-width + (t.w - 1) * root.gap;
        height: t.h * root.cell-height + (t.h - 1) * root.gap;
        tile: t;
        small: root.cell-height < 150px;
        line: root.line;
        tapped => {
            root.tapped(t.id);
        }
        level-changed(v, done) => {
            root.level-changed(t.id, v, done);
        }
        swiped(d) => {
            root.swiped(d);
        }
        slide(dx) => {
            root.slide(dx);
        }
        slide-end(dx) => {
            root.slide-end(dx);
        }
    }
}

// --- The home's widget (ui/widgets.rs): one panel under the cards that takes the slots they
// leave free and turns through what is around the house. Rows are data, filled by Rust; the
// panel only draws them. `slots`: 1 = one row as tall as a card, no header; 2 = a header and
// 2 rows; 3 = 4 rows; 4 (compact home) = 6 rows. `columns`: the rows are columns side by side
// (the weather: `left` the hour, `note` the condition, `text` the temperature). The dots of the
// turn sit in the band's last 16 px. A new page fades in once (180 ms, from `seq`); nothing
// else moves.

export struct WidgetRow {
    left: string,
    text: string,
    right: string,
    // A weather condition: its icon before the value (other cities).
    note: string,
    // After the value: "▲ 1.2%"; `trend` -1/0/+1 colours it on the markets' page only.
    change: string,
    trend: int,
    // The last hours as SVG path commands in a 160 x 32 box ("" no curve), drawn by Rust.
    curve: string,
}

// A weather condition's icon (Home Assistant's names), 32 px.
export component WeatherGlyph inherits Icon {
    in property <string> kind;
    width: 32px;
    height: 32px;
    source: root.kind == "sunny" ? Icons.weather-sunny-32
        : root.kind == "clear-night" ? Icons.weather-night-32
        : root.kind == "partlycloudy" ? Icons.weather-partly-cloudy-32
        : root.kind == "cloudy" ? Icons.weather-cloudy-32
        : root.kind == "rainy" ? Icons.weather-rainy-32
        : root.kind == "pouring" ? Icons.weather-pouring-32
        : root.kind == "snowy" ? Icons.weather-snowy-32
        : root.kind == "snowy-rainy" ? Icons.weather-snowy-rainy-32
        : root.kind == "fog" ? Icons.weather-fog-32
        : root.kind == "hail" ? Icons.weather-hail-32
        : root.kind == "lightning" ? Icons.weather-lightning-32
        : root.kind == "lightning-rainy" ? Icons.weather-lightning-rainy-32
        : root.kind == "windy" ? Icons.weather-windy-32
        : root.kind == "windy-variant" ? Icons.weather-windy-variant-32
        : Icons.weather-cloudy-32;
}

// The weather's big block (ui/weather.rs WeatherHero): now, or tomorrow in the evening.
export struct WeatherHero {
    shown: bool,
    // What the weather does next in words: "Nuvoloso, pioggia dalle 17:00" / "Domani pioggia".
    label: string,
    // Home Assistant's condition (the big icon).
    kind: string,
    // The temperature now or tomorrow's high ("14°"; not drawn: the date's line above has the
    // temperature now).
    temp: string,
    // Under the sentence, small: "Oggi tra 8° e 15°" ("" unknown).
    range: string,
}

// A weather condition's icon drawn big: 112 px, or 144 with `large` (the compact home).
export component WeatherBig inherits Icon {
    in property <string> kind;
    in property <bool> large: false;
    width: self.large ? 144px : 112px;
    height: self.width;
    source: root.large ? (
        root.kind == "sunny" ? Icons.weather-sunny-144
        : root.kind == "clear-night" ? Icons.weather-night-144
        : root.kind == "partlycloudy" ? Icons.weather-partly-cloudy-144
        : root.kind == "rainy" ? Icons.weather-rainy-144
        : root.kind == "pouring" ? Icons.weather-pouring-144
        : root.kind == "snowy" ? Icons.weather-snowy-144
        : root.kind == "snowy-rainy" ? Icons.weather-snowy-rainy-144
        : root.kind == "fog" ? Icons.weather-fog-144
        : root.kind == "hail" ? Icons.weather-hail-144
        : root.kind == "lightning" ? Icons.weather-lightning-144
        : root.kind == "lightning-rainy" ? Icons.weather-lightning-rainy-144
        : root.kind == "windy" ? Icons.weather-windy-144
        : root.kind == "windy-variant" ? Icons.weather-windy-variant-144
        : Icons.weather-cloudy-144) : (
        root.kind == "sunny" ? Icons.weather-sunny-112
        : root.kind == "clear-night" ? Icons.weather-night-112
        : root.kind == "partlycloudy" ? Icons.weather-partly-cloudy-112
        : root.kind == "rainy" ? Icons.weather-rainy-112
        : root.kind == "pouring" ? Icons.weather-pouring-112
        : root.kind == "snowy" ? Icons.weather-snowy-112
        : root.kind == "snowy-rainy" ? Icons.weather-snowy-rainy-112
        : root.kind == "fog" ? Icons.weather-fog-112
        : root.kind == "hail" ? Icons.weather-hail-112
        : root.kind == "lightning" ? Icons.weather-lightning-112
        : root.kind == "lightning-rainy" ? Icons.weather-lightning-rainy-112
        : root.kind == "windy" ? Icons.weather-windy-112
        : root.kind == "windy-variant" ? Icons.weather-windy-variant-112
        : Icons.weather-cloudy-112);
}

export component WidgetPanel inherits Rectangle {
    // "next", "quotes", "weather", "cities", "shopping", "notes", "sensors", "check", "playing",
    // "home", "custom" (the board's tiles).
    in property <string> kind;
    // A tap opens a page of its own (now playing and who is home have none: no press either).
    in property <bool> tappable: true;
    in property <string> title;
    in property <string> aside;
    in property <[WidgetRow]> rows;
    in property <bool> columns: false;
    in property <int> slots: 3;
    in property <int> index: 0;
    in property <int> count: 1;
    in property <int> seq: 0;
    // The weather's big block (with `columns`: the next hours under it, small).
    in property <WeatherHero> hero;
    // "custom": the board's tiles in the slot itself, no panel around them (4 x 2 cells of
    // 193 x 130; one line: row 0, 88 px tall). A tile's tap and level go out with its id.
    in property <[BoardTileData]> tiles;
    callback tile-tapped(int);
    callback tile-level(int, int, bool);
    callback tapped();
    // +1 the next page (a swipe to the left), -1 the previous one.
    callback swiped(int);
    width: Grid.col-width;
    property <bool> custom: root.kind == "custom";
    property <bool> big: root.hero.shown && !root.line;
    property <bool> line: root.slots <= 1;
    property <bool> dots: root.count > 1 && !root.line;
    // The fade: `fade` follows `seq` in 180 ms; between two whole numbers the content is
    // partly drawn (0 at the start of the change, 1 at its end and at rest).
    property <float> fade: root.seq;
    animate fade { duration: 180ms; }
    property <float> alpha: 1 - (ceil(root.fade) - root.fade);
    property <image> icon: root.kind == "weather" ? Icons.weather-partly-cloudy-28
        : root.kind == "shopping" ? Icons.cart-28
        : root.kind == "quotes" ? Icons.chart-line-28
        : root.kind == "cities" ? Icons.earth-28
        : root.kind == "notes" ? Icons.note-text-28
        : root.kind == "sensors" ? Icons.gauge-28
        : root.kind == "check" ? Icons.door-open-28
        : root.kind == "playing" ? Icons.music-note-28
        : root.kind == "home" ? Icons.account-group-28
        : Icons.calendar-clock-28;
    // The change's colour: up and down mean something on the markets only.
    function change-color(trend: int) -> color {
        if (root.kind != "quotes" || trend == 0) {
            return Theme.text-2;
        }
        return trend > 0 ? Theme.ok : Theme.danger;
    }
    panel := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.dots ? parent.height - 16px : parent.height;
        border-radius: Grid.card-radius;
        background: root.custom ? transparent : touch.pressed && root.tappable ? Theme.surface-2 : Theme.surface;
        border-width: root.custom ? 0 : 1px;
        border-color: Theme.line;
        if !root.custom: Rectangle {
            opacity: root.alpha;
            // One row, as a card: the page's icon, then the row.
            if root.line && !root.columns: Rectangle {
                Icon {
                    x: 28px;
                    y: 30px;
                    width: 28px;
                    height: 28px;
                    source: root.icon;
                    color: Theme.accent;
                }
                HorizontalLayout {
                    x: 92px;
                    y: 0;
                    width: parent.width - 92px - 28px;
                    height: parent.height;
                    spacing: 20px;
                    if root.rows[0].left != "": Text {
                        text: root.rows[0].left;
                        font-family: "Inter Tnum";
                        font-size: 28px;
                        color: Theme.accent;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: root.rows[0].text;
                        font-size: 28px;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.rows[0].note != "": Rectangle {
                        width: 32px;
                        horizontal-stretch: 0;
                        WeatherGlyph {
                            y: (parent.height - 32px) / 2;
                            kind: root.rows[0].note;
                        }
                    }
                    if root.rows[0].right != "": Text {
                        text: root.rows[0].right;
                        font-family: root.rows[0].change != "" ? "Inter Tnum" : "";
                        font-size: root.rows[0].change != "" ? 28px : 24px;
                        color: root.rows[0].change != "" ? Theme.text : Theme.text-2;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    if root.rows[0].change != "": Text {
                        text: root.rows[0].change;
                        font-family: "Inter Tnum";
                        font-size: 24px;
                        color: root.change-color(root.rows[0].trend);
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                }
            }
            if root.line && root.columns && !root.hero.shown: Rectangle {
                Icon {
                    x: 28px;
                    y: 30px;
                    width: 28px;
                    height: 28px;
                    source: root.icon;
                    color: Theme.accent;
                }
                for c[i] in root.rows: Rectangle {
                    x: 84px + i * (parent.width - 84px - 12px) / root.rows.length;
                    width: (parent.width - 84px - 12px) / root.rows.length;
                    HorizontalLayout {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: c.left;
                            font-family: "Inter Tnum";
                            font-size: 20px;
                            color: Theme.text-2;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 32px;
                            WeatherGlyph {
                                y: (parent.height - 32px) / 2;
                                kind: c.note;
                            }
                        }
                        Text {
                            text: c.text;
                            font-size: 24px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            // The weather in one row: the sky and what it does next (the date's line above has
            // the temperature now).
            if root.line && root.hero.shown: HorizontalLayout {
                x: 28px;
                width: parent.width - 56px;
                spacing: 20px;
                Rectangle {
                    width: 32px;
                    horizontal-stretch: 0;
                    WeatherGlyph {
                        y: (parent.height - 32px) / 2;
                        kind: root.hero.kind;
                        color: Theme.accent;
                    }
                }
                Text {
                    text: root.hero.label;
                    font-size: Type.body;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            // The weather's big block: the sky on the left, a dotted line, what the weather does
            // next in words with the range small under it; the next hours small at the bottom
            // when there is room (three slots and more).
            if root.big: hero-box := Rectangle {
                property <bool> large: root.slots >= 4;
                // Two slots: the block alone, packed tighter.
                property <bool> tight: root.slots == 2;
                property <bool> hours: root.slots >= 3 && root.columns && root.rows.length > 0;
                // The block's height (the sentence and the range centred in it).
                property <length> top: self.tight ? 6px : 16px;
                property <length> temp-line: self.large ? 176px : self.tight ? 94px : 108px;
                property <length> block: self.top + 28px + self.temp-line + 36px;
                property <length> left-w: self.large ? 224px : 184px;
                WeatherBig {
                    x: (hero-box.left-w - self.width) / 2 + 8px;
                    y: (hero-box.block - self.height) / 2 + 4px;
                    kind: root.hero.kind;
                    large: hero-box.large;
                    color: Theme.accent;
                }
                // The dotted divider.
                for i in floor((hero-box.block - hero-box.top - 16px) / 8px): Rectangle {
                    x: hero-box.left-w + 8px;
                    y: hero-box.top + 4px + i * 8px;
                    width: 2px;
                    height: 2px;
                    border-radius: 1px;
                    background: Theme.text-3;
                    opacity: 0.6;
                }
                // What the weather does next, in words, and the day's range small under it: no big
                // number (the date's line above has the temperature now).
                VerticalLayout {
                    x: hero-box.left-w + 40px;
                    y: hero-box.top;
                    width: parent.width - self.x - 32px;
                    height: hero-box.block - hero-box.top - 8px;
                    alignment: center;
                    spacing: hero-box.tight ? 6px : 12px;
                    Text {
                        text: root.hero.label;
                        font-size: hero-box.large ? Type.title : Type.headline;
                        color: Theme.text;
                        wrap: word-wrap;
                        overflow: elide;
                        max-height: hero-box.large ? 2 * 60px : 2 * 50px;
                    }
                    if root.hero.range != "": Text {
                        text: root.hero.range;
                        font-family: "Inter Tnum";
                        font-size: hero-box.large ? Type.body : Type.reading;
                        color: Theme.text-2;
                    }
                }
                // The next hours, one small line: the hour, the sky, the temperature.
                if hero-box.hours: Rectangle {
                    x: 24px;
                    y: hero-box.block + max(8px, (parent.height - hero-box.block - 48px - 12px) / 2);
                    width: parent.width - 48px;
                    height: 48px;
                    Rectangle {
                        y: -8px;
                        height: 1px;
                        background: Theme.line;
                    }
                    for c[i] in root.rows: HorizontalLayout {
                        x: i * parent.width / root.rows.length;
                        width: parent.width / root.rows.length;
                        height: parent.height;
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: c.left;
                            font-family: "Inter Tnum";
                            font-size: Type.caption;
                            color: Theme.text-3;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 32px;
                            WeatherGlyph {
                                y: (parent.height - 32px) / 2;
                                kind: c.note;
                            }
                        }
                        Text {
                            text: c.text;
                            font-family: "Inter Tnum";
                            font-size: Type.reading;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            // A header and rows.
            if !root.line && !root.big: Rectangle {
                Icon {
                    x: 24px;
                    y: 24px;
                    width: 28px;
                    height: 28px;
                    source: root.icon;
                    color: Theme.accent;
                }
                Text {
                    x: 64px;
                    y: 16px;
                    width: parent.width - 64px - 24px;
                    height: 44px;
                    text: root.title;
                    font-size: 20px;
                    font-weight: 500;
                    letter-spacing: 1px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.aside != "": Text {
                    x: parent.width - 24px - self.width;
                    y: 16px;
                    height: 44px;
                    text: root.aside;
                    font-size: 20px;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
                if !root.columns: rows-box := Rectangle {
                    // Rows from y 60, 52 px each; the left column 148 px wide ("tomorrow") only if a row has one.
                    property <bool> lefts: root.rows.length > 0 && (root.rows[0].left != ""
                        || (root.rows.length > 1 && root.rows[1].left != ""));
                    for r[i] in root.rows: Rectangle {
                        x: 24px;
                        y: 60px + i * 52px;
                        width: parent.width - 48px;
                        height: 52px;
                        if r.left != "": Text {
                            x: 0;
                            width: 148px;
                            height: parent.height;
                            text: r.left;
                            font-family: "Inter Tnum";
                            font-size: 28px;
                            color: Theme.accent;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // From the right: the change, the value, the sky, the curve; the
                        // text takes what is left.
                        change-text := Text {
                            x: parent.width - self.width;
                            width: r.change != "" ? max(self.preferred-width, 112px) : 0px;
                            height: parent.height;
                            text: r.change;
                            font-family: "Inter Tnum";
                            font-size: 24px;
                            color: root.change-color(r.trend);
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        // With a curve the values form a column (176 px, right-aligned), so the
                        // curves stand one under the other.
                        right-text := Text {
                            x: change-text.x - (r.change != "" ? 16px : 0px) - self.width;
                            width: r.curve != "" ? max(self.preferred-width, 176px) : self.preferred-width;
                            horizontal-alignment: right;
                            height: parent.height;
                            text: r.right;
                            font-family: "Inter Tnum";
                            font-size: 28px;
                            color: r.change != "" ? Theme.text : Theme.text-2;
                            vertical-alignment: center;
                        }
                        if r.note != "": WeatherGlyph {
                            x: right-text.x - 16px - 32px;
                            y: (parent.height - 32px) / 2;
                            kind: r.note;
                        }
                        if r.curve != "": Path {
                            x: right-text.x - 24px - 160px;
                            y: (parent.height - 32px) / 2;
                            width: 160px;
                            height: 32px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 160;
                            viewbox-height: 32;
                            commands: r.curve;
                            stroke: Theme.text-2;
                            stroke-width: 2px;
                        }
                        Text {
                            x: rows-box.lefts ? 164px : 0px;
                            width: right-text.x - self.x - (r.curve != "" ? 24px + 160px + 24px
                                : r.note != "" ? 16px + 32px + 16px : r.right != "" ? 24px : 0px);
                            height: parent.height;
                            text: r.text;
                            font-size: 28px;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                if root.columns: cols-box := Rectangle {
                    // Columns under the header, 24 px off the bottom: the hour, the sky, the
                    // temperature.
                    property <length> top: 60px + max(0px, parent.height - 60px - 112px - 24px);
                    for c[i] in root.rows: Rectangle {
                        x: 24px + i * (parent.width - 48px) / root.rows.length;
                        y: cols-box.top;
                        width: (parent.width - 48px) / root.rows.length;
                        height: 112px;
                        Text {
                            x: 0;
                            y: 0px;
                            width: parent.width;
                            height: 28px;
                            text: c.left;
                            font-family: "Inter Tnum";
                            font-size: 24px;
                            color: Theme.text-2;
                            horizontal-alignment: center;
                        }
                        WeatherGlyph {
                            x: (parent.width - 32px) / 2;
                            y: 36px;
                            kind: c.note;
                        }
                        Text {
                            x: 0;
                            y: 76px;
                            width: parent.width;
                            height: 36px;
                            text: c.text;
                            font-size: 28px;
                            color: Theme.text;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
        // A tap opens the page's own page; a swipe across (more than 48 px) turns it.
        touch := TouchArea {
            clicked => {
                if (abs(self.mouse-x - self.pressed-x) > 48px) {
                    root.swiped(self.mouse-x < self.pressed-x ? 1 : -1);
                } else if (root.tappable) {
                    Feedback.tap();
                    root.tapped();
                }
            }
        }
        if root.custom: BoardGrid {
            opacity: root.alpha;
            tiles: root.tiles;
            columns: 4;
            rows: root.line ? 1 : 2;
            cell-height: root.line ? 88px : 130px;
            line: root.line;
            tapped(id) => {
                root.tile-tapped(id);
            }
            level-changed(id, v, done) => {
                root.tile-level(id, v, done);
            }
            swiped(d) => {
                root.swiped(d);
            }
        }
    }
    if root.dots: Rectangle {
        x: 0;
        y: parent.height - 16px;
        width: parent.width;
        height: 16px;
        opacity: root.alpha;
        for i in root.count: Rectangle {
            x: (parent.width - root.count * 16px + 10px) / 2 + i * 16px;
            y: 5px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: i == root.index ? Theme.accent : Theme.line;
        }
    }
}
