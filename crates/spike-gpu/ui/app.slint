// GPU spike: one portrait screen of the ThinkSmart View (800x1280) with the
// character animation and a large clock. Compiled twice by build.rs: once with
// the font embedded as a file (femtovg rasterises it on the GPU path) and once
// pre-rendered for the software renderer (one static font size: 160 px).
// Every dynamic value is driven from Rust.

import "../fixtures/fonts/DejaVuSans-subset.ttf";

export component AppWindow inherits Window {
    width: 800px;
    height: 1280px;
    title: "spike-gpu";
    default-font-family: "DejaVu Sans";
    // The animation frames' own background (#03050D), so the box blends in.
    background: #03050d;

    in property <string> clock: "00:00:00";
    in property <image> character;
    // The character's box, in pixels (set from Rust: --char-scale).
    in property <length> char-x: 180px;
    in property <length> char-y: 40px;
    in property <length> char-w: 440px;
    in property <length> char-h: 760px;
    // soft-blit draws the character itself, straight into the framebuffer.
    in property <bool> show-character: true;
    in property <length> clock-y: 1050px;

    if root.show-character: Image {
        x: root.char-x;
        y: root.char-y;
        width: root.char-w;
        height: root.char-h;
        source: root.character;
        image-fit: fill;
    }

    Text {
        x: 0px;
        y: root.clock-y;
        width: 800px;
        height: 200px;
        text: root.clock;
        font-size: 160px;
        color: #f2f2f2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
