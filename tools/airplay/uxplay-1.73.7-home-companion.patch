+static std::string hc_clean(const char *text, size_t len) {
+    std::string out(text, len);
+    for (char &c : out) {
+        if (c == '\n' || c == '\r') c = ' ';
+    }
+    return out;
+}
+
+static void hc_event(const char *fmt, ...) {
