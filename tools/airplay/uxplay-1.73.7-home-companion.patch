index ddcd14e..30c0864 100644
--- a/renderers/audio_renderer.c
+++ b/renderers/audio_renderer.c
@@ -381,6 +381,15 @@ void audio_renderer_set_volume(double volume) {
 }
 
 void audio_renderer_flush() {
+    /* With timestamps (-async, or mirroring with -vsync) the pipeline holds audio waiting for its
+     * time, about 2 s ahead in ALAC mode: a pause must not play it out. Flush events sent to appsrc
+     * go downstream (queue and sink drop what they hold); appsrc also drops its own queue. The
+     * running time is kept: the timestamps stay valid. */
+    if (!renderer || !sync) {
+        return;
+    }
+    gst_element_send_event(renderer->appsrc, gst_event_new_flush_start());
+    gst_element_send_event(renderer->appsrc, gst_event_new_flush_stop(FALSE));
 }
 
 void audio_renderer_destroy() {
