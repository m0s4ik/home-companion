+    /* iOS pauses by just no longer sending (no FLUSH, no TEARDOWN most of the time), while about
+     * 1.75 s of audio waits in the pipeline for its time: a gap in the data is a pause, flush. */
+    const uint64_t pause_gap = 350000000;   /* ns; packets come every 8 ms */
+    uint64_t last_data = 0;
