+        if (last_data && raop_ntp_get_local_time() - last_data > pause_gap) {
+            last_data = 0;
+            logger_log(raop_rtp->logger, LOGGER_DEBUG, "raop_rtp: no audio data for %u ms, flush", (unsigned) (pause_gap / 1000000));
+            if (raop_rtp->callbacks.audio_flush) {
+                raop_rtp->callbacks.audio_flush(raop_rtp->callbacks.cls);
+            }
+        }
 
         /* Set timeout value to 5ms */
         tv.tv_sec = 0;
