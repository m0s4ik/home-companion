+/* unixfdsink (frames to another process as dma-bufs): the decoder must be told that the
+ * receiver reads GstVideoMeta (plane offsets and strides), or a decoder with padded planes
+ * (venus: height aligned to 32) copies every frame into the sink's shared memory instead. */
+static GstPadProbeReturn unixfdsink_allocation_probe(GstPad *pad, GstPadProbeInfo *info, gpointer data) {
+    GstQuery *query = GST_PAD_PROBE_INFO_QUERY(info);
+    if (GST_QUERY_TYPE(query) == GST_QUERY_ALLOCATION) {
+        gst_query_add_allocation_meta(query, GST_VIDEO_META_API_TYPE, NULL);
+    }
+    return GST_PAD_PROBE_OK;
+}
